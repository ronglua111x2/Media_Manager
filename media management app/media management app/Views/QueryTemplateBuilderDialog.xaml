<Window x:Class="media_management_app.Views.QueryTemplateBuilderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:views="clr-namespace:media_management_app.Views"
        xmlns:converters="clr-namespace:media_management_app.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Query templates"
        Width="920"
        MinWidth="760"
        Height="640"
        MinHeight="480"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBrushCanvas}"
        Foreground="{StaticResource AppBrushText}"
        TextElement.Foreground="{StaticResource AppBrushText}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ChromeIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource AppIconStyle}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="TitleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource AppButtonControlTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushDanger}" />
                    <Setter Property="Foreground" Value="{StaticResource AppBrushOnAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BuilderLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <converters:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrushConverter" />
        <Style x:Key="BuilderTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="CaretBrush" Value="{StaticResource AppBrushText}" />
        </Style>
        <Style x:Key="BuilderTemplateTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BuilderTextBoxStyle}">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="TokenChipButtonStyle" TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Foreground" Value="{Binding DisplayBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />
            <Setter Property="BorderBrush" Value="{Binding DisplayBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpansion}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushDanger}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsExpansion}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource AppBrushDangerPressed}" />
                    <Setter Property="BorderBrush" Value="{Binding DisplayBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PreviewLineStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPairStart}" Value="True">
                    <Setter Property="Margin" Value="0,12,0,4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BuilderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource AppBrushCanvas}"
            BorderBrush="{StaticResource AppBrushBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{StaticResource AppBrushSurface}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Query templates"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                    <Button Grid.Column="1"
                            Style="{StaticResource CloseTitleButtonStyle}"
                            Focusable="False"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <iconPacks:PackIconLucide Kind="X" Style="{StaticResource ChromeIconStyle}" />
                    </Button>
                </Grid>
            </Border>
            <DockPanel Grid.Row="1" Margin="16">
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding EstimateText}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource AppBrushMutedText}"
                   Margin="0,10,0,0" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding CountLabel, StringFormat=Templates ({0})}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0" />
                    <WrapPanel VerticalAlignment="Center">
                        <Button Style="{StaticResource BuilderIconButtonStyle}"
                                ToolTip="Add"
                                Command="{Binding AddItemCommand}">
                            <iconPacks:PackIconLucide Kind="Plus" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource BuilderIconButtonStyle}"
                                ToolTip="Duplicate"
                                Command="{Binding DuplicateItemCommand}">
                            <iconPacks:PackIconLucide Kind="Copy" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource BuilderIconButtonStyle}"
                                ToolTip="Delete"
                                Command="{Binding DeleteItemCommand}">
                            <iconPacks:PackIconLucide Kind="Trash2" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource BuilderIconButtonStyle}"
                                ToolTip="Reset"
                                Command="{Binding ResetItemCommand}">
                            <iconPacks:PackIconLucide Kind="RotateCcw" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource BuilderIconButtonStyle}"
                                ToolTip="Save"
                                Command="{Binding SaveItemCommand}">
                            <iconPacks:PackIconLucide Kind="Save" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource BuilderIconButtonStyle}"
                                ToolTip="Move up"
                                Command="{Binding MoveUpCommand}">
                            <iconPacks:PackIconLucide Kind="ChevronUp" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource BuilderIconButtonStyle}"
                                ToolTip="Move down"
                                Command="{Binding MoveDownCommand}">
                            <iconPacks:PackIconLucide Kind="ChevronDown" Width="14" Height="14" />
                        </Button>
                    </WrapPanel>
                </DockPanel>
                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="28"
                                    MaxHeight="28"
                                    Background="{StaticResource AppBrushSurfaceRaised}"
                                    BorderBrush="{StaticResource AppBrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,0"
                                    ClipToBounds="True"
                                    ToolTip="{Binding Pattern}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding DirtyMark}"
                                               Foreground="{StaticResource AppBrushWarning}"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                    <views:QueryTemplateHighlightText Template="{Binding Pattern}"
                                                                       TargetKind="{Binding TargetKind}"
                                                                       FontSize="13"
                                                                       Height="18"
                                                                       MaxHeight="18"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="Insert tokens"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <ItemsControl DockPanel.Dock="Top"
                              ItemsSource="{Binding TokenButtons}"
                              Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Style="{StaticResource TokenChipButtonStyle}"
                                    Command="{Binding DataContext.InsertChipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl DockPanel.Dock="Top"
                              ItemsSource="{Binding LiteralChips}"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Style="{StaticResource AppOutlinedButtonStyle}"
                                    Padding="8,4"
                                    Margin="0,0,6,6"
                                    Command="{Binding DataContext.InsertChipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock DockPanel.Dock="Top"
                           Text="Template"
                           Style="{StaticResource BuilderLabelStyle}" />
                <TextBox x:Name="PatternBox"
                         DockPanel.Dock="Top"
                         Text="{Binding SelectedItem.Pattern, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource BuilderTemplateTextBoxStyle}"
                         IsEnabled="{Binding HasPatternEditor}"
                         SelectionChanged="PatternBox_SelectionChanged"
                         Margin="0,0,0,8" />
                <Border Background="{StaticResource AppBrushSurface}"
                        BorderBrush="{StaticResource AppBrushBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,4,10,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  IsTabStop="False"
                                  KeyboardNavigation.TabNavigation="None"
                                  KeyboardNavigation.DirectionalNavigation="None">
                        <ItemsControl ItemsSource="{Binding PreviewLines}"
                                      Focusable="False"
                                      IsTabStop="False"
                                      KeyboardNavigation.TabNavigation="None">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}"
                                               Style="{StaticResource PreviewLineStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
