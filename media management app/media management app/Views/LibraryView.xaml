<UserControl x:Class="media_management_app.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:media_management_app.Common"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="EpisodeRowTemplate">
            <Border Background="{StaticResource AppBrushSurface}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding EpisodeCode}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AirDateDisplay}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AvailabilityLabel}"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                        <TextBlock Text="{Binding LibraryLinkStatus}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="In cart">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInCart}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Command="{Binding DataContext.AddEpisodeToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanAddToCart}"
                                Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AppPrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInCart}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ShoppingCart"
                                                           Width="14"
                                                           Height="14"
                                                           Margin="0,0,6,0"
                                                           Foreground="#ffffff"
                                                           VerticalAlignment="Center" />
                                <TextBlock Text="Add" VerticalAlignment="Center" Foreground="#ffffff" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AppOutlinedButtonStyle}"
                                Command="{Binding DataContext.LinkEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanLink}"
                                Margin="0"
                                ToolTip="Create library hardlink for this episode">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Link"
                                                           Width="14"
                                                           Height="14"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center" />
                                <TextBlock Text="Link" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SeasonTemplate">
            <materialDesign:Card Margin="0,0,0,10"
                                 Style="{StaticResource PanelCardStyle}"
                                 Padding="12">
                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Layers"
                                                               Width="15"
                                                               Height="15"
                                                               Margin="0,0,8,0"
                                                               Foreground="{StaticResource AppBrushShowAccent}"
                                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Header}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding PackModeBannerTitle}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsPackMode, Mode=TwoWay}"
                                      Content="Pack mode"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      IsEnabled="{Binding CanTogglePackMode}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource AppOutlinedButtonStyle}"
                                    Command="{Binding DataContext.AddAllMissingEpisodesToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsEpisodeWorkflowEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="ListPlus"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Add Missing" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AppPrimaryButtonStyle}"
                                    Command="{Binding DataContext.AddSeasonPackToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanAddPackToCart}"
                                    Visibility="{Binding IsPackMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="PackagePlus"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,6,0"
                                                               Foreground="#ffffff"
                                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Add Pack" VerticalAlignment="Center" Foreground="#ffffff" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AppOutlinedButtonStyle}"
                                    Command="{Binding DataContext.LinkSeasonPackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding CanLinkPack}"
                                    Visibility="{Binding IsPackMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="8,0,0,0"
                                    ToolTip="Create library hardlinks for this season pack">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Link"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Link Pack" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding PackLinkStatus}"
                                       Style="{StaticResource MutedTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Episodes}"
                                      ItemTemplate="{StaticResource EpisodeRowTemplate}" />
                    </StackPanel>
                </Expander>
            </materialDesign:Card>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBrushCanvas}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Style="{StaticResource PanelCardStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="LibraryBig"
                                                           Width="16"
                                                           Height="16"
                                                           Margin="0,0,8,0"
                                                           Foreground="{StaticResource AppBrushAccent}"
                                                           VerticalAlignment="Center" />
                                <TextBlock Text="Media Card" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <TextBlock Text="Tracked library"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource AppIconButtonStyle}"
                                    Command="{Binding RefreshLibraryCommand}"
                                    ToolTip="Refresh library">
                                <iconPacks:PackIconLucide Kind="RefreshCcw" Style="{StaticResource AppIconStyle}" />
                            </Button>
                            <Button Style="{StaticResource AppIconButtonStyle}"
                                    Command="{Binding DeleteEntireLibraryCommand}"
                                    ToolTip="Delete entire library"
                                    Margin="4,0,0,0">
                                <iconPacks:PackIconLucide Kind="Trash2"
                                                           Style="{StaticResource AppIconStyle}"
                                                           Foreground="{StaticResource AppBrushDanger}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource AppBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="7"
                            ClipToBounds="True"
                            Margin="0,14,0,12">
                        <UniformGrid Rows="1" Columns="3">
                            <Button Style="{StaticResource SortSegmentButtonStyle}"
                                    Command="{Binding SetMediaSortModeCommand}"
                                    CommandParameter="{x:Static common:MediaCardSortMode.DateAddedDesc}"
                                    Tag="{Binding IsDateSortSelected}"
                                    BorderThickness="0,0,1,0"
                                    ToolTip="Sort by newest added">
                                <iconPacks:PackIconLucide Kind="CalendarClock" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource SortSegmentButtonStyle}"
                                    Command="{Binding SetMediaSortModeCommand}"
                                    CommandParameter="{x:Static common:MediaCardSortMode.TypeThenTitle}"
                                    Tag="{Binding IsTypeSortSelected}"
                                    BorderThickness="0,0,1,0"
                                    ToolTip="Sort by media type">
                                <iconPacks:PackIconLucide Kind="Tags" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource SortSegmentButtonStyle}"
                                    Command="{Binding SetMediaSortModeCommand}"
                                    CommandParameter="{x:Static common:MediaCardSortMode.Title}"
                                    Tag="{Binding IsNameSortSelected}"
                                    BorderThickness="0"
                                    ToolTip="Sort by title">
                                <iconPacks:PackIconLucide Kind="ArrowDownAZ" Width="14" Height="14" />
                            </Button>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <TextBlock Text="No media in library yet. Use Find/Add."
                           TextAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MediaCards}"
                                  ItemTemplate="{StaticResource WorkspaceMediaCardTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <iconPacks:PackIconLucide Kind="Info"
                                           Width="16"
                                           Height="16"
                                           Margin="0,0,8,0"
                                           Foreground="{StaticResource AppBrushMutedText}"
                                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MutedTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </StackPanel>

            <materialDesign:Card Grid.Row="1" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedMedia}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconLucide Kind="MousePointerClick"
                                                   Width="36"
                                                   Height="36"
                                                   Foreground="{StaticResource AppBrushMutedText}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,12" />
                        <TextBlock Text="Select a media card to view details."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelectedMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="170"
                                        Height="255"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource AppBrushSurface}"
                                        BorderBrush="{StaticResource AppBrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        materialDesign:ElevationAssist.Elevation="Dp2">
                                    <Grid Background="#0f172a">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <iconPacks:PackIconLucide Kind="ImageOff"
                                                                       Width="28"
                                                                       Height="28"
                                                                       Foreground="{StaticResource AppBrushMutedText}"
                                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="No cover"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                        <Image Source="{Binding SelectedPosterImage}"
                                               Stretch="Uniform" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedMediaCard.Title}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource AppDangerButtonStyle}"
                                                Command="{Binding DeleteSelectedMediaCommand}"
                                                Margin="12,0,0,0"
                                                ToolTip="Delete selected media from library">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="Trash2"
                                                                           Width="14"
                                                                           Height="14"
                                                                           Margin="0,0,6,0"
                                                                           Foreground="#ffffff"
                                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="Delete" VerticalAlignment="Center" Foreground="#ffffff" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Style="{StaticResource MediaTypeChipStyle}">
                                            <TextBlock Text="{Binding SelectedMediaCard.TypeLabel}"
                                                       Style="{StaticResource MediaTypeChipTextStyle}" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedMediaCard.YearLabel, StringFormat=Year {0}}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedShow.Stats}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,10,0,0"
                                               Visibility="{Binding IsSelectedShow, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding SelectedMovie.AvailabilityLabel}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,10,0,0"
                                               Visibility="{Binding IsSelectedMovie, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding SelectedShow.PreferencesSummary}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding IsSelectedShow, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding SelectedShow.RecipeSummary}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsSelectedShow, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="Edit recipes in the Torrent tab."
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSelectedShow, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding SelectedMovie.PreferencesSummary}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding IsSelectedMovie, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding SelectedMovie.RecipeSummary}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding IsSelectedMovie, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="Edit recipe in the Torrent tab."
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding IsSelectedMovie, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding SelectedShow.Overview}"
                                               Margin="0,14,0,0"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Visibility="{Binding IsSelectedShow, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding SelectedMovie.Overview}"
                                               Margin="0,14,0,0"
                       TextWrapping="Wrap"
                                               LineHeight="20"
                                               Visibility="{Binding IsSelectedMovie, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,20,0,0"
                                    Padding="0,20,0,0"
                                    BorderBrush="{StaticResource AppBrushBorder}"
                                    BorderThickness="0,1,0,0"
                                    Visibility="{Binding IsSelectedMovie, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel DataContext="{Binding SelectedMovie}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <iconPacks:PackIconLucide Kind="Film"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{StaticResource AppBrushMovieAccent}"
                                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Movie" Style="{StaticResource SectionTitleStyle}" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AvailabilityLabel}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LibraryLinkStatus}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource AppPrimaryButtonStyle}"
                                                    Command="{Binding DataContext.AddMovieToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanAddToCart}"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconLucide Kind="ShoppingCart"
                                                                               Width="14"
                                                                               Height="14"
                                                                               Margin="0,0,6,0"
                                                                               Foreground="#ffffff"
                                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Add to Cart" VerticalAlignment="Center" Foreground="#ffffff" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AppOutlinedButtonStyle}"
                                                    Command="{Binding DataContext.LinkMovieCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanLink}"
                                                    Margin="0"
                                                    ToolTip="Create library hardlink for this movie">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconLucide Kind="Link"
                                                                               Width="14"
                                                                               Height="14"
                                                                               Margin="0,0,6,0"
                                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Link" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,20,0,0"
                                        Visibility="{Binding IsSelectedShow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <iconPacks:PackIconLucide Kind="Tv"
                                                               Width="16"
                                                               Height="16"
                                                               Margin="0,0,8,0"
                                                               Foreground="{StaticResource AppBrushShowAccent}"
                                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Seasons" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SelectedShow.Seasons}"
                                              ItemTemplate="{StaticResource SeasonTemplate}" />
                            </StackPanel>
        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
