<UserControl x:Class="media_management_app.Views.FindAddView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:media_management_app.Common"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="ResultRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f7fbff" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#edf7f5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LibraryMediaCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeLabel}" Value="Show">
                    <Setter Property="Background" Value="{StaticResource AppBrushShowSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AppBrushShowAccent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TypeLabel}" Value="Movie">
                    <Setter Property="Background" Value="{StaticResource AppBrushMovieSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AppBrushMovieAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MediaTypeChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushShowSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushShowAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeLabel}" Value="Movie">
                    <Setter Property="Background" Value="{StaticResource AppBrushMovieSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AppBrushMovieAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MediaTypeChipTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushShowAccent}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeLabel}" Value="Movie">
                    <Setter Property="Foreground" Value="{StaticResource AppBrushMovieAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushNewSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushNewAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlreadyAdded}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusChipTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushNewAccent}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlreadyAdded}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AppBrushAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultCellBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="ResultHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortIndicatorIconStyle" TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="NameSortAscIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource SortIndicatorIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NameSortIndicator}" Value="Asc">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NameSortDescIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource SortIndicatorIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NameSortIndicator}" Value="Desc">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeSortAscIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource SortIndicatorIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeSortIndicator}" Value="Asc">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeSortDescIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource SortIndicatorIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding TypeSortIndicator}" Value="Desc">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="YearSortAscIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource SortIndicatorIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding YearSortIndicator}" Value="Asc">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="YearSortDescIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource SortIndicatorIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding YearSortIndicator}" Value="Desc">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatsSortAscIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource SortIndicatorIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatsSortIndicator}" Value="Asc">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatsSortDescIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource SortIndicatorIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatsSortIndicator}" Value="Desc">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusSortAscIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource SortIndicatorIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusSortIndicator}" Value="Asc">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusSortDescIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource SortIndicatorIconStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusSortIndicator}" Value="Desc">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SortSegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#d7ebe6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                    <Setter Property="Foreground" Value="{StaticResource AppBrushAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RecipeComboBoxItemTemplate">
            <TextBlock Text="{Binding Name}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center" />
        </DataTemplate>

        <Style x:Key="DetailRecipeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="270" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemTemplate" Value="{StaticResource RecipeComboBoxItemTemplate}" />
            <Setter Property="ToolTip" Value="Recipe used after adding this media" />
        </Style>

        <Style x:Key="DetailAddButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="144" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource AppIconButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBrushCanvas}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Style="{StaticResource PanelCardStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Library" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Existing media"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource AppIconButtonStyle}"
                                Command="{Binding RefreshExistingMediaCommand}"
                                ToolTip="Refresh media cards">
                            <iconPacks:PackIconLucide Kind="RefreshCcw" Style="{StaticResource AppIconStyle}" />
                        </Button>
                    </Grid>

                    <Border BorderBrush="{StaticResource AppBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="7"
                            ClipToBounds="True"
                            Margin="0,14,0,12">
                        <UniformGrid Rows="1" Columns="3">
                            <Button Style="{StaticResource SortSegmentButtonStyle}"
                                    Command="{Binding SetMediaSortModeCommand}"
                                    CommandParameter="{x:Static common:MediaCardSortMode.DateAddedDesc}"
                                    Tag="{Binding IsDateSortSelected}"
                                    BorderThickness="0,0,1,0"
                                    ToolTip="Sort by newest added">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="CalendarClock"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,5,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Date" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SortSegmentButtonStyle}"
                                    Command="{Binding SetMediaSortModeCommand}"
                                    CommandParameter="{x:Static common:MediaCardSortMode.TypeThenTitle}"
                                    Tag="{Binding IsTypeSortSelected}"
                                    BorderThickness="0,0,1,0"
                                    ToolTip="Sort by media type">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Tags"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,5,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Type" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SortSegmentButtonStyle}"
                                    Command="{Binding SetMediaSortModeCommand}"
                                    CommandParameter="{x:Static common:MediaCardSortMode.Title}"
                                    Tag="{Binding IsNameSortSelected}"
                                    BorderThickness="0"
                                    ToolTip="Sort by title">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="ArrowDownAZ"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,5,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="Name" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <TextBlock Text="No media in library yet."
                           TextAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasExistingMedia}" Value="False">
                                    <Setter Property="UIElement.Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ExistingMediaCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LibraryMediaCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource AppBrushShowAccent}"
                                                CornerRadius="8,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AppBrushShowAccent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TypeLabel}" Value="Movie">
                                                            <Setter Property="Background" Value="{StaticResource AppBrushMovieAccent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource MediaTypeChipStyle}"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding TypeLabel}"
                                                           Style="{StaticResource MediaTypeChipTextStyle}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding ProgressLabel}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding AddedLabel, StringFormat=Added {0}}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="40"
                             Margin="0"
                             VerticalContentAlignment="Center"
                             ToolTip="Search TMDB by title">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2"
                            Command="{Binding SearchCommand}"
                            MinWidth="132"
                            MinHeight="40"
                            Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Search"
                                                       Width="17"
                                                       Height="17"
                                                       Margin="0,0,8,0"
                                                       Foreground="{StaticResource AppBrushText}" />
                            <TextBlock Text="Search TMDB" />
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Style="{StaticResource PanelCardStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Search Results" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Width="120"
                                         Height="4"
                                         IsIndeterminate="True"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0" />
                            <Button Style="{StaticResource AppIconButtonStyle}"
                                    Command="{Binding CancelSearchCommand}"
                                    ToolTip="Cancel TMDB search">
                                <iconPacks:PackIconLucide Kind="CircleStop"
                                                           Width="19"
                                                           Height="19"
                                                           Foreground="{StaticResource AppBrushText}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Enter a title and search TMDB."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchResults}" Value="False">
                                            <Setter Property="UIElement.Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border BorderBrush="{StaticResource AppBrushBorder}"
                                BorderThickness="1"
                                CornerRadius="7"
                                ClipToBounds="True"
                                Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top"
                                      Background="{StaticResource AppBrushSurface}"
                                      Margin="0,0,17,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="122" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource ResultCellBorderStyle}">
                                        <Button Style="{StaticResource ResultHeaderButtonStyle}"
                                                Command="{Binding SetSearchResultSortCommand}"
                                                CommandParameter="{x:Static common:SearchResultSortColumn.Name}">
                                            <DockPanel>
                                                <TextBlock Text="Name" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                                <iconPacks:PackIconLucide Kind="ArrowUp"
                                                                           Style="{StaticResource NameSortAscIconStyle}" />
                                                <iconPacks:PackIconLucide Kind="ArrowDown"
                                                                           Style="{StaticResource NameSortDescIconStyle}" />
                                            </DockPanel>
                                        </Button>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource ResultCellBorderStyle}">
                                        <Button Style="{StaticResource ResultHeaderButtonStyle}"
                                                Command="{Binding SetSearchResultSortCommand}"
                                                CommandParameter="{x:Static common:SearchResultSortColumn.Type}">
                                            <DockPanel>
                                                <TextBlock Text="Type" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                                <iconPacks:PackIconLucide Kind="ArrowUp"
                                                                           Style="{StaticResource TypeSortAscIconStyle}" />
                                                <iconPacks:PackIconLucide Kind="ArrowDown"
                                                                           Style="{StaticResource TypeSortDescIconStyle}" />
                                            </DockPanel>
                                        </Button>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource ResultCellBorderStyle}">
                                        <Button Style="{StaticResource ResultHeaderButtonStyle}"
                                                Command="{Binding SetSearchResultSortCommand}"
                                                CommandParameter="{x:Static common:SearchResultSortColumn.Year}">
                                            <DockPanel>
                                                <TextBlock Text="Year" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                                <iconPacks:PackIconLucide Kind="ArrowUp"
                                                                           Style="{StaticResource YearSortAscIconStyle}" />
                                                <iconPacks:PackIconLucide Kind="ArrowDown"
                                                                           Style="{StaticResource YearSortDescIconStyle}" />
                                            </DockPanel>
                                        </Button>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource ResultCellBorderStyle}">
                                        <Button Style="{StaticResource ResultHeaderButtonStyle}"
                                                Command="{Binding SetSearchResultSortCommand}"
                                                CommandParameter="{x:Static common:SearchResultSortColumn.Stats}">
                                            <DockPanel>
                                                <TextBlock Text="Stats" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                                <iconPacks:PackIconLucide Kind="ArrowUp"
                                                                           Style="{StaticResource StatsSortAscIconStyle}" />
                                                <iconPacks:PackIconLucide Kind="ArrowDown"
                                                                           Style="{StaticResource StatsSortDescIconStyle}" />
                                            </DockPanel>
                                        </Button>
                                    </Border>
                                    <Border Grid.Column="4"
                                            BorderBrush="{StaticResource AppBrushBorder}"
                                            BorderThickness="0,0,0,1"
                                            Padding="10,8">
                                        <Button Style="{StaticResource ResultHeaderButtonStyle}"
                                                Command="{Binding SetSearchResultSortCommand}"
                                                CommandParameter="{x:Static common:SearchResultSortColumn.Status}">
                                            <DockPanel>
                                                <TextBlock Text="Status" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                                <iconPacks:PackIconLucide Kind="ArrowUp"
                                                                           Style="{StaticResource StatusSortAscIconStyle}" />
                                                <iconPacks:PackIconLucide Kind="ArrowDown"
                                                                           Style="{StaticResource StatusSortDescIconStyle}" />
                                            </DockPanel>
                                        </Button>
                                    </Border>
                                </Grid>

                                <ListBox ItemsSource="{Binding SearchResultsView}"
                                         SelectedItem="{Binding SelectedResult}"
                                         ItemContainerStyle="{StaticResource ResultRowStyle}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="126" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="122" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource ResultCellBorderStyle}">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Border>
                                                <Border Grid.Column="1" Style="{StaticResource ResultCellBorderStyle}">
                                                    <Border Style="{StaticResource MediaTypeChipStyle}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding TypeLabel}"
                                                                   Style="{StaticResource MediaTypeChipTextStyle}" />
                                                    </Border>
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource ResultCellBorderStyle}">
                                                    <TextBlock Text="{Binding YearLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Border>
                                                <Border Grid.Column="3" Style="{StaticResource ResultCellBorderStyle}">
                                                    <TextBlock Text="{Binding StatLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </Border>
                                                <Border Grid.Column="4"
                                                        BorderBrush="{StaticResource AppBrushBorder}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="10,8">
                                                    <Border Style="{StaticResource StatusChipStyle}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding LibraryStatus}"
                                                                   Style="{StaticResource StatusChipTextStyle}" />
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="4" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <TextBlock Text="Select a search result to inspect it before adding."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedResult}" Value="False">
                                        <Setter Property="UIElement.Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Visibility="{Binding HasSelectedResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="UIElement.Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResultDetailsCompact}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="170"
                                    Height="255"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource AppBrushSurface}"
                                    BorderBrush="{StaticResource AppBrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Grid Background="#0f172a">
                                    <TextBlock Text="No cover"
                                               Style="{StaticResource MutedTextStyle}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding SelectedResult.PosterImage}"
                                           Stretch="Uniform" />
                                </Grid>
                            </Border>

                            <Grid Grid.Column="2" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedResultHeading}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding SelectedResultSubheading}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1"
                                                 Width="96"
                                                 Height="4"
                                                 IsIndeterminate="True"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsLoadingDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ComboBox Grid.Column="3"
                                              Style="{StaticResource DetailRecipeComboBoxStyle}"
                                              ItemsSource="{Binding RecipeOptions}"
                                              SelectedValue="{Binding SelectedRecipeId}"
                                              SelectedValuePath="RecipeId"
                                              Margin="0" />
                                    <Button Grid.Column="5"
                                            Style="{StaticResource DetailAddButtonStyle}"
                                            Command="{Binding AddSelectedToLibraryCommand}"
                                            Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Plus"
                                                                       Width="17"
                                                                       Height="17"
                                                                       Margin="0,0,8,0"
                                                                       Foreground="{StaticResource AppBrushText}" />
                                            <TextBlock Text="{Binding AddButtonText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="7"
                                            Style="{StaticResource DetailToggleButtonStyle}"
                                            Command="{Binding ToggleResultDetailsCompactCommand}"
                                            ToolTip="Compact result details">
                                        <iconPacks:PackIconLucide Kind="ChevronDown" Style="{StaticResource AppIconStyle}" />
                                    </Button>
                                </Grid>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              MaxHeight="150"
                                              Margin="0,16,0,0">
                                    <TextBlock Text="{Binding SelectedResult.Overview}"
                                               Foreground="{StaticResource AppBrushText}"
                                               FontSize="13"
                                               LineHeight="20"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <Grid MinHeight="48">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResultDetailsCompact}" Value="True">
                                            <Setter Property="UIElement.Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedResultHeading}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding SelectedResultSubheading}"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <ProgressBar Grid.Column="2"
                                         Width="88"
                                         Height="4"
                                         IsIndeterminate="True"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsLoadingDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBox Grid.Column="4"
                                      Style="{StaticResource DetailRecipeComboBoxStyle}"
                                      ItemsSource="{Binding RecipeOptions}"
                                      SelectedValue="{Binding SelectedRecipeId}"
                                      SelectedValuePath="RecipeId"
                                      Margin="0"
                                      VerticalAlignment="Center" />
                            <Button Grid.Column="6"
                                    Style="{StaticResource DetailAddButtonStyle}"
                                    Command="{Binding AddSelectedToLibraryCommand}"
                                    Margin="0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Plus"
                                                               Width="17"
                                                               Height="17"
                                                               Margin="0,0,8,0"
                                                               Foreground="{StaticResource AppBrushText}" />
                                    <TextBlock Text="{Binding AddButtonText}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="8"
                                    Style="{StaticResource DetailToggleButtonStyle}"
                                    Command="{Binding ToggleResultDetailsCompactCommand}"
                                    VerticalAlignment="Center"
                                    ToolTip="Expand result details">
                                <iconPacks:PackIconLucide Kind="ChevronUp" Style="{StaticResource AppIconStyle}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
