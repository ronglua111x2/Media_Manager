<UserControl x:Class="media_management_app.Views.RecipeWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:media_management_app.Models">
    <!-- #region Local resources and templates -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="RecipeButtonTemplate">
            <Button Command="{Binding DataContext.SelectRecipeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Margin="0,0,0,8"
                    HorizontalContentAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
                        <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text=" • " Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding ModuleCountLabel}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ModuleButtonTemplate">
            <Button Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SortSegmentButtonStyle}">
                        <Setter Property="MinHeight" Value="44" />
                        <Setter Property="Padding" Value="10,10" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource AppBrushAccent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <iconPacks:PackIconLucide Kind="{Binding IconKind}"
                                               Width="15"
                                               Height="15"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BlockTypeLabel}"
                               VerticalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ModuleSummaryLineTemplate">
            <TextBlock Text="{Binding}"
                       Margin="0,0,0,6"
                       TextWrapping="Wrap"
                       FontSize="12" />
        </DataTemplate>

        <DataTemplate x:Key="QualityCheckItemTemplate">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                      Margin="4,2" />
        </DataTemplate>

        <DataTemplate x:Key="ModuleHelpItemTemplate">
            <Border Background="{StaticResource AppBrushSurface}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding FieldName}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{StaticResource AppBrushAccent}" />
                    <TextBlock Text="{Binding Description}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding OutputImpact}"
                               Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="{StaticResource AppBrushText}"
                               TextWrapping="Wrap"
                               LineHeight="16" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="RecipeLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="RecipeModuleFieldsStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="RecipeInputChromeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="1" />
        </Style>

        <Style x:Key="RecipeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
        </Style>

        <Style x:Key="RecipeNumericChromeStyle" TargetType="Border" BasedOn="{StaticResource RecipeInputChromeStyle}">
            <Setter Property="Width" Value="240" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="RecipeNumericUpDownStyle" TargetType="materialDesign:NumericUpDown">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,6,4,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="RecipeQualityChromeStyle" TargetType="Border" BasedOn="{StaticResource RecipeInputChromeStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ModuleHelpPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ModuleParamPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </UserControl.Resources>
    <!-- #endregion -->

    <!-- #region Recipe workspace layout -->
    <Grid Background="{StaticResource AppBrushCanvas}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- #region Recipe list panel -->
        <materialDesign:Card Grid.Column="0" Style="{StaticResource PanelCardStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ScrollText"
                                                   Width="16"
                                                   Height="16"
                                                   Margin="0,0,8,0"
                                                   Foreground="{StaticResource AppBrushAccent}"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="Recipe Buttons" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock Text="Create and select search recipes"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,2,0,12" />

                    <Border BorderBrush="{StaticResource AppBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="7"
                            ClipToBounds="True"
                            Margin="0,0,0,8">
                        <UniformGrid Rows="1" Columns="3">
                            <Button Style="{StaticResource SortSegmentButtonStyle}"
                                    Command="{Binding CreateRecipeCommand}"
                                    BorderThickness="0,0,1,0"
                                    ToolTip="Create recipe">
                                <iconPacks:PackIconLucide Kind="Plus" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource SortSegmentButtonStyle}"
                                    Command="{Binding DuplicateRecipeCommand}"
                                    BorderThickness="0,0,1,0"
                                    ToolTip="Duplicate recipe">
                                <iconPacks:PackIconLucide Kind="Copy" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource SortSegmentButtonStyle}"
                                    Command="{Binding DeleteRecipeCommand}"
                                    BorderThickness="0"
                                    ToolTip="Delete recipe">
                                <iconPacks:PackIconLucide Kind="Trash2"
                                                           Width="14"
                                                           Height="14"
                                                           Foreground="{StaticResource AppBrushDanger}" />
                            </Button>
                        </UniformGrid>
                    </Border>

                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                            Command="{Binding RefreshRecipesFolderCommand}"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Stretch"
                            ToolTip="Scan recipe folder for manually added .rcp files">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="RefreshCcw"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                            <TextBlock Text="Refresh folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="No recipes found."
                           TextAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecipes}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Recipes}"
                                  ItemTemplate="{StaticResource RecipeButtonTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>
        <!-- #endregion -->

        <!-- #region Recipe editor and module guide -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ScrollText"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,8,0"
                                                   Foreground="{StaticResource AppBrushAccent}"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="Modules" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource AppPrimaryButtonStyle}"
                        Command="{Binding SaveRecipeCommand}"
                        Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Save"
                                                   Width="14"
                                                   Height="14"
                                                   Margin="0,0,6,0"
                                                   Foreground="#ffffff"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="Save Recipe" Foreground="#ffffff" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <materialDesign:Card Grid.Row="1" Style="{StaticResource PanelCardStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Recipe name" Style="{StaticResource RecipeLabelStyle}" />
                                <TextBox Text="{Binding SelectedRecipeName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Target" Style="{StaticResource RecipeLabelStyle}" />
                                <ComboBox ItemsSource="{Binding TargetKinds}"
                                          SelectedItem="{Binding SelectedRecipeTargetKind}"
                                          Padding="10,7" />
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{StaticResource AppBrushBorder}"
                                BorderThickness="1"
                                CornerRadius="7"
                                ClipToBounds="True"
                                Padding="4"
                                Margin="0,0,0,14">
                            <ItemsControl ItemsSource="{Binding Modules}"
                                          ItemTemplate="{StaticResource ModuleButtonTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <Grid DataContext="{Binding SelectedModule}"
                          Visibility="{Binding HasSelectedModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="280" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: parameters (independent scroll) -->
                        <ScrollViewer Grid.Column="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Border Style="{StaticResource ModuleParamPanelStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ModuleHint}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Content="Enabled"
                                                  IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Top" />
                                    </Grid>

                                    <Border BorderBrush="{StaticResource AppBrushBorder}"
                                            BorderThickness="0,0,0,1"
                                            Margin="0,0,0,16" />

                                    <!-- Identity -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="{x:Static models:RecipeBlockType.Identity}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Style="{StaticResource RecipeModuleFieldsStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Title aliases" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding AliasesText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}"
                                                         AcceptsReturn="True"
                                                         MinHeight="140"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Query -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="{x:Static models:RecipeBlockType.QueryBuilder}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Style="{StaticResource RecipeModuleFieldsStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Quality allow list" Style="{StaticResource RecipeLabelStyle}" />
                                                <Border Style="{StaticResource RecipeQualityChromeStyle}">
                                                    <Expander Background="{StaticResource AppBrushSurface}"
                                                              BorderThickness="0">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding SelectedQualitiesSummary}"
                                                                       Padding="10,8" />
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding QualityOptions}"
                                                                      ItemTemplate="{StaticResource QualityCheckItemTemplate}"
                                                                      Margin="10,6,10,10" />
                                                    </Expander>
                                                </Border>
                                                <TextBlock Text="Preferred audio" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding PreferredAudioCodec, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}" />
                                                <TextBlock Text="Query templates" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding QueryTemplatesText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}"
                                                         AcceptsReturn="True"
                                                         MinHeight="100"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" />
                                                <TextBlock Text="Custom query" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding CustomQuery, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Search -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="{x:Static models:RecipeBlockType.SearchSource}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Style="{StaticResource RecipeModuleFieldsStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Search mode" Style="{StaticResource RecipeLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding SearchModeOptions}"
                                                          SelectedItem="{Binding SearchMode, Mode=TwoWay}"
                                                          Padding="10,7"
                                                          Margin="0,0,0,12" />
                                                <TextBlock Text="Plugins" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding Plugins, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}" />
                                                <TextBlock Text="Category" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}" />
                                                <TextBlock Text="Candidates per fetch" Style="{StaticResource RecipeLabelStyle}" />
                                                <Border Style="{StaticResource RecipeNumericChromeStyle}">
                                                    <materialDesign:NumericUpDown Style="{StaticResource RecipeNumericUpDownStyle}"
                                                                                  Value="{Binding MaxCandidatesPerFetch, UpdateSourceTrigger=PropertyChanged}"
                                                                                  Minimum="1"
                                                                                  Maximum="10" />
                                                </Border>
                                                <CheckBox Content="Deduplicate candidates"
                                                          IsChecked="{Binding DeduplicateCandidates}"
                                                          Margin="0,0,0,8" />
                                                <CheckBox Content="Fuzzy deduplicate (by filename + size)"
                                                          IsChecked="{Binding FuzzyDeduplicate}"
                                                          Margin="0,0,0,8" />
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFuzzyDeduplicateEnabled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Fuzzy dedup size tolerance (MB)" Style="{StaticResource RecipeLabelStyle}" />
                                                    <Border Style="{StaticResource RecipeNumericChromeStyle}">
                                                        <materialDesign:NumericUpDown Style="{StaticResource RecipeNumericUpDownStyle}"
                                                                                      Value="{Binding FuzzyDeduplicateSizeToleranceMb, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Minimum="0"
                                                                                      Maximum="100" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,12">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsParallelSearchMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Parallel episode search"
                                                               FontWeight="SemiBold"
                                                               Margin="0,8,0,4" />
                                                    <TextBlock Text="Runs per-episode qBittorrent searches with multiple workers."
                                                               Style="{StaticResource MutedTextStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,8" />
                                                    <TextBlock Text="Result limit" Style="{StaticResource RecipeLabelStyle}" />
                                                    <Border Style="{StaticResource RecipeNumericChromeStyle}">
                                                        <materialDesign:NumericUpDown Style="{StaticResource RecipeNumericUpDownStyle}"
                                                                                      Value="{Binding ResultLimit, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Minimum="1"
                                                                                      Maximum="5000" />
                                                    </Border>
                                                    <TextBlock Text="Parallel searches" Style="{StaticResource RecipeLabelStyle}" />
                                                    <Border Style="{StaticResource RecipeNumericChromeStyle}">
                                                        <materialDesign:NumericUpDown Style="{StaticResource RecipeNumericUpDownStyle}"
                                                                                      Value="{Binding ParallelSearchCount, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Minimum="1"
                                                                                      Maximum="8" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSnapshotSearchMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Show snapshot search"
                                                               FontWeight="SemiBold"
                                                               Margin="0,8,0,4" />
                                                    <TextBlock Text="Captures one show-level result set, then matches results to episodes locally."
                                                               Style="{StaticResource MutedTextStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,8" />
                                                    <TextBlock Text="Snapshot target results" Style="{StaticResource RecipeLabelStyle}" />
                                                    <Border Style="{StaticResource RecipeNumericChromeStyle}">
                                                        <materialDesign:NumericUpDown Style="{StaticResource RecipeNumericUpDownStyle}"
                                                                                      Value="{Binding SnapshotTargetResults, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Minimum="100"
                                                                                      Maximum="5000" />
                                                    </Border>
                                                    <TextBlock Text="Snapshot timeout seconds" Style="{StaticResource RecipeLabelStyle}" />
                                                    <Border Style="{StaticResource RecipeNumericChromeStyle}">
                                                        <materialDesign:NumericUpDown Style="{StaticResource RecipeNumericUpDownStyle}"
                                                                                      Value="{Binding SnapshotTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Minimum="30"
                                                                                      Maximum="300" />
                                                    </Border>
                                                    <TextBlock Text="Snapshot idle timeout seconds (0 = off)" Style="{StaticResource RecipeLabelStyle}" />
                                                    <Border Style="{StaticResource RecipeNumericChromeStyle}">
                                                        <materialDesign:NumericUpDown Style="{StaticResource RecipeNumericUpDownStyle}"
                                                                                      Value="{Binding SnapshotIdleTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Minimum="0"
                                                                                      Maximum="120" />
                                                    </Border>
                                                    <TextBlock Text="Local match workers" Style="{StaticResource RecipeLabelStyle}" />
                                                    <Border Style="{StaticResource RecipeNumericChromeStyle}">
                                                        <materialDesign:NumericUpDown Style="{StaticResource RecipeNumericUpDownStyle}"
                                                                                      Value="{Binding LocalMatchWorkers, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Minimum="1"
                                                                                      Maximum="8" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Quality filter -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="{x:Static models:RecipeBlockType.CandidateFilter}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Style="{StaticResource RecipeModuleFieldsStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Quality" Style="{StaticResource RecipeLabelStyle}" />
                                                <Border Style="{StaticResource RecipeQualityChromeStyle}">
                                                    <Expander Background="{StaticResource AppBrushSurface}"
                                                              BorderThickness="0">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding SelectedQualitiesSummary}"
                                                                       Padding="10,8" />
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding QualityOptions}"
                                                                      ItemTemplate="{StaticResource QualityCheckItemTemplate}"
                                                                      Margin="10,6,10,10" />
                                                    </Expander>
                                                </Border>
                                                <TextBlock Text="Minimum seeders" Style="{StaticResource RecipeLabelStyle}" />
                                                <Border Style="{StaticResource RecipeNumericChromeStyle}">
                                                    <materialDesign:NumericUpDown Style="{StaticResource RecipeNumericUpDownStyle}"
                                                                                  Value="{Binding MinimumSeeders, UpdateSourceTrigger=PropertyChanged}"
                                                                                  Minimum="0"
                                                                                  Maximum="10000" />
                                                </Border>
                                                <TextBlock Text="Max size GB (0 = no limit)" Style="{StaticResource RecipeLabelStyle}" />
                                                <Border Style="{StaticResource RecipeNumericChromeStyle}">
                                                    <materialDesign:NumericUpDown Style="{StaticResource RecipeNumericUpDownStyle}"
                                                                                  Value="{Binding MaximumSizeGbValue, UpdateSourceTrigger=PropertyChanged}"
                                                                                  Minimum="0"
                                                                                  Maximum="500" />
                                                </Border>
                                                <TextBlock Text="Preferred audio" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding PreferredAudioCodec, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}" />
                                                <TextBlock Text="Include terms" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding IncludeTermsText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}"
                                                         AcceptsReturn="True"
                                                         MinHeight="70"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" />
                                                <TextBlock Text="Exclude terms" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding ExcludeTermsText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}"
                                                         AcceptsReturn="True"
                                                         MinHeight="70"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" />
                                                <TextBlock Text="Preferred release groups" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding PreferredReleaseGroupsText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}" />
                                                <TextBlock Text="Blocked release groups" Style="{StaticResource RecipeLabelStyle}" />
                                                <TextBox Text="{Binding BlockedReleaseGroupsText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource RecipeTextBoxStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Parser -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="{x:Static models:RecipeBlockType.CandidateParser}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Style="{StaticResource RecipeModuleFieldsStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Choose how episode numbers are read from torrent filenames."
                                                           Style="{StaticResource MutedTextStyle}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,12" />
                                                <TextBlock Text="Episode numbering" Style="{StaticResource RecipeLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding EpisodeNumberingModeOptions}"
                                                          SelectedItem="{Binding EpisodeNumberingMode, Mode=TwoWay}"
                                                          Padding="10,7"
                                                          Margin="0,0,0,12" />
                                                <CheckBox Content="Probe candidate metadata"
                                                          IsChecked="{Binding EnableCandidateMetadataProbe}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Info-only modules -->
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource RecipeModuleFieldsStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BlockType}" Value="{x:Static models:RecipeBlockType.Scoring}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="This module has no editable parameters. See the help panel on the right."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Right: help / output impact (fixed panel, independent scroll per tab) -->
                        <Border Grid.Column="2"
                                Style="{StaticResource ModuleHelpPanelStyle}"
                                VerticalAlignment="Stretch">
                            <TabControl VerticalAlignment="Stretch" Padding="4,0,0,0">
                                <TabItem Header="Summary">
                                    <Grid Margin="0,10,0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="Current settings for this module."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,0,0,10"
                                                   TextWrapping="Wrap" />
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ModuleSummaryLines}"
                                                          ItemTemplate="{StaticResource ModuleSummaryLineTemplate}" />
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Guide">
                                    <Grid Margin="0,10,0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="How each setting affects search queries, candidate filtering, and final output."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,0,0,10"
                                                   TextWrapping="Wrap" />
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding HelpItems}"
                                                          ItemTemplate="{StaticResource ModuleHelpItemTemplate}" />
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
        <!-- #endregion -->
    </Grid>
    <!-- #endregion -->
</UserControl>
