<UserControl x:Class="media_management_app.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:media_management_app.Common"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <!-- #region Local styles and templates -->
    <UserControl.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="UniformCornerRadius" Value="8" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
        </Style>

        <Style x:Key="SettingsGuidePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SettingsGuideItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="CaretBrush" Value="{StaticResource AppBrushText}" />
        </Style>

        <Style x:Key="SettingsListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="MinHeight" Value="130" />
            <Setter Property="MaxHeight" Value="180" />
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsNumericChromeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Width" Value="220" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SettingsNumericUpDownStyle" TargetType="materialDesign:NumericUpDown">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,6,4,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="SettingsIconTextButtonStyle" TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="SettingsPrimaryIconTextButtonStyle" TargetType="Button" BasedOn="{StaticResource AppPrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="SettingsSectionSelectorStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionSelectorItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="True"
                                              TextOptions.TextFormattingMode="Display"
                                              TextOptions.TextRenderingMode="ClearType" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AppBrushAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource AppBrushOnAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionPanelBaseStyle" TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="SystemSettingsSectionPanelStyle" TargetType="ScrollViewer" BasedOn="{StaticResource SettingsSectionPanelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSection}" Value="{x:Static common:SettingsSection.System}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LibrarySettingsSectionPanelStyle" TargetType="ScrollViewer" BasedOn="{StaticResource SettingsSectionPanelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSection}" Value="{x:Static common:SettingsSection.Library}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IntegrationsSettingsSectionPanelStyle" TargetType="ScrollViewer" BasedOn="{StaticResource SettingsSectionPanelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSection}" Value="{x:Static common:SettingsSection.Integrations}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TorrentStorageSettingsSectionPanelStyle" TargetType="ScrollViewer" BasedOn="{StaticResource SettingsSectionPanelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSection}" Value="{x:Static common:SettingsSection.TorrentStorage}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotificationsSettingsSectionPanelStyle" TargetType="ScrollViewer" BasedOn="{StaticResource SettingsSectionPanelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSection}" Value="{x:Static common:SettingsSection.Notifications}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarpSettingsSectionPanelStyle" TargetType="ScrollViewer" BasedOn="{StaticResource SettingsSectionPanelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSection}" Value="{x:Static common:SettingsSection.Warp}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UiSettingsSectionPanelStyle" TargetType="ScrollViewer" BasedOn="{StaticResource SettingsSectionPanelBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSettingsSection}" Value="{x:Static common:SettingsSection.Ui}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- #endregion -->

    <!-- #region Settings workspace shell -->
    <Grid Background="{StaticResource AppBrushCanvas}"
          Margin="16"
          SnapsToDevicePixels="True"
          UseLayoutRounding="True"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- #region Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left"
                       Text="System Settings"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource AppBrushAccent}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="18,6,0,0" />
        </DockPanel>
        <!-- #endregion -->

        <!-- #region Settings section selector and panels -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- #region Section selector -->
            <ListBox Grid.Row="0"
                     Style="{StaticResource SettingsSectionSelectorStyle}"
                     ItemContainerStyle="{StaticResource SettingsSectionSelectorItemStyle}"
                     SelectedValue="{Binding SelectedSettingsSection, Mode=TwoWay}"
                     SelectedValuePath="Tag">
                <ListBoxItem Content="System"
                             Tag="{x:Static common:SettingsSection.System}"
                             Style="{StaticResource SettingsSectionSelectorItemStyle}" />
                <ListBoxItem Content="Library"
                             Tag="{x:Static common:SettingsSection.Library}"
                             Style="{StaticResource SettingsSectionSelectorItemStyle}" />
                <ListBoxItem Content="Integrations"
                             Tag="{x:Static common:SettingsSection.Integrations}"
                             Style="{StaticResource SettingsSectionSelectorItemStyle}" />
                <ListBoxItem Content="Torrent Storage"
                             Tag="{x:Static common:SettingsSection.TorrentStorage}"
                             Style="{StaticResource SettingsSectionSelectorItemStyle}" />
                <ListBoxItem Content="Notifications"
                             Tag="{x:Static common:SettingsSection.Notifications}"
                             Style="{StaticResource SettingsSectionSelectorItemStyle}" />
                <ListBoxItem Content="WARP"
                             Tag="{x:Static common:SettingsSection.Warp}"
                             Style="{StaticResource SettingsSectionSelectorItemStyle}" />
                <ListBoxItem Content="UI"
                             Tag="{x:Static common:SettingsSection.Ui}"
                             Style="{StaticResource SettingsSectionSelectorItemStyle}" />
            </ListBox>
            <!-- #endregion -->

            <!-- #region Section panels -->
            <Grid Grid.Row="1">
            <!-- #region System panel -->
                <ScrollViewer Style="{StaticResource SystemSettingsSectionPanelStyle}">
                    <Grid Margin="0,16,8,0"
                          MaxWidth="1220"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushAccent}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Storage" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Text="State Folder" Style="{StaticResource SettingsLabelStyle}" />
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding BrowseStateFolderCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}"
                                                Margin="8,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="FolderOpen" Width="16" Height="16" Margin="0,0,7,0" />
                                                <TextBlock Text="Browse" />
                                            </StackPanel>
                                        </Button>
                                        <TextBox Text="{Binding StateFolder, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsTextBoxStyle}" />
                                    </DockPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushWarning}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Logging" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Text="Max log lines per file" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding LogMaxLinesPerFile, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="100"
                                                                      Maximum="100000" />
                                    </Border>
                                    <TextBlock Text="Cleanup retention days" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding LogCleanupRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="1"
                                                                      Maximum="3650" />
                                    </Border>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushAccent}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Startup &amp; Tray" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                                              Margin="0,0,0,8"
                                              Content="Run at Windows startup" />
                                    <CheckBox IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                              Margin="0,0,0,8"
                                              Content="Start minimized to tray" />
                                    <CheckBox IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                              Margin="0,4,0,0"
                                              Content="Close button minimizes to tray" />
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushShowAccent}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Auto-Track" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding AutoTrackEnabled, Mode=TwoWay}"
                                              Margin="0,0,0,8"
                                              Content="Enable scheduled auto-track runs" />
                                    <TextBlock Text="Default hunt schedule day" Style="{StaticResource SettingsLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding AnchorDayOptions}"
                                              SelectedItem="{Binding AutoTrackAnchorDay, Mode=TwoWay}"
                                              Margin="0,0,0,8"
                                              MaxWidth="200"
                                              HorizontalAlignment="Left" />
                                    <TextBlock Text="Default hunt schedule time" Style="{StaticResource SettingsLabelStyle}" />
                                    <materialDesign:TimePicker Is24Hours="True"
                                                               SelectedTimeFormat="Short"
                                                               SelectedTime="{Binding AutoTrackAnchorTime, Mode=TwoWay}"
                                                               Foreground="{StaticResource AppBrushText}"
                                                               Margin="0,0,0,8"
                                                               MaxWidth="160"
                                                               HorizontalAlignment="Left"
                                                               FontSize="13" />
                                    <TextBlock Text="TMDB check interval (minutes)" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}" Margin="0,0,0,4">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding AutoTrackTmdbCheckIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="5"
                                                                      Maximum="1440" />
                                    </Border>
                                    <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,0,0,8"
                                               Text="Torrent hunt runs only when this check finds pending episodes (or when you press Run Now). There is no separate blind hunt timer." />
                                    <TextBlock Text="Min hours after air date before hunting (0 = no delay)" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}" Margin="0,0,0,8">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding AutoTrackHuntMinHoursAfterAirDate, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="0"
                                                                      Maximum="48" />
                                    </Border>
                                    <TextBlock Text="Reconcile poll while downloads pending (minutes)" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}" Margin="0,0,0,4">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding AutoTrackReconcileIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="5"
                                                                      Maximum="1440" />
                                    </Border>
                                    <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,0,0,8"
                                               Text="Runs only after Auto-Track successfully adds torrents, and only while downloads are still pending. Idle Auto-Track does not reconcile on a timer." />
                                    <TextBlock Text="Max TMDB refreshes per day" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}" Margin="0,0,0,8">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding AutoTrackMaxTmdbRefreshesPerDay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="1"
                                                                      Maximum="500" />
                                    </Border>
                                    <TextBlock Text="Shows per hunt cycle" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}" Margin="0,0,0,8">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding AutoTrackMaxShowsPerHuntCycle, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="1"
                                                                      Maximum="20" />
                                    </Border>
                                    <TextBlock Text="Episodes per show per hunt cycle" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}" Margin="0,0,0,8">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding AutoTrackMaxEpisodesPerShowPerHuntCycle, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="1"
                                                                      Maximum="50" />
                                    </Border>
                                    <CheckBox IsChecked="{Binding AutoTrackForceParallelEpisodeSearch, Mode=TwoWay}"
                                              Margin="0,0,0,8"
                                              Content="Force parallel episode search (no snapshot)" />
                                    <TextBlock Text="Auto-Track quality" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,8,0,8" />
                                    <TextBlock Text="Min quality" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding AutoTrackMinQuality, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8" />
                                    <TextBlock Text="Min seeders" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}" Margin="0,0,0,8">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding AutoTrackMinSeeders, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="0"
                                                                      Maximum="99999" />
                                    </Border>
                                    <TextBlock Text="Min file size (MB, 0 = off)" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}" Margin="0,0,0,8">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding AutoTrackMinFileSizeMb, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="0"
                                                                      Maximum="50000" />
                                    </Border>
                                    <TextBlock Text="Max file size (MB, 0 = off)" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}" Margin="0,0,0,8">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding AutoTrackMaxFileSizeMb, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="0"
                                                                      Maximum="50000" />
                                    </Border>
                                    <TextBlock Text="Allowed qualities (comma-separated, optional)" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding AutoTrackAllowedQualities, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8" />
                                    <TextBlock Text="Jellyfin path refresh" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,8,0,8" />
                                    <CheckBox IsChecked="{Binding AutoTrackJellyfinRefreshEnabled, Mode=TwoWay}"
                                              Margin="0,0,0,8"
                                              Content="Notify Jellyfin after Auto-Track symlink create/repair (path-based)" />
                                    <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,0,0,8"
                                               Text="Uses Library/Media/Updated for new paths only. Skips episode-group shows (NFO). TMDB SSL uses WARP Auto-Recover when needed." />
                                    <TextBlock Text="Jellyfin base URL" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding AutoTrackJellyfinBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8" />
                                    <TextBlock Text="Jellyfin API key" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding AutoTrackJellyfinApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8" />
                                    <TextBlock Text="Keep WARP on after Jellyfin notify (seconds)" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}" Margin="0,0,0,4">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
