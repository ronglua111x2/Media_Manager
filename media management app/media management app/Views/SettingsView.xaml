<UserControl x:Class="media_management_app.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsIconTextButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBrushCanvas}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left"
                       Text="System Settings"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource AppBrushAccent}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="18,6,0,0" />
        </DockPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Media Manager">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,16,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <materialDesign:Card Grid.Row="0" Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="State Folder" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding StateFolder, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0" />
                                    <TextBlock Text="Stores settings, database, recipes, and app state."
                                               Style="{StaticResource SettingsHintStyle}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Command="{Binding BrowseStateFolderCommand}"
                                        Style="{StaticResource SettingsIconTextButtonStyle}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="FolderOpen"
                                                                   Width="16"
                                                                   Height="16"
                                                                   Margin="0,0,7,0" />
                                        <TextBlock Text="Browse" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Row="1" Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Source Folders" Style="{StaticResource SettingsLabelStyle}" />
                                    <ListBox ItemsSource="{Binding SourceFolders}"
                                             SelectedItem="{Binding SelectedSourceFolder, Mode=TwoWay}"
                                             MinHeight="130"
                                             MaxHeight="170"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Command="{Binding AddSourceFolderCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="Plus" Width="16" Height="16" Margin="0,0,7,0" />
                                                <TextBlock Text="Add" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RemoveSelectedSourceFolderCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="Trash2" Width="16" Height="16" Margin="0,0,7,0" />
                                                <TextBlock Text="Remove" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Generated Library Folder" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding DefaultLibraryFolderName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0" />
                                    <TextBlock Text="Auto per-drive Jellyfin output roots"
                                               Style="{StaticResource SettingsLabelStyle}"
                                               Margin="0,14,0,5" />
                                    <ListBox ItemsSource="{Binding LibraryRootPreview}"
                                             MinHeight="130"
                                             MaxHeight="170"
                                             FontFamily="Consolas"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Row="2" Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TMDB API Read Access Token" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding TmdbReadAccessToken, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0"
                                             MaxHeight="70"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="Use the v4 read access token. Test validates the token only if the network/TLS connection reaches TMDB."
                                               Style="{StaticResource SettingsHintStyle}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Command="{Binding TestTmdbTokenCommand}"
                                        Style="{StaticResource SettingsIconTextButtonStyle}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="ShieldCheck" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="Test Token" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3"
                                        Command="{Binding SaveCommand}"
                                        Style="{StaticResource SettingsIconTextButtonStyle}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Save" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="Save" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Row="3" Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="How multi-drive output works"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource AppBrushMutedText}"
                                           Text="Hardlinks only work when the source file and linked file are on the same drive. This app creates a Jellyfin library root on each source drive." />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource AppBrushMutedText}"
                                           Margin="0,8,0,0"
                                           Text="In Jellyfin, add every generated Shows path to one Shows library and every generated Movies path to one Movies library." />
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Auto Torrent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,16,8,0">
                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="qBittorrent Web UI URL" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding QbittorrentWebUiUrl, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Username" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding QbittorrentUsername, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="Password" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding QbittorrentPassword, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Download folder" Style="{StaticResource SettingsLabelStyle}" />
                                        <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right"
                                                    Command="{Binding BrowseAutoTorrentDownloadFolderCommand}"
                                                    Content="Browse"
                                                    Margin="8,0,0,0" />
                                            <TextBox Text="{Binding AutoTorrentDownloadFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                        </DockPanel>
                                        <TextBlock Text="Category name" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding AutoTorrentCategoryName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Download folder options" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBlock Text="Search, snapshot, and candidate tuning moved to Recipe modules (Search and Parser)."
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,0,0,8"
                                               TextWrapping="Wrap" />
                                    <ListBox ItemsSource="{Binding AutoTorrentDownloadFolders}"
                                             SelectedItem="{Binding SelectedAutoTorrentDownloadFolder, Mode=TwoWay}"
                                             MinHeight="110"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Add Folder" Command="{Binding AddAutoTorrentDownloadFolderCommand}" />
                                        <Button Content="Remove Selected" Command="{Binding RemoveSelectedAutoTorrentDownloadFolderCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Candidate maintenance" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <Button Content="Clear Episode Candidates" Command="{Binding ClearEpisodeSelectedCandidatesCommand}" />
                                        <Button Content="Clear Pack Candidates" Command="{Binding ClearSeasonPackSelectedCandidatesCommand}" />
                                        <Button Content="Clear Movie Candidates" Command="{Binding ClearMovieSelectedCandidatesCommand}" />
                                        <Button Content="Clear All Candidates" Command="{Binding ClearAllSelectedCandidatesCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Background="{StaticResource AppBrushSurface}"
                            BorderBrush="{StaticResource AppBrushBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="Test Connection" Command="{Binding TestQbittorrentConnectionCommand}" />
                                <Button Content="Save Settings" Command="{Binding SaveCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Margin="12,7,0,0"
                                       Foreground="{StaticResource AppBrushAccent}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
