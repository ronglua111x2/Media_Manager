                                    <StackPanel>
                                        <TextBlock Text="Saving" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Test buttons check the current form values. Use Save Settings to persist successful connection details."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            <!-- #endregion -->

            <!-- #region Torrent storage panel -->
                <ScrollViewer Style="{StaticResource TorrentStorageSettingsSectionPanelStyle}">
                    <Grid Margin="0,16,8,0"
                          MaxWidth="1220"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushAccent}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Default Storage" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Text="Download folder" Style="{StaticResource SettingsLabelStyle}" />
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding BrowseAutoTorrentDownloadFolderCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}"
                                                Margin="8,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="FolderOpen" Width="16" Height="16" Margin="0,0,7,0" />
                                                <TextBlock Text="Browse" />
                                            </StackPanel>
                                        </Button>
                                        <TextBox Text="{Binding AutoTorrentDownloadFolder, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsTextBoxStyle}" />
                                    </DockPanel>
                                    <TextBlock Text="TV Show category" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding AutoTorrentTvShowCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsTextBoxStyle}" />
                                    <TextBlock Text="Movie category" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding AutoTorrentMovieCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsTextBoxStyle}" />
                                    <CheckBox IsChecked="{Binding AutoLinkCompletedDownloads, Mode=TwoWay}"
                                              Margin="0,4,0,0"
                                              Content="Auto-link completed downloads" />
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushNewAccent}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Download Folder Options" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding AutoTorrentDownloadFolders}"
                                             SelectedItem="{Binding SelectedAutoTorrentDownloadFolder, Mode=TwoWay}"
                                             Style="{StaticResource SettingsListBoxStyle}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding AddAutoTorrentDownloadFolderCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="Plus" Width="16" Height="16" Margin="0,0,7,0" />
                                                <TextBlock Text="Add Folder" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RemoveSelectedAutoTorrentDownloadFolderCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="Trash2" Width="16" Height="16" Margin="0,0,7,0" />
                                                <TextBlock Text="Remove Selected" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushDanger}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Candidate Maintenance" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button Command="{Binding ClearEpisodeSelectedCandidatesCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}">
                                            <TextBlock Text="Clear Episode Candidates" />
                                        </Button>
                                        <Button Command="{Binding ClearSeasonPackSelectedCandidatesCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}">
                                            <TextBlock Text="Clear Pack Candidates" />
                                        </Button>
                                        <Button Command="{Binding ClearMovieSelectedCandidatesCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}">
                                            <TextBlock Text="Clear Movie Candidates" />
                                        </Button>
                                        <Button Command="{Binding ClearAllSelectedCandidatesCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}">
                                            <TextBlock Text="Clear All Candidates" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource SettingsGuidePanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Guide" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Download folder" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="This is the default save path used when adding torrents through the app."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Folder options" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Keep common download folders here so recipe and cart workflows can reuse known storage targets."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Candidate maintenance" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="These buttons clear saved candidate selections only. They do not delete media files or torrents."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            <!-- #endregion -->

            <!-- #region Notifications panel -->
                <ScrollViewer Style="{StaticResource NotificationsSettingsSectionPanelStyle}">
                    <Grid Margin="0,16,8,0"
                          MaxWidth="1220"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushAccent}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Notification preferences" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Text="Choose which Action Center toasts to show. Changes apply after Save; no restart needed."
                                               Style="{StaticResource SettingsHintStyle}"
                                               Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding NotificationPreferences}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              Content="{Binding Title}" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Style="{StaticResource SettingsHintStyle}"
                                                               Margin="28,2,0,0"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushAccent}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Test Notification" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Text="Title" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding NotificationTestTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsTextBoxStyle}" />
                                    <TextBlock Text="Message" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding NotificationTestMessage, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsTextBoxStyle}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="72"
                                             VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="Cover image (optional)" Style="{StaticResource SettingsLabelStyle}" />
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding BrowseNotificationTestImageCommand}"
                                                Style="{StaticResource SettingsIconTextButtonStyle}"
                                                Margin="8,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="Image" Width="16" Height="16" Margin="0,0,7,0" />
                                                <TextBlock Text="Browse" />
                                            </StackPanel>
                                        </Button>
                                        <TextBox Text="{Binding NotificationTestImagePathOrUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsTextBoxStyle}" />
                                    </DockPanel>
                                    <TextBlock Text="Local file path or HTTPS URL (e.g. TMDB poster)."
                                               Style="{StaticResource SettingsHintStyle}"
                                               Margin="0,0,0,10" />
                                    <Button Command="{Binding SendTestNotificationCommand}"
                                            Style="{StaticResource SettingsPrimaryIconTextButtonStyle}"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Bell" Width="16" Height="16" Margin="0,0,7,0" />
                                            <TextBlock Text="Send test notification" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource SettingsGuidePanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Guide" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Preferences" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Toggle categories above, then Save. New toast types added in future updates appear here automatically and default to on."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Action Center" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Toasts appear in the Windows notification center. Edit the title and message, then send a test."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Click to open" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Clicking the notification should bring Media Manager to the foreground, including when the app is hidden in the tray."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Stacking" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Each test send creates a separate notification. Re-using the same tag replaces an existing toast instead of stacking."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Cover art" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Hero image shows as cover art in the toast. TMDB poster URLs work, for example: https://image.tmdb.org/t/p/w342/&lt;poster_path&gt;"
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Troubleshooting" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="If nothing appears, check Windows notification permissions for Media Manager and whether Focus Assist is blocking alerts."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            <!-- #endregion -->

            <!-- #region WARP panel -->
                <ScrollViewer Style="{StaticResource WarpSettingsSectionPanelStyle}">
                    <Grid Margin="0,16,8,0"
                          MaxWidth="1220"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushWarning}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Cloudflare WARP" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding WarpEnabled, Mode=TwoWay}"
                                              Margin="0,0,0,8"
                                              Content="Enable WARP CLI integration" />
                                    <CheckBox IsChecked="{Binding WarpAutoRecoverOnSsl, Mode=TwoWay}"
                                              Margin="0,0,0,4"
                                              Content="Auto-recover with WARP on SSL/TLS errors (Auto-Track only)" />
                                    <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,0,0,8"
                                               Text="If an Auto-Track TMDB refresh fails with SSL/TLS, connect WARP, retry, keep WARP for the rest of that cycle, then disconnect. Does not affect Library TMDB." />
                                    <TextBlock Text="Executable path (optional override)" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding WarpExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsTextBoxStyle}" />
                                    <TextBlock Style="{StaticResource SettingsHintStyle}" Margin="0,0,0,8">
                                        <Run Text="Resolved path: " />
                                        <Run Text="{Binding WarpCliResolvedPath, Mode=OneWay}" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding WarpCliAvailabilityLabel, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                    <TextBlock Text="Connect timeout (seconds)" Style="{StaticResource SettingsLabelStyle}" />
                                    <Border Style="{StaticResource SettingsNumericChromeStyle}">
                                        <materialDesign:NumericUpDown Style="{StaticResource SettingsNumericUpDownStyle}"
                                                                      Value="{Binding WarpConnectTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                                      Minimum="5"
                                                                      Maximum="120" />
                                    </Border>
                                    <Button Command="{Binding TestWarpConnectionCommand}"
                                            Style="{StaticResource SettingsIconTextButtonStyle}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Wifi" Width="16" Height="16" Margin="0,0,7,0" />
                                            <TextBlock Text="Test Connection" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource SettingsGuidePanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Guide" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Cloudflare WARP" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Requires the Cloudflare WARP desktop client installed on Windows. The app uses warp-cli.exe to connect before Auto-Track hunt fetch/add and disconnect after torrents are added. Optionally, Auto-Track TMDB can self-recover on SSL/TLS by connecting WARP for that cycle then disconnecting. Library TMDB is unaffected. If WARP is already connected, the app leaves that session open unless Auto-Track owned the connect."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Test Connection" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Checks status first. If not connected, connects briefly then disconnects to verify the CLI works. Save settings to persist changes."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Executable path" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Leave blank to use the default install path. Override only if warp-cli.exe is in a non-standard location."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            <!-- #region UI panel -->
                <ScrollViewer Style="{StaticResource UiSettingsSectionPanelStyle}">
                    <Grid Margin="0,16,8,0"
                          MaxWidth="1220"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <materialDesign:Card Style="{StaticResource SettingsCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="8"
                                                Height="24"
                                                CornerRadius="4"
                                                Background="{StaticResource AppBrushAccent}"
                                                Margin="0,0,8,0" />
                                        <TextBlock Text="Appearance" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0" />
                                    </StackPanel>
                                    <TextBlock Text="Theme" Style="{StaticResource SettingsLabelStyle}" />
                                    <ComboBox SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                              ItemsSource="{Binding ThemeOptions}"
                                              Margin="0,0,0,8"
                                              MinWidth="220"
                                              HorizontalAlignment="Left" />
                                    <TextBlock Text="Choose Light or Dark for the application interface."
                                               Style="{StaticResource SettingsHintStyle}" />
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource SettingsGuidePanelStyle}">
                            <StackPanel>
                                <TextBlock Text="Guide" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <Border Style="{StaticResource SettingsGuideItemStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Theme" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBlock Text="Theme changes apply after you click Save. The selected theme is stored in settings.json and restored on the next launch."
                                                   Style="{StaticResource SettingsHintStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            <!-- #endregion -->
            </Grid>
            <!-- #endregion -->
        </Grid>
        <!-- #endregion -->

        <!-- #region Save action bar -->
        <Border Grid.Row="2"
                Background="{StaticResource AppBrushSurface}"
                BorderBrush="{StaticResource AppBrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource SettingsPrimaryIconTextButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Save" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="Save Settings" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="12,7,0,0"
                           Foreground="{StaticResource AppBrushAccent}"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <!-- #endregion -->
    </Grid>
    <!-- #endregion -->
</UserControl>
