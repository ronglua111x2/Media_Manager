<UserControl x:Class="media_management_app.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />

                <TabControl Grid.Row="1">
                    <TabItem Header="Media Manager">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="State folder" FontWeight="SemiBold" />
                                <DockPanel Grid.Row="1" Margin="0,4,0,12" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseStateFolderCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding StateFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                </DockPanel>

                                <TextBlock Grid.Row="2" Text="Source folders" FontWeight="SemiBold" />
                                <Grid Grid.Row="3" Margin="0,4,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListBox Grid.Row="0"
                                             ItemsSource="{Binding SourceFolders}"
                                             SelectedItem="{Binding SelectedSourceFolder, Mode=TwoWay}"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Add Source Folder" Command="{Binding AddSourceFolderCommand}" />
                                        <Button Content="Remove Selected Source Folder" Command="{Binding RemoveSelectedSourceFolderCommand}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="4" Text="Generated library folder name" FontWeight="SemiBold" />
                                <TextBox Grid.Row="5" Text="{Binding DefaultLibraryFolderName, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Grid.Row="6" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="360" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="520" MinWidth="420" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="170" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Auto per-drive Jellyfin output roots" FontWeight="SemiBold" />
                                    <ListBox Grid.Row="1"
                                             Grid.Column="0"
                                             ItemsSource="{Binding LibraryRootPreview}"
                                             Margin="0,4,0,0"
                                             FontFamily="Consolas"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                                    <Border Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Grid.Column="2"
                                            Background="#f6f8fa"
                                            BorderBrush="#d0d7de"
                                            BorderThickness="1"
                                            Padding="14"
                                            Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="How multi-drive output works" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <TextBlock TextWrapping="Wrap"
                                                       Margin="0,0,0,8"
                                                       Text="Hardlinks only work when the source file and linked file are on the same drive. This app creates a Jellyfin library root on each source drive." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Margin="0,0,0,8"
                                                       Text="Example: files from D:\ go to D:\MediaManagerLibrary. Files from E:\ go to E:\MediaManagerLibrary." />
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="In Jellyfin, add every generated Shows path to one Shows library. Add every generated Movies path to one Movies library." />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="7" Text="TMDb API Read Access Token" FontWeight="SemiBold" />
                                <TextBox Grid.Row="8" Text="{Binding TmdbReadAccessToken, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Grid.Row="9" Orientation="Horizontal">
                                    <Button Content="Save Settings" Command="{Binding SaveCommand}" />
                                    <TextBlock Text="{Binding StatusMessage}" Margin="12,7,0,0" Foreground="#2f6f3e" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Auto Torrent">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="qBittorrent Web UI URL" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Text="{Binding QbittorrentWebUiUrl, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Text="Username" FontWeight="SemiBold" />
                                <TextBox Grid.Row="3" Text="{Binding QbittorrentUsername, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="4" Text="Password" FontWeight="SemiBold" />
                                <TextBox Grid.Row="5" Text="{Binding QbittorrentPassword, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="6" Text="Download folder" FontWeight="SemiBold" />
                                <DockPanel Grid.Row="7" Margin="0,4,0,12" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding BrowseAutoTorrentDownloadFolderCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding AutoTorrentDownloadFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                </DockPanel>

                                <TextBlock Grid.Row="8" Text="Download folder options" FontWeight="SemiBold" />
                                <Grid Grid.Row="9" Margin="0,4,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="110" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListBox Grid.Row="0"
                                             ItemsSource="{Binding AutoTorrentDownloadFolders}"
                                             SelectedItem="{Binding SelectedAutoTorrentDownloadFolder, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Add Download Folder" Command="{Binding AddAutoTorrentDownloadFolderCommand}" />
                                        <Button Content="Remove Selected" Command="{Binding RemoveSelectedAutoTorrentDownloadFolderCommand}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="10" Text="Category name" FontWeight="SemiBold" />
                                <TextBox Grid.Row="11" Text="{Binding AutoTorrentCategoryName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="12" Text="Candidates to keep per fetch" FontWeight="SemiBold" />
                                <TextBox Grid.Row="13" Text="{Binding AutoTorrentMaxCandidatesPerFetch, UpdateSourceTrigger=PropertyChanged}" ToolTip="1-10 candidates per episode or movie." />

                                <TextBlock Grid.Row="14" Text="Parallel searches" FontWeight="SemiBold" />
                                <TextBox Grid.Row="15"
                                         Text="{Binding AutoTorrentMaxParallelSearches, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="1-4 qBittorrent searches. qBittorrent allows 5 running searches; this app caps at 4 and defaults to 3." />

                                <StackPanel Grid.Row="16" Orientation="Horizontal">
                                    <Button Content="Test Connection" Command="{Binding TestQbittorrentConnectionCommand}" />
                                    <Button Content="Save Settings" Command="{Binding SaveCommand}" />
                                    <TextBlock Text="{Binding StatusMessage}" Margin="12,7,0,0" Foreground="#2f6f3e" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
</UserControl>
