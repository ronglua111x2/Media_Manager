                    </materialDesign:Card>
                    <materialDesign:Card Grid.Column="1"
                                        Style="{StaticResource PanelCardStyle}"
                                        Margin="6,0,0,12"
                                        VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconLucide Kind="TrendingDown" Style="{StaticResource SectionIconStyle}" />
                                    <TextBlock Text="Lowest episodes" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding ToggleBottomEpisodesPauseCommand}"
                                        Style="{StaticResource HallOfFamePauseButtonStyle}"
                                        IsEnabled="{Binding CanRotateBottomEpisodes}">
                                    <iconPacks:PackIconLucide Style="{StaticResource BottomEpisodesPauseIconStyle}" />
                                </Button>
                            </Grid>
                            <controls:StatsHallOfFameSlot ItemsSource="{Binding BottomEpisodes}"
