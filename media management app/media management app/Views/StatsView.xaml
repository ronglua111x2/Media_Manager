<UserControl x:Class="media_management_app.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:media_management_app.Converters"
             xmlns:controls="clr-namespace:media_management_app.Views.Controls"
             xmlns:views="clr-namespace:media_management_app.Views"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EpisodeRatingBandToBrushConverter x:Key="EpisodeRatingBandToBrushConverter" />

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="BandPieChartStyle" TargetType="lvc:PieChart">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="280" />
            <Setter Property="Height" Value="280" />
            <Setter Property="Margin" Value="12,12,28,12" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="LegendPosition" Value="Hidden" />
            <Setter Property="InitialRotation" Value="-90" />
            <Setter Property="TooltipPosition" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <Style x:Key="CaptionValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
        </Style>

        <Style x:Key="SectionIconStyle" TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
        </Style>

        <Style x:Key="HallOfFamePauseButtonStyle" TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Pause or resume list animation (this session only)" />
        </Style>

        <Style x:Key="StatsTocItemButtonStyle" TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <Style x:Key="HallOfFamePauseIconBaseStyle" TargetType="iconPacks:PackIconLucide">
            <Setter Property="Kind" Value="Pause" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
        </Style>

        <Style x:Key="TopEpisodesPauseIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource HallOfFamePauseIconBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTopEpisodesPaused}" Value="True">
                    <Setter Property="Kind" Value="Play" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BottomEpisodesPauseIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource HallOfFamePauseIconBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBottomEpisodesPaused}" Value="True">
                    <Setter Property="Kind" Value="Play" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TopSpecialsPauseIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource HallOfFamePauseIconBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTopSpecialsPaused}" Value="True">
                    <Setter Property="Kind" Value="Play" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BottomSpecialsPauseIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource HallOfFamePauseIconBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBottomSpecialsPaused}" Value="True">
                    <Setter Property="Kind" Value="Play" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PosterCardTemplate">
            <Button Command="{Binding DataContext.OpenRatedTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Padding="0"
                    Margin="0,0,10,10"
                    VerticalAlignment="Top"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="{Binding Title}">
                <StackPanel Width="92">
                    <Border Width="84"
                            Height="126"
                            CornerRadius="6"
                            ClipToBounds="True"
                            HorizontalAlignment="Left"
                            Background="{StaticResource AppBrushCanvas}">
                        <Image Source="{Binding PosterImage}"
                               Width="84"
                               Height="126"
                               Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left">
                        <iconPacks:PackIconLucide Kind="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToLucideKindConverter}}"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  Foreground="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToBrushConverter}}"
                                                  ToolTip="{Binding WatchStatusLabel}"
                                                  Visibility="{Binding HasWatchStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Width="52"
                                Height="22"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <iconPacks:PackIconLucide Kind="Star"
                                                          Width="10"
                                                          Height="10"
                                                          Margin="0,0,3,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushOnAccent}" />
                                <TextBlock Text="{Binding RatingText}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AppBrushOnAccent}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource AppBrushText}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="BestHallOfFameTemplate">
            <Grid Height="44">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding ShowTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppBrushText}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding EpisodeLine}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <iconPacks:PackIconLucide Kind="Star"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource AppBrushWarning}" />
                        <TextBlock Text="{Binding UserRating, StringFormat=0.0}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AppBrushWarning}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="—"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AppBrushMutedText}"
                           Opacity="0.45">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Height="1"
                        VerticalAlignment="Bottom"
                        Opacity="0.22"
                        Background="{StaticResource AppBrushMutedText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LowestHallOfFameTemplate">
            <Grid Height="44">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding ShowTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppBrushText}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding EpisodeLine}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Grid.Column="1"
                               Text="{Binding UserRating, StringFormat=0.0}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="{StaticResource AppBrushMutedText}" />
                </Grid>
                <TextBlock Text="—"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AppBrushMutedText}"
                           Opacity="0.45">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border Height="1"
                        VerticalAlignment="Bottom"
                        Opacity="0.22"
                        Background="{StaticResource AppBrushMutedText}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <TextBlock Text="No media in library. Use Find/Add to add shows or movies."
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLibrary}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer x:Name="StatsScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLibrary}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel x:Name="StatsScrollContent">
                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    views:StatsToc.Title="Stats">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="ChartColumn" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Stats" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding RefreshOverviewCommand}"
                                Style="{StaticResource AppOutlinedButtonStyle}"
                                MinHeight="36"
                                Padding="12,8"
                                ToolTip="Rebuild library stats">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="RefreshCw"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    views:StatsToc.Title="Billboard"
                                    Visibility="{Binding HasBillboard, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="GalleryHorizontalEnd" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Billboard" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleBillboardPauseCommand}"
                                    Style="{StaticResource HallOfFamePauseButtonStyle}"
                                    ToolTip="Pause or resume billboard animation (this session only)">
                                <iconPacks:PackIconLucide Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushMutedText}">
                                    <iconPacks:PackIconLucide.Style>
                                        <Style TargetType="iconPacks:PackIconLucide">
                                            <Setter Property="Kind" Value="Pause" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBillboardPaused}" Value="True">
                                                    <Setter Property="Kind" Value="Play" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconLucide.Style>
                                </iconPacks:PackIconLucide>
                            </Button>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0"
                                        Visibility="{Binding HasHighlightSlot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Highest rated"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,8" />
                                <controls:StatsBillboardSlot x:Name="HighlightBillboard"
                                                             ItemsSource="{Binding BillboardHighlights}"
                                                             IsPaused="{Binding IsBillboardPaused}"
                                                             IsActive="{Binding IsBillboardActive}"
                                                             Interval="0:0:8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Visibility="{Binding HasRandomSlot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Random"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,8" />
                                <controls:StatsBillboardSlot ItemsSource="{Binding BillboardRandom}"
                                                             IsPaused="{Binding IsBillboardPaused}"
                                                             IsActive="{Binding IsBillboardActive}"
                                                             Interval="0:0:11"
                                                             StartDelay="0:0:4"
                                                             ExcludeIdentity="{Binding CurrentIdentity, ElementName=HighlightBillboard}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    views:StatsToc.Title="Watch status"
                                    Visibility="{Binding HasWatchStatusStats, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconLucide Kind="TvMinimalPlay" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Watch status" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding WatchStatusStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,20,8" MinWidth="140">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="{Binding Status, Converter={StaticResource UserWatchStatusToLucideKindConverter}}"
                                                                      Width="14"
                                                                      Height="14"
                                                                      Margin="0,0,6,0"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{Binding Status, Converter={StaticResource UserWatchStatusToBrushConverter}}" />
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Status, Converter={StaticResource UserWatchStatusToBrushConverter}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SplitText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="20,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,24,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Tv"
                                                          Width="16"
                                                          Height="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushMutedText}" />
                                <TextBlock Text="{Binding ShowCountText}" Style="{StaticResource CaptionValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RatedShowText}" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Film"
                                                          Width="16"
                                                          Height="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushMutedText}" />
                                <TextBlock Text="{Binding MovieCountText}" Style="{StaticResource CaptionValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RatedMovieText}" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Star"
                                                          Width="16"
                                                          Height="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushWarning}" />
                                <TextBlock Text="{Binding MeanShowText}" Style="{StaticResource CaptionValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="Mean show score" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Clapperboard"
                                                          Width="16"
                                                          Height="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushWarning}" />
                                <TextBlock Text="{Binding MeanMovieText}" Style="{StaticResource CaptionValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="Mean movie score" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ChartColumn"
                                                          Width="16"
                                                          Height="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushMutedText}" />
                                <TextBlock Text="{Binding MeanEpisodeText}" Style="{StaticResource CaptionValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="Mean episode score" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding RatedEpisodeText}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    views:StatsToc.Title="Title / Episode bands"
                                    ClipContent="False"
                                    ClipToBounds="False">
                    <Grid ClipToBounds="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,12,0" ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ChartPie" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Title bands" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,10,0,0" ClipToBounds="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <lvc:PieChart Style="{StaticResource BandPieChartStyle}"
                                              Series="{Binding TitleBandPieSeries}"
                                              Visibility="{Binding HasTitleBandPie, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{Binding TitleBands}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Width="12"
                                                        Height="12"
                                                        CornerRadius="2"
                                                        Margin="0,0,8,0"
                                                        Background="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}" />
                                                <TextBlock Text="{Binding Label}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Width="90" />
                                                <TextBlock Text="{Binding Count}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AppBrushText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="1" ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ChartPie" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Episode bands" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,10,0,0" ClipToBounds="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <lvc:PieChart Style="{StaticResource BandPieChartStyle}"
                                              Series="{Binding EpisodeBandPieSeries}"
                                              Visibility="{Binding HasEpisodeBandPie, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{Binding EpisodeBands}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Width="12"
                                                        Height="12"
                                                        CornerRadius="2"
                                                        Margin="0,0,8,0"
                                                        Background="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}" />
                                                <TextBlock Text="{Binding Label}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Width="90" />
                                                <TextBlock Text="{Binding Count}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AppBrushText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <Grid views:StatsToc.Title="Best / Lowest episodes">
