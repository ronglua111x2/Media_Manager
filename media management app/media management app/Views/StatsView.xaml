<UserControl x:Class="media_management_app.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:media_management_app.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EpisodeRatingBandToBrushConverter x:Key="EpisodeRatingBandToBrushConverter" />

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="BandPieChartStyle" TargetType="lvc:PieChart">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="160" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="LegendPosition" Value="Hidden" />
            <Setter Property="InitialRotation" Value="-90" />
            <Setter Property="TooltipPosition" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>

        <Style x:Key="CaptionValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
        </Style>

        <Style x:Key="SectionIconStyle" TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
        </Style>

        <Style x:Key="HeatmapCellButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <TextBlock Text="{Binding ScoreText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AppBrushOnAccent}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeatmapExtraCellButtonStyle" TargetType="Button" BasedOn="{StaticResource HeatmapCellButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="24" />
        </Style>

        <DataTemplate x:Key="PosterCardTemplate">
            <Button Command="{Binding DataContext.OpenRatedTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Padding="0"
                    Margin="0,0,10,10"
                    VerticalAlignment="Top"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="{Binding Title}">
                <StackPanel Width="92">
                    <Border Width="84"
                            Height="126"
                            CornerRadius="6"
                            ClipToBounds="True"
                            HorizontalAlignment="Left"
                            Background="{StaticResource AppBrushCanvas}">
                        <Image Source="{Binding PosterImage}"
                               Width="84"
                               Height="126"
                               Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left">
                        <iconPacks:PackIconLucide Kind="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToLucideKindConverter}}"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  Foreground="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToBrushConverter}}"
                                                  ToolTip="{Binding WatchStatusLabel}"
                                                  Visibility="{Binding HasWatchStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Width="52"
                                Height="22"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <iconPacks:PackIconLucide Kind="Star"
                                                          Width="10"
                                                          Height="10"
                                                          Margin="0,0,3,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushOnAccent}" />
                                <TextBlock Text="{Binding RatingText}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AppBrushOnAccent}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource AppBrushText}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="BestHallOfFameTemplate">
            <Button Command="{Binding DataContext.OpenHallOfFameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,4"
                    HorizontalContentAlignment="Stretch"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ShowTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppBrushText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MutedTextStyle}">
                            <Run Text="{Binding EpisodeCode, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding EpisodeTitle, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <iconPacks:PackIconLucide Kind="Star"
                                                  Width="14"
                                                  Height="14"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource AppBrushWarning}" />
                        <TextBlock Text="{Binding UserRating, StringFormat=0.0}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AppBrushWarning}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="LowestHallOfFameTemplate">
            <Button Command="{Binding DataContext.OpenHallOfFameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,4"
                    HorizontalContentAlignment="Stretch"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ShowTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppBrushText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MutedTextStyle}">
                            <Run Text="{Binding EpisodeCode, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding EpisodeTitle, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding UserRating, StringFormat=0.0}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource AppBrushMutedText}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <TextBlock Text="No media in library. Use Find/Add to add shows or movies."
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLibrary}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLibrary}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <materialDesign:Card Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="ChartColumn" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Stats" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding RefreshOverviewCommand}"
                                Style="{StaticResource AppOutlinedButtonStyle}"
                                MinHeight="36"
                                Padding="12,8"
                                ToolTip="Rebuild library stats">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="RefreshCw"
                                                          Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    Visibility="{Binding HasWatchStatusStats, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconLucide Kind="TvMinimalPlay" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Watch status" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding WatchStatusStats}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,20,8" MinWidth="140">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="{Binding Status, Converter={StaticResource UserWatchStatusToLucideKindConverter}}"
                                                                      Width="14"
                                                                      Height="14"
                                                                      Margin="0,0,6,0"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{Binding Status, Converter={StaticResource UserWatchStatusToBrushConverter}}" />
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Status, Converter={StaticResource UserWatchStatusToBrushConverter}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SplitText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="20,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}">
                    <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,24,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Tv"
                                                          Width="16"
                                                          Height="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushMutedText}" />
                                <TextBlock Text="{Binding ShowCountText}" Style="{StaticResource CaptionValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RatedShowText}" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Film"
                                                          Width="16"
                                                          Height="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushMutedText}" />
                                <TextBlock Text="{Binding MovieCountText}" Style="{StaticResource CaptionValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding RatedMovieText}" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Star"
                                                          Width="16"
                                                          Height="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushWarning}" />
                                <TextBlock Text="{Binding MeanShowText}" Style="{StaticResource CaptionValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="Mean show score" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Clapperboard"
                                                          Width="16"
                                                          Height="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushWarning}" />
                                <TextBlock Text="{Binding MeanMovieText}" Style="{StaticResource CaptionValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="Mean movie score" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ChartColumn"
                                                          Width="16"
                                                          Height="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushMutedText}" />
                                <TextBlock Text="{Binding MeanEpisodeText}" Style="{StaticResource CaptionValueStyle}" />
                            </StackPanel>
                            <TextBlock Text="Mean episode score" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding RatedEpisodeText}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,4,0,0" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ChartPie" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Title bands" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <lvc:PieChart Style="{StaticResource BandPieChartStyle}"
                                              Series="{Binding TitleBandPieSeries}"
                                              Visibility="{Binding HasTitleBandPie, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{Binding TitleBands}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Width="12"
                                                        Height="12"
                                                        CornerRadius="2"
                                                        Margin="0,0,8,0"
                                                        Background="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}" />
                                                <TextBlock Text="{Binding Label}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Width="90" />
                                                <TextBlock Text="{Binding Count}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AppBrushText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ChartPie" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Episode bands" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <lvc:PieChart Style="{StaticResource BandPieChartStyle}"
                                              Series="{Binding EpisodeBandPieSeries}"
                                              Visibility="{Binding HasEpisodeBandPie, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{Binding EpisodeBands}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Width="12"
                                                        Height="12"
                                                        CornerRadius="2"
                                                        Margin="0,0,8,0"
                                                        Background="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}" />
                                                <TextBlock Text="{Binding Label}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Width="90" />
                                                <TextBlock Text="{Binding Count}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AppBrushText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    Visibility="{Binding HasMovieStrip, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Film" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Movies" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UnratedMovieCaption}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding RatedMovies}"
                                      ItemTemplate="{StaticResource PosterCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    Visibility="{Binding HasShowStrip, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Tv" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Shows" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UnratedShowCaption}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding RatedShows}"
                                      ItemTemplate="{StaticResource PosterCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    Visibility="{Binding HasHeatmapRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="LayoutGrid" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Episode heatmap" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <TextBlock Text="Rated counts are Season 1 onward only. Specials and extras are excluded."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding TitleBandLegend}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                        <Border Width="12"
                                                Height="12"
                                                CornerRadius="2"
                                                Margin="0,0,4,0"
                                                Background="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding HeatmapRows}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="148" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.OpenShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding ShowId}"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                ToolTip="{Binding Title}">
                                            <Border Width="44"
                                                    Height="66"
                                                    CornerRadius="4"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource AppBrushCanvas}">
                                                <Image Source="{Binding PosterImage}"
                                                       Width="44"
                                                       Height="66"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                        </Button>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                                            <Button Command="{Binding DataContext.OpenShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding ShowId}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Left"
                                                    Cursor="Hand">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AppBrushText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <iconPacks:PackIconLucide Kind="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToLucideKindConverter}}"
                                                                          Width="14"
                                                                          Height="14"
                                                                          Margin="0,0,4,0"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToBrushConverter}}"
                                                                          ToolTip="{Binding WatchStatusLabel}"
                                                                          Visibility="{Binding HasWatchStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Border Width="36"
                                                        Height="22"
                                                        CornerRadius="4"
                                                        Background="{Binding ShowBand, Converter={StaticResource EpisodeRatingBandToBrushConverter}}">
                                                    <TextBlock Text="{Binding ShowRatingText}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource AppBrushOnAccent}" />
                                                </Border>
                                                <TextBlock Text="{Binding CoverageText}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ScrollViewer Grid.Column="2"
                                                      VerticalAlignment="Center"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      PreviewMouseWheel="HeatmapRowScroller_OnPreviewMouseWheel">
                                            <StackPanel Orientation="Horizontal">
                                                <ItemsControl ItemsSource="{Binding Seasons}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Label}"
                                                                           Style="{StaticResource MutedTextStyle}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"
                                                                           FontSize="11" />
                                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource HeatmapCellButtonStyle}"
                                                                                    Command="{Binding DataContext.OpenHeatmapCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    ToolTip="{Binding Label}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Width="1"
                                                        Height="28"
                                                        Margin="2,0,10,0"
                                                        VerticalAlignment="Center"
                                                        Background="{StaticResource AppBrushBorder}"
                                                        Visibility="{Binding HasSeasonDivider, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <ItemsControl ItemsSource="{Binding ExtraSeasons}"
                                                              Visibility="{Binding HasExtraSeasons, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Label}"
                                                                           Style="{StaticResource MutedTextStyle}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"
                                                                           FontSize="11" />
                                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Style="{StaticResource HeatmapExtraCellButtonStyle}"
                                                                                    Command="{Binding DataContext.OpenHeatmapCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    ToolTip="{Binding Label}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:Card Grid.Column="0"
                                        Style="{StaticResource PanelCardStyle}"
                                        Margin="0,0,6,12"
                                        Visibility="{Binding HasTopEpisodes, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Trophy" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Best episodes" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding TopEpisodes}"
                                          ItemTemplate="{StaticResource BestHallOfFameTemplate}"
                                          Margin="0,8,0,0" />
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Grid.Column="1"
                                        Style="{StaticResource PanelCardStyle}"
                                        Margin="6,0,0,12"
                                        Visibility="{Binding HasBottomEpisodes, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="TrendingDown" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Lowest episodes" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding BottomEpisodes}"
                                          ItemTemplate="{StaticResource LowestHallOfFameTemplate}"
                                          Margin="0,8,0,0" />
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    Visibility="{Binding HasMismatches, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="TrendingUpDown" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Show score vs episode mean" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <TextBlock Text="Shows with a title score and at least 3 episode scores."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding Mismatches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenMismatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0,4"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AppBrushText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource MutedTextStyle}">
                                                    <Run Text="Show " />
                                                    <Run Text="{Binding ShowRating, Mode=OneWay, StringFormat=0.0}" />
                                                    <Run Text=" · Episodes " />
                                                    <Run Text="{Binding EpisodeMean, Mode=OneWay, StringFormat=0.0}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DeltaText}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppBrushText}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:Card Grid.Column="0"
                                        Style="{StaticResource PanelCardStyle}"
                                        Margin="0,0,6,12"
                                        Visibility="{Binding HasTopSpecials, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Sparkles" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Best specials" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding TopSpecials}"
                                          ItemTemplate="{StaticResource BestHallOfFameTemplate}"
                                          Margin="0,8,0,0" />
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Grid.Column="1"
                                        Style="{StaticResource PanelCardStyle}"
                                        Margin="6,0,0,12"
                                        Visibility="{Binding HasBottomSpecials, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="StarOff" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Lowest specials" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding BottomSpecials}"
                                          ItemTemplate="{StaticResource LowestHallOfFameTemplate}"
                                          Margin="0,8,0,0" />
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    Visibility="{Binding HasEmptyOpinions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="CircleAlert" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Empty opinions" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding EmptyOpinions}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenEmptyOpinionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0,4"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppBrushText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
