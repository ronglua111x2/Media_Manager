                </Grid>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    views:StatsToc.Title="Movies"
                                    Visibility="{Binding HasMovieStrip, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Film" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Movies" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding MovieStrip.ToggleExpandCommand}"
                                    Width="28"
                                    MinWidth="28"
                                    Height="28"
                                    MinHeight="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding MovieStrip.CanExpand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
                                        <Setter Property="ToolTip" Value="Expand" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MovieStrip.IsExpanded}" Value="True">
                                                <Setter Property="ToolTip" Value="Collapse" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <iconPacks:PackIconLucide Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushMutedText}">
                                    <iconPacks:PackIconLucide.Style>
                                        <Style TargetType="iconPacks:PackIconLucide">
                                            <Setter Property="Kind" Value="ChevronDown" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MovieStrip.IsExpanded}" Value="True">
                                                    <Setter Property="Kind" Value="ChevronUp" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconLucide.Style>
                                </iconPacks:PackIconLucide>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding UnratedMovieCaption}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding MovieStrip.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Width="120"
                                         Height="4"
                                         IsIndeterminate="True"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0" />
                            <TextBlock Text="Loading posters…"
                                       Style="{StaticResource MutedTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:StatsPosterStrip DataContext="{Binding MovieStrip}" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    views:StatsToc.Title="Shows"
                                    Visibility="{Binding HasShowStrip, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Tv" Style="{StaticResource SectionIconStyle}" />
                                <TextBlock Text="Shows" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding ShowStrip.ToggleExpandCommand}"
                                    Width="28"
                                    MinWidth="28"
                                    Height="28"
                                    MinHeight="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowStrip.CanExpand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
                                        <Setter Property="ToolTip" Value="Expand" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowStrip.IsExpanded}" Value="True">
                                                <Setter Property="ToolTip" Value="Collapse" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <iconPacks:PackIconLucide Width="14"
                                                          Height="14"
                                                          VerticalAlignment="Center"
                                                          Foreground="{StaticResource AppBrushMutedText}">
                                    <iconPacks:PackIconLucide.Style>
                                        <Style TargetType="iconPacks:PackIconLucide">
                                            <Setter Property="Kind" Value="ChevronDown" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowStrip.IsExpanded}" Value="True">
                                                    <Setter Property="Kind" Value="ChevronUp" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconLucide.Style>
                                </iconPacks:PackIconLucide>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding UnratedShowCaption}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding ShowStrip.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Width="120"
                                         Height="4"
                                         IsIndeterminate="True"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0" />
                            <TextBlock Text="Loading posters…"
                                       Style="{StaticResource MutedTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <controls:StatsPosterStrip DataContext="{Binding ShowStrip}" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    views:StatsToc.Title="Episode heatmap"
                                    Visibility="{Binding HasHeatmapRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="LayoutGrid" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Episode heatmap" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <TextBlock Text="Rated counts are Season 1 onward only. Specials and extras are excluded."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding TitleBandLegend}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                        <Border Width="12"
                                                Height="12"
                                                CornerRadius="2"
                                                Margin="0,0,4,0"
                                                Background="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding HeatmapRows}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            CornerRadius="8"
                                            Background="{StaticResource AppBrushSurface}"
                                            BorderBrush="{StaticResource AppBrushBorderStrong}"
                                            BorderThickness="1">
                                        <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button VerticalAlignment="Top"
                                                    Command="{Binding DataContext.OpenShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding ShowId}"
                                                    Padding="0"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding Title}">
                                                <Border Width="44"
                                                        Height="66"
                                                        CornerRadius="4"
                                                        ClipToBounds="True"
                                                        Background="{StaticResource AppBrushCanvas}">
                                                    <Image Source="{Binding PosterImage}"
                                                           Width="44"
                                                           Height="66"
                                                           Stretch="UniformToFill" />
                                                </Border>
                                            </Button>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,0,0,0">
                                                <Button Command="{Binding DataContext.OpenShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding ShowId}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Cursor="Hand">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AppBrushText}"
                                                               TextWrapping="Wrap" />
                                                </Button>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <iconPacks:PackIconLucide Kind="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToLucideKindConverter}}"
                                                                              Width="14"
                                                                              Height="14"
                                                                              Margin="0,0,4,0"
                                                                              VerticalAlignment="Center"
                                                                              Foreground="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToBrushConverter}}"
                                                                              ToolTip="{Binding WatchStatusLabel}"
                                                                              Visibility="{Binding HasWatchStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Border Width="36"
                                                            Height="22"
                                                            CornerRadius="4"
                                                            Background="{Binding ShowBand, Converter={StaticResource EpisodeRatingBandToBrushConverter}}">
                                                        <TextBlock Text="{Binding ShowRatingText}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource AppBrushOnAccent}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding CoverageText}"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0" />
                                                    <Button Command="{Binding ToggleExpandCommand}"
                                                            Width="28"
                                                            MinWidth="28"
                                                            Height="28"
                                                            MinHeight="28"
                                                            Padding="0"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding CanExpand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
                                                                <Setter Property="ToolTip" Value="Expand" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="ToolTip" Value="Collapse" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <iconPacks:PackIconLucide Width="14"
                                                                                  Height="14"
                                                                                  VerticalAlignment="Center"
                                                                                  Foreground="{StaticResource AppBrushMutedText}">
                                                            <iconPacks:PackIconLucide.Style>
                                                                <Style TargetType="iconPacks:PackIconLucide">
                                                                    <Setter Property="Kind" Value="ChevronDown" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Kind" Value="ChevronUp" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </iconPacks:PackIconLucide.Style>
                                                        </iconPacks:PackIconLucide>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding IsHeatmapLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ProgressBar Width="120"
                                                         Height="4"
                                                         IsIndeterminate="True"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0" />
                                            <TextBlock Text="Loading episodes…"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasPreviewSeason}" Value="True" />
                                                                <Condition Binding="{Binding IsExpanded}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PreviewSeason.Label}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,6,8,0"
                                                       FontSize="11" />
                                            <controls:StatsHeatmapSeasonStrip Grid.Column="1"
                                                                              Cells="{Binding PreviewSeason.Cells}"
                                                                              IsPreview="True"
                                                                              IsExtra="{Binding PreviewIsExtra}"
                                                                              IsTruncated="{Binding IsPreviewTruncated, Mode=TwoWay}" />
                                        </Grid>
                                        <ContentControl Margin="0,10,0,0">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Content" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRealizedExpanded}" Value="True">
                                                            <Setter Property="Content" Value="{Binding}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Seasons}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       VerticalAlignment="Top"
                                                                       Margin="0,6,8,0"
                                                                       FontSize="11" />
                                                            <controls:StatsHeatmapSeasonStrip Grid.Column="1"
                                                                                              Cells="{Binding Cells}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Height="1"
                                                    Margin="0,4,0,8"
                                                    Background="{StaticResource AppBrushBorder}"
                                                    Visibility="{Binding HasSeasonDivider, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ItemsControl ItemsSource="{Binding ExtraSeasons}"
                                                          Visibility="{Binding HasExtraSeasons, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       VerticalAlignment="Top"
                                                                       Margin="0,6,8,0"
                                                                       FontSize="11" />
                                                            <controls:StatsHeatmapSeasonStrip Grid.Column="1"
                                                                                              Cells="{Binding Cells}"
                                                                                              IsExtra="True" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    views:StatsToc.Title="Show score vs episode mean"
                                    Visibility="{Binding HasMismatches, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="TrendingUpDown" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Show score vs episode mean" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <TextBlock Text="Shows with a title score and at least 3 episode scores."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding Mismatches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenMismatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0,4"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AppBrushText}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource MutedTextStyle}">
                                                    <Run Text="Show " />
                                                    <Run Text="{Binding ShowRating, Mode=OneWay, StringFormat=0.0}" />
                                                    <Run Text=" · Episodes " />
                                                    <Run Text="{Binding EpisodeMean, Mode=OneWay, StringFormat=0.0}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DeltaText}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppBrushText}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <Grid views:StatsToc.Title="Best / Lowest specials">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:Card Grid.Column="0"
                                        Style="{StaticResource PanelCardStyle}"
                                        Margin="0,0,6,12"
                                        VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconLucide Kind="Sparkles" Style="{StaticResource SectionIconStyle}" />
                                    <TextBlock Text="Best specials" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding ToggleTopSpecialsPauseCommand}"
                                        Style="{StaticResource HallOfFamePauseButtonStyle}"
                                        IsEnabled="{Binding CanRotateTopSpecials}">
                                    <iconPacks:PackIconLucide Style="{StaticResource TopSpecialsPauseIconStyle}" />
                                </Button>
                            </Grid>
                            <controls:StatsHallOfFameSlot ItemsSource="{Binding TopSpecials}"
                                                           ItemTemplate="{StaticResource BestHallOfFameTemplate}"
                                                           CanAnimate="{Binding CanRotateTopSpecials}"
                                                           Margin="0,8,0,0" />
                        </StackPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Grid.Column="1"
                                        Style="{StaticResource PanelCardStyle}"
                                        Margin="6,0,0,12"
                                        VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <iconPacks:PackIconLucide Kind="StarOff" Style="{StaticResource SectionIconStyle}" />
                                    <TextBlock Text="Lowest specials" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding ToggleBottomSpecialsPauseCommand}"
                                        Style="{StaticResource HallOfFamePauseButtonStyle}"
                                        IsEnabled="{Binding CanRotateBottomSpecials}">
                                    <iconPacks:PackIconLucide Style="{StaticResource BottomSpecialsPauseIconStyle}" />
                                </Button>
                            </Grid>
                            <controls:StatsHallOfFameSlot ItemsSource="{Binding BottomSpecials}"
                                                           ItemTemplate="{StaticResource LowestHallOfFameTemplate}"
                                                           CanAnimate="{Binding CanRotateBottomSpecials}"
                                                           Margin="0,8,0,0" />
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <materialDesign:Card Style="{StaticResource PanelCardStyle}"
                                    views:StatsToc.Title="Empty opinions"
                                    Visibility="{Binding HasEmptyOpinions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="CircleAlert" Style="{StaticResource SectionIconStyle}" />
                            <TextBlock Text="Empty opinions" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding EmptyOpinions}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenEmptyOpinionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0,4"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppBrushText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="JumpToSectionButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Padding="0"
                ToolTip="Jump to section"
                Click="JumpToSectionButton_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource HallOfFamePauseButtonStyle}">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="MinWidth" Value="36" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLibrary}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <iconPacks:PackIconLucide Kind="ChevronsUpDown"
                                      Width="16"
                                      Height="16"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource AppBrushMutedText}" />
        </Button>
        <Popup x:Name="TocPopup"
               PlacementTarget="{Binding ElementName=JumpToSectionButton}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               VerticalOffset="-8">
            <Border Background="{StaticResource AppBrushSurfaceRaised}"
                    BorderBrush="{StaticResource AppBrushMutedText}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6"
                    MinWidth="220"
                    MaxHeight="360">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TocList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}"
                                        Tag="{Binding Target}"
                                        Style="{StaticResource StatsTocItemButtonStyle}"
                                        Click="TocItem_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
