<UserControl x:Class="media_management_app.Views.AutoTorrentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- #region Local resources -->
    <UserControl.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#dbe3ee" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563eb" />
            <Setter Property="BorderBrush" Value="#1d4ed8" />
            <Setter Property="Foreground" Value="#ffffff" />
        </Style>
    </UserControl.Resources>
    <!-- #endregion -->

    <!-- #region Auto Torrent workspace -->
    <Grid Background="#f8fafc" Margin="0">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- #region Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding StatusMessage}"
                           Foreground="#475569"
                           VerticalAlignment="Bottom"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel>
                    <TextBlock Text="Auto Torrent" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Recipe-driven qBittorrent fetching for tracked shows and movies." Foreground="#64748b" />
                </StackPanel>
            </DockPanel>
            <!-- #endregion -->

            <!-- #region Auto Torrent tabs -->
            <TabControl Grid.Row="1">
                <!-- #region Dashboard tab -->
                <TabItem Header="Dashboard">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="210" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Add tracked show" Style="{StaticResource SectionLabel}" />
                                <DockPanel Grid.Row="1" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Command="{Binding AddSelectedShowCommand}" Content="Add" />
                                    <Button DockPanel.Dock="Right" Command="{Binding SearchShowsCommand}" Content="Search TMDB" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
                                    <TextBox Text="{Binding ShowSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                </DockPanel>
                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding ShowSearchResults}"
                                          SelectedItem="{Binding SelectedShowSearchResult, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Title" Binding="{Binding DisplayTitle}" Width="220" />
                                        <DataGridTextColumn Header="Episodes" Binding="{Binding EpisodeCount}" Width="85" />
                                        <DataGridTextColumn Header="Overview" Binding="{Binding Overview}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Add tracked movie" Style="{StaticResource SectionLabel}" />
                                <DockPanel Grid.Row="1" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Command="{Binding AddSelectedMovieCommand}" Content="Add" />
                                    <Button DockPanel.Dock="Right" Command="{Binding SearchMoviesCommand}" Content="Search TMDB" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
                                    <TextBox Text="{Binding MovieSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                </DockPanel>
                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding MovieSearchResults}"
                                          SelectedItem="{Binding SelectedMovieSearchResult, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Title" Binding="{Binding DisplayTitle}" Width="220" />
                                        <DataGridTextColumn Header="Overview" Binding="{Binding Overview}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Tracked shows" Style="{StaticResource SectionLabel}" />
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding ShowCards}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              Margin="0,8,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Show" Binding="{Binding Title}" Width="220" />
                                            <DataGridTextColumn Header="State" Binding="{Binding Stats}" Width="*" />
                                            <DataGridTextColumn Header="Recipe defaults" Binding="{Binding PreferencesSummary}" Width="260" />
                                            <DataGridTemplateColumn Header="Run" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.FetchWantedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Run Now" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Tracked movies" Style="{StaticResource SectionLabel}" />
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding MovieCards}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              Margin="0,8,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Movie" Binding="{Binding Title}" Width="220" />
                                            <DataGridTextColumn Header="State" Binding="{Binding Stats}" Width="*" />
                                            <DataGridTemplateColumn Header="Run" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.FetchMovieWantedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Content="Run Now" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- #endregion -->

                <!-- #region Recipes tab -->
                <TabItem Header="Recipes">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                    <Button Command="{Binding CreateRecipeCommand}" Content="New Recipe" />
                                    <Button Command="{Binding DuplicateRecipeCommand}" Content="Duplicate" />
                                    <Button Command="{Binding DeleteRecipeCommand}" Content="Delete" />
                                    <Button Command="{Binding ImportRecipeCommand}" Content="Import .rcp" />
                                    <Button Command="{Binding ExportRecipeCommand}" Content="Export .rcp" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Recipes" Style="{StaticResource SectionLabel}" />
                                    <ListBox ItemsSource="{Binding Recipes}"
                                             SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                                             DisplayMemberPath="Name"
                                             MinHeight="420" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="180" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Recipe name" Style="{StaticResource SectionLabel}" />
                                        <TextBox Text="{Binding SelectedRecipe.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Target" Style="{StaticResource SectionLabel}" />
                                        <TextBox Text="{Binding SelectedRecipe.TargetKind}" IsReadOnly="True" />
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding SelectedRecipe.Modules}"
                                          SelectedItem="{Binding SelectedRecipeModule, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          Margin="0,12,0,0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                        <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="70" />
                                        <DataGridTextColumn Header="Module" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="170" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding BlockType}" IsReadOnly="True" Width="160" />
                                        <DataGridTextColumn Header="Schema" Binding="{Binding SchemaVersion}" Width="70" />
                                        <DataGridTextColumn Header="Stable ID" Binding="{Binding ModuleId}" IsReadOnly="True" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,8">
                                    <Button Command="{Binding MoveSelectedRecipeModuleUpCommand}" Content="Move Up" />
                                    <Button Command="{Binding MoveSelectedRecipeModuleDownCommand}" Content="Move Down" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Query templates" Style="{StaticResource SectionLabel}" />
                                            <ListBox ItemsSource="{Binding SelectedRecipeModule.QueryTemplates}" MinHeight="105" />
                                            <TextBlock Text="Aliases" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                                            <ListBox ItemsSource="{Binding SelectedRecipeModule.Aliases}" MinHeight="90" />
                                            <TextBlock Text="Quality allowlist" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                                            <ListBox ItemsSource="{Binding SelectedRecipeModule.QualityAllowList}" MinHeight="90" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Minimum seeders" Style="{StaticResource SectionLabel}" />
                                            <TextBox Text="{Binding SelectedRecipeModule.MinimumSeeders, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Preferred audio" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                                            <TextBox Text="{Binding SelectedRecipeModule.PreferredAudioCodec, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Search plugins" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                                            <TextBox Text="{Binding SelectedRecipeModule.Plugins, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Torrent category" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                                            <TextBox Text="{Binding SelectedRecipeModule.TorrentCategory, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Save path" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                                            <TextBox Text="{Binding SelectedRecipeModule.SavePath, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>

                                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Command="{Binding SaveRecipeCommand}" Content="Save Recipe" Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- #endregion -->

                <!-- #region Test Lab tab -->
                <TabItem Header="Test Lab">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="150" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource PanelBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tracked show" Style="{StaticResource SectionLabel}" />
                                    <ComboBox ItemsSource="{Binding ShowCards}"
                                              SelectedItem="{Binding SelectedTestShow, Mode=TwoWay}"
                                              DisplayMemberPath="Title" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tracked movie" Style="{StaticResource SectionLabel}" />
                                    <ComboBox ItemsSource="{Binding MovieCards}"
                                              SelectedItem="{Binding SelectedTestMovie, Mode=TwoWay}"
                                              DisplayMemberPath="Title" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Recipe" Style="{StaticResource SectionLabel}" />
                                    <ComboBox ItemsSource="{Binding Recipes}"
                                              SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding DryRunSelectedShowCommand}" Content="Dry Run Show" />
                                <Button Grid.Column="1" Command="{Binding RunNowSelectedShowCommand}" Content="Run Show Now" Style="{StaticResource PrimaryButton}" />
                                <Button Grid.Column="2" Command="{Binding DryRunSelectedMovieCommand}" Content="Dry Run Movie" />
                                <Button Grid.Column="3" Command="{Binding RunNowSelectedMovieCommand}" Content="Run Movie Now" Style="{StaticResource PrimaryButton}" />
                                <TextBlock Grid.Column="4"
                                           Text="{Binding TestLabResult.Summary}"
                                           Foreground="#475569"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Generated queries" Style="{StaticResource SectionLabel}" />
                                    <ListBox ItemsSource="{Binding TestQueries}" FontFamily="Consolas" />
                                </DockPanel>
                            </Border>
                            <TabControl Grid.Column="2">
                                <TabItem Header="Accepted">
                                    <DataGrid ItemsSource="{Binding TestAcceptedCandidates}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Candidate" Binding="{Binding SearchResult.FileName}" Width="*" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding SearchResult.FileSizeDisplay}" Width="95" />
                                            <DataGridTextColumn Header="Seeders" Binding="{Binding SearchResult.Seeders}" Width="80" />
                                            <DataGridTextColumn Header="Score" Binding="{Binding TotalScore}" Width="90" />
                                            <DataGridTextColumn Header="Plugin" Binding="{Binding SearchResult.EngineName}" Width="130" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Rejected">
                                    <DataGrid ItemsSource="{Binding TestRejectedCandidates}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Candidate" Binding="{Binding SearchResult.FileName}" Width="*" />
                                            <DataGridTextColumn Header="Reason" Binding="{Binding RejectReason}" Width="160" />
                                            <DataGridTextColumn Header="Detail" Binding="{Binding RejectDetail}" Width="260" />
                                            <DataGridTextColumn Header="Seeders" Binding="{Binding SearchResult.Seeders}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- #endregion -->

                <!-- #region Activity tab -->
                <TabItem Header="Activity">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Button Command="{Binding CancelSelectedJobCommand}" Content="Cancel" />
                                    <Button Command="{Binding RetrySelectedJobCommand}" Content="Retry" />
                                    <Button Command="{Binding DeleteSelectedJobCommand}" Content="Delete" />
                                    <Button Command="{Binding RefreshTorrentStatesCommand}" Content="Refresh qBittorrent" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding FetchJobs}"
                                          SelectedItem="{Binding SelectedFetchJob, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Margin="0,12,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="55" />
                                        <DataGridTextColumn Header="Job" Binding="{Binding StatusIcon}" Width="70" />
                                        <DataGridTextColumn Header="Title" Binding="{Binding ShowTitle}" Width="220" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                        <DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="90" />
                                        <DataGridTextColumn Header="Error" Binding="{Binding ErrorSummary}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Storage status" Style="{StaticResource SectionLabel}" />
                                <DataGrid ItemsSource="{Binding StorageStatuses}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Drive" Binding="{Binding DriveRoot}" Width="60" />
                                        <DataGridTextColumn Header="Free" Binding="{Binding FreeDisplay}" Width="85" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalDisplay}" Width="85" />
                                        <DataGridTextColumn Header="Free %" Binding="{Binding FreePercentDisplay}" Width="70" />
                                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- #endregion -->
            </TabControl>
            <!-- #endregion -->
        </Grid>
    </Grid>
    <!-- #endregion -->
</UserControl>
