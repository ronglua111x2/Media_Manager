<UserControl x:Class="media_management_app.Views.AutoTrackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Auto" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding SchedulerStatus}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LastRunSummary, StringFormat=Last run: {0}}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,2,0,0" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0">
                        <Run Text="{Binding TrackedShowCount, Mode=OneWay}" />
                        <Run Text=" tracked show(s) · " />
                        <Run Text="{Binding TotalPendingEpisodes, Mode=OneWay}" />
                        <Run Text=" pending episode(s)" />
                    </TextBlock>
                    <TextBlock Text="{Binding TmdbRefreshesRemainingLabel}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                            Command="{Binding RefreshDashboardCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Refresh dashboard">
                        <iconPacks:PackIconLucide Kind="RefreshCw" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource AppPrimaryButtonStyle}"
                            Command="{Binding RunNowCommand}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Play"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                            <TextBlock Text="Run Now" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Style="{StaticResource PanelCardStyle}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Auto-Tracked Shows"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TrackedShows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AppBrushSurface}"
                                            BorderBrush="{StaticResource AppBrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="48"
                                                        Height="72"
                                                        CornerRadius="4"
                                                        Background="{StaticResource AppBrushChipMuted}"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding PosterImage}"
                                                           Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0">
                                                        <Run Text="From " />
                                                        <Run Text="{Binding CheckpointLabel, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding SeriesStatusLabel, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding PendingLabel}"
                                                               Foreground="{StaticResource AppBrushAccent}"
                                                               FontSize="12"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding ScheduleStatusLine}"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding TmdbStatusLine}"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding HuntStatusLine}"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                                                            Command="{Binding DataContext.ResetWeekCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,8,0"
                                                            Padding="10,6"
                                                            Content="Reset week"
                                                            ToolTip="Clear this week's TMDB satisfaction and release stuck auto-track cart orders (Searching / CandidatesFound / Approved) so hunt can run again." />
                                                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                                                            Command="{Binding DataContext.StopTrackingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,6"
                                                            Content="Stop" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                <TextBlock Text="Assign download folder (required)"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding DownloadFolderOptions}"
                                                          SelectedItem="{Binding DownloadFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Assign a download folder on Home before the next run."
                                                           Foreground="{StaticResource AppBrushDanger}"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding NeedsDownloadFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <CheckBox IsChecked="{Binding AutoReconcileAndLink, Mode=TwoWay}"
                                                          Margin="0,8,0,0"
                                                          Content="Auto reconcile and hardlink" />
                                                <CheckBox IsChecked="{Binding UseCustomSchedule, Mode=TwoWay}"
                                                          Margin="0,8,0,0"
                                                          Content="Use custom hunt schedule"
                                                          ToolTip="Override global Day/Time for when this show may start hunting after TMDB finds a pending episode" />
                                                <StackPanel Margin="0,6,0,0"
                                                            MaxWidth="420"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding UseCustomSchedule, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Day"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       Margin="0,0,0,4" />
                                                            <ComboBox ItemsSource="{Binding AnchorDayOptions}"
                                                                      SelectedItem="{Binding CustomAnchorDay, Mode=TwoWay}"
                                                                      MaxWidth="160"
                                                                      HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Time"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       Margin="0,0,0,4" />
                                                            <materialDesign:TimePicker Is24Hours="True"
                                                                                       SelectedTimeFormat="Short"
                                                                                       SelectedTime="{Binding CustomAnchorTime, Mode=TwoWay}"
                                                                                       Foreground="{StaticResource AppBrushText}"
                                                                                       FontSize="13"
                                                                                       MaxWidth="140"
                                                                                       HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                                <CheckBox IsChecked="{Binding UseCustomQuality, Mode=TwoWay}"
                                                          Margin="0,8,0,0"
                                                          Content="Use custom quality" />
                                                <StackPanel Margin="0,6,0,0"
                                                            MaxWidth="420"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding UseCustomQuality, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" MaxWidth="180" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" MaxWidth="180" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel Margin="0,0,0,6">
                                                            <TextBlock Text="Min quality"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding CustomMinQuality, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="0,0,0,6">
                                                            <TextBlock Text="Min seeders"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding CustomMinSeeders, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Margin="0,0,0,6">
                                                            <TextBlock Text="Min size MB (0=off)"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding CustomMinFileSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                                                            <TextBlock Text="Max size MB (0=off)"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       Margin="0,0,0,4" />
                                                            <TextBox Text="{Binding CustomMaxFileSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="Allowed qualities (comma-separated)"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding CustomAllowedQualities, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="New This Week"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NewEpisodesThisWeek}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AppBrushBorder}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,8"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayLine}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding EpisodeTitle}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
