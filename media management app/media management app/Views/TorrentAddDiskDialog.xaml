<Window x:Class="media_management_app.Views.TorrentAddDiskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Add to qBittorrent"
        Width="780"
        MinWidth="640"
        Height="540"
        MinHeight="380"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBrushCanvas}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="DriveProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#e8eef4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushAccent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverflow}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AppBrushDanger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProgressBrushKey}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DriveCardStyle" TargetType="Border">
            <Setter Property="Width" Value="220" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource AppBrushSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverflow}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AppBrushDanger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AssignmentRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Background" Value="#fce8e8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource AppBrushSurface}"
                BorderBrush="{StaticResource AppBrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconLucide Kind="HardDrive"
                                               Width="18"
                                               Height="18"
                                               Foreground="{StaticResource AppBrushAccent}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                    <TextBlock Text="Add to qBittorrent"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding TotalSizeDisplay}"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Validation banner -->
        <Border DockPanel.Dock="Top"
                Background="#fce8e8"
                BorderBrush="{StaticResource AppBrushDanger}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,12"
                Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Kind="TriangleAlert"
                                           Width="16"
                                           Height="16"
                                           Foreground="{StaticResource AppBrushDanger}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{StaticResource AppBrushDanger}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource AppBrushSurface}"
                BorderBrush="{StaticResource AppBrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,12,0,0">
            <Grid>
                <Button Style="{StaticResource AppOutlinedButtonStyle}"
                        HorizontalAlignment="Left"
                        Command="{Binding AutoDistributeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Shuffle"
                                                   Width="14"
                                                   Height="14"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="Auto distribute" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Style="{StaticResource AppPrimaryButtonStyle}"
                            Command="{Binding ConfirmCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            IsEnabled="{Binding CanConfirm}">
                        <TextBlock Text="{Binding ConfirmButtonText}" Foreground="#ffffff" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Drives section -->
                <TextBlock Text="DRIVES"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppBrushMutedText}"
                           Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Drives}"
                              Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DriveCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DriveRoot}"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="{Binding FolderDisplay}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,8" />
                                    <ProgressBar Style="{StaticResource DriveProgressBarStyle}"
                                                 Value="{Binding UsedFraction, Mode=OneWay}"
                                                 Maximum="1"
                                                 Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding FreeDisplay}"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding TotalDisplay, StringFormat={}{0} total}"
                                               Style="{StaticResource MutedTextStyle}"
                                               FontSize="11"
                                               Margin="0,2,0,6" />
                                    <Border Background="{StaticResource AppBrushAccentSoft}"
                                            BorderBrush="{StaticResource AppBrushAccent}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding HasAssignedBytes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding AssignedDisplay}"
                                                   Foreground="{StaticResource AppBrushAccent}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#fce8e8"
                                            BorderBrush="{StaticResource AppBrushDanger}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Visibility="{Binding IsOverflow, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Overflow"
                                                   Foreground="{StaticResource AppBrushDanger}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Torrents section -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="TORRENTS"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppBrushMutedText}"
                               VerticalAlignment="Center" />
                    <Border Background="{StaticResource AppBrushAccentSoft}"
                            BorderBrush="{StaticResource AppBrushAccent}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="10,0,0,0">
                        <TextBlock Text="{Binding TotalSizeDisplay}"
                                   Foreground="{StaticResource AppBrushAccent}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <Border Background="{StaticResource AppBrushSurface}"
                        BorderBrush="{StaticResource AppBrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Background="#f4f8fb"
                                            BorderBrush="{StaticResource AppBrushBorder}"
                                            BorderThickness="4,0,0,0"
                                            Padding="10,6"
                                            Visibility="{Binding IsSeasonGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppBrushShowAccent}" />
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource AssignmentRowStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="240" />
                                                            <ColumnDefinition Width="28" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding CandidateName}"
                                                                       Style="{StaticResource MutedTextStyle}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding FileSizeDisplay}"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,12,0" />

                                                        <ComboBox Grid.Column="2"
                                                                  ItemsSource="{Binding FolderOptions}"
                                                                  SelectedValue="{Binding SelectedDownloadFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Folder"
                                                                  DisplayMemberPath="DisplayText"
                                                                  MinWidth="220"
                                                                  VerticalAlignment="Center" />

                                                        <iconPacks:PackIconLucide Grid.Column="3"
                                                                                   Width="16"
                                                                                   Height="16"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Center">
                                                            <iconPacks:PackIconLucide.Style>
                                                                <Style TargetType="iconPacks:PackIconLucide">
                                                                    <Setter Property="Kind" Value="Check" />
                                                                    <Setter Property="Foreground" Value="{StaticResource AppBrushAccent}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                            <Setter Property="Kind" Value="TriangleAlert" />
                                                                            <Setter Property="Foreground" Value="{StaticResource AppBrushDanger}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </iconPacks:PackIconLucide.Style>
                                                        </iconPacks:PackIconLucide>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
