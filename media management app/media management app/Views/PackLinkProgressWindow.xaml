<Window x:Class="media_management_app.Views.PackLinkProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:models="clr-namespace:media_management_app.Models"
        Title="{Binding WindowTitle}"
        Width="560"
        MinWidth="480"
        Height="480"
        MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBrushCanvas}"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Bottom"
                Margin="0,12,0,0"
                Padding="0,12,0,0"
                BorderBrush="{StaticResource AppBrushBorder}"
                BorderThickness="0,1,0,0">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    Padding="16,8"
                    IsEnabled="{Binding CanClose}"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AppBrushText}"
                       Margin="0,0,0,8" />
            <TextBlock Text="{Binding CurrentMessage}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource AppBrushMutedText}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12,10"
                                    CornerRadius="8"
                                    Background="{StaticResource AppBrushSurface}"
                                    BorderBrush="{StaticResource AppBrushBorder}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                                        <iconPacks:PackIconLucide Kind="Loader"
                                                                   Width="18"
                                                                   Height="18"
                                                                   Foreground="{StaticResource AppBrushAccent}">
                                            <iconPacks:PackIconLucide.Style>
                                                <Style TargetType="iconPacks:PackIconLucide">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconLucide.Style>
                                        </iconPacks:PackIconLucide>
                                        <iconPacks:PackIconLucide Kind="Circle"
                                                                   Width="18"
                                                                   Height="18"
                                                                   Foreground="{StaticResource AppBrushMutedText}">
                                            <iconPacks:PackIconLucide.Style>
                                                <Style TargetType="iconPacks:PackIconLucide">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:PackLinkProgressStatus.Pending}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconLucide.Style>
                                        </iconPacks:PackIconLucide>
                                        <iconPacks:PackIconLucide Kind="Check"
                                                                   Width="18"
                                                                   Height="18"
                                                                   Foreground="{StaticResource AppBrushAccent}">
                                            <iconPacks:PackIconLucide.Style>
                                                <Style TargetType="iconPacks:PackIconLucide">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconLucide.Style>
                                        </iconPacks:PackIconLucide>
                                        <iconPacks:PackIconLucide Kind="X"
                                                                   Width="18"
                                                                   Height="18"
                                                                   Foreground="{StaticResource AppBrushDanger}">
                                            <iconPacks:PackIconLucide.Style>
                                                <Style TargetType="iconPacks:PackIconLucide">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconLucide.Style>
                                        </iconPacks:PackIconLucide>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppBrushText}" />
                                        <TextBlock Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource AppBrushMutedText}"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Visibility="{Binding HasDebugDetail, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,4,0,0"
                        Padding="10"
                        CornerRadius="8"
                        Background="{StaticResource AppBrushStatusErrorBg}"
                        BorderBrush="{StaticResource AppBrushDanger}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Debug detail"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppBrushDanger}"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding DebugDetail, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="160"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource AppBrushText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
