<Window x:Class="media_management_app.Views.QuickAddShowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Add + search"
        Width="460"
        MinWidth="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBrushCanvas}"
        Foreground="{StaticResource AppBrushText}"
        TextElement.Foreground="{StaticResource AppBrushText}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource AppOutlinedButtonStyle}"
                    Width="96"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button x:Name="ConfirmButton"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    MinWidth="120"
                    Padding="12,6"
                    IsDefault="True"
                    Click="Confirm_Click" />
        </StackPanel>

        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <iconPacks:PackIconLucide Kind="Search"
                                           Width="18"
                                           Height="18"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                <TextBlock Text="What should the cart search?"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="TitleText"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,12" />

            <RadioButton x:Name="AllPacksOption"
                         GroupName="QuickAdd"
                         IsChecked="True"
                         Margin="0,0,0,8"
                         Content="Season packs for every aired season" />
            <RadioButton x:Name="LatestPackOption"
                         GroupName="QuickAdd"
                         Margin="0,0,0,8"
                         Content="Latest season only (one pack)" />
            <RadioButton x:Name="MissingEpisodesOption"
                         GroupName="QuickAdd"
                         Margin="0,0,0,8"
                         Content="Missing aired episodes (packs when there are many)" />
            <RadioButton x:Name="LibraryOnlyOption"
                         GroupName="QuickAdd"
                         Margin="0,0,0,8"
                         Content="Library only (search nothing)" />

            <TextBlock Text="Specials (season 0) are skipped. Orders already in the cart are not added twice. The search runs in the background; review and add candidates in the Cart as usual."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource AppBrushMutedText}"
                       Margin="0,8,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
