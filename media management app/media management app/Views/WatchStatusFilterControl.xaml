<UserControl x:Class="media_management_app.Views.WatchStatusFilterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <Style x:Key="WatchStatusFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Border"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource AppBrushBorder}"
                                    BorderThickness="1,0,0,0">
                                <Path Width="8"
                                      Height="5"
                                      Data="M0,0 L4,4 L8,0 Z"
                                      Fill="{StaticResource AppBrushMutedText}"
                                      Stretch="Fill"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AppBrushBorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="FilterToggle"
                      Style="{StaticResource WatchStatusFilterToggleStyle}"
                      ToolTip="Filter by watch status">
            <TextBlock Text="{Binding WatchStatusFilterLabel}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Foreground="{Binding WatchStatusFilterLabelStatus, Converter={StaticResource UserWatchStatusToBrushConverter}}" />
        </ToggleButton>
        <Popup PlacementTarget="{Binding ElementName=FilterToggle}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide"
               MinWidth="{Binding ActualWidth, ElementName=FilterToggle}"
               IsOpen="{Binding IsChecked, ElementName=FilterToggle, Mode=TwoWay}">
            <Border Background="{StaticResource AppBrushSurfaceRaised}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="1"
                    Margin="0,2,0,0"
                    Padding="4,6">
                <StackPanel>
                    <Button Command="{Binding ClearWatchStatusFilterCommand}"
                            Margin="4,0,4,6"
                            Padding="6,4"
                            MinHeight="28"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            ToolTip="Clear ticks and show all statuses">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ListX"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppBrushMutedText}" />
                            <TextBlock Text="Clear all (All statuses)"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AppBrushMutedText}" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding WatchStatusFilterOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="4,2"
                                      Padding="6,2"
                                      HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="{Binding Status, Converter={StaticResource UserWatchStatusToLucideKindConverter}}"
                                                               Width="14"
                                                               Height="14"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Status, Converter={StaticResource UserWatchStatusToBrushConverter}}" />
                                    <TextBlock Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Status, Converter={StaticResource UserWatchStatusToBrushConverter}}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
