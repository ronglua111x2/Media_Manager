<UserControl x:Class="media_management_app.Views.QbittorrentWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="QbittorrentActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="QbittorrentStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="{StaticResource AppBrushMutedText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AppBrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReady}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AppBrushAccent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AppBrushDanger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBrushCanvas}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppBrushSurfaceRaised}"
                BorderBrush="{StaticResource AppBrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30"
                                Height="30"
                                Background="{StaticResource AppBrushAccentSoft}"
                                BorderBrush="{StaticResource AppBrushAccent}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,10,0">
                            <iconPacks:PackIconLucide Kind="Globe"
                                                      Width="17"
                                                      Height="17"
                                                      Foreground="{StaticResource AppBrushAccent}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="qBittorrent"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       TextWrapping="NoWrap" />
                            <TextBlock Text="{Binding WebUiUrl}"
                                       Foreground="{StaticResource AppBrushMutedText}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       MaxWidth="680" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse Style="{StaticResource QbittorrentStatusDotStyle}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource AppBrushMutedText}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding RefreshSettingsCommand}"
                            Style="{StaticResource QbittorrentActionButtonStyle}">
                        <TextBlock Text="Refresh Settings" />
                    </Button>
                    <Button Command="{Binding ReloadCommand}"
                            Style="{StaticResource QbittorrentActionButtonStyle}">
                        <TextBlock Text="Reload" />
                    </Button>
                    <Button Command="{Binding OpenExternalCommand}"
                            Style="{StaticResource QbittorrentActionButtonStyle}">
                        <TextBlock Text="Open Browser" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource AppBrushSurfaceRaised}"
                BorderBrush="{StaticResource AppBrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <Grid>
                <Grid x:Name="BrowserHost" />

                <Border Background="#ccffffff"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="320">
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     Margin="0,0,0,14" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource AppBrushMutedText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="#eaffffff"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="420">
                        <TextBlock Text="qBittorrent Web UI is unavailable"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource AppBrushMutedText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
