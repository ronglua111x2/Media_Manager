<Window x:Class="media_management_app.Views.EpisodeOrganizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Episode Organization"
        Width="520"
        MinWidth="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBrushCanvas}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding ShowTitle}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource AppBrushText}"
                   Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding HelpText}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource AppBrushMutedText}"
                   Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource AppOutlinedButtonStyle}"
                    Width="96"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="{Binding ConfirmButtonText}"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    MinWidth="120"
                    Padding="12,6"
                    Click="Confirm_Click" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Options}"
                 SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 MaxHeight="320">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppBrushText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SummaryLabel}"
                                   Foreground="{StaticResource AppBrushMutedText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
