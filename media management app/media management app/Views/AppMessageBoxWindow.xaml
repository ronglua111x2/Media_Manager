<Window x:Class="media_management_app.Views.AppMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Media Manager"
        Width="440"
        MinWidth="400"
        MaxWidth="520"
        MinHeight="160"
        MaxHeight="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBrushCanvas}"
        Foreground="{StaticResource AppBrushText}"
        Icon="pack://application:,,,/Assets/app-icon.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ChromeIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource AppIconStyle}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="TitleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource AppButtonControlTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushDanger}" />
                    <Setter Property="Foreground" Value="{StaticResource AppBrushOnAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource AppBrushCanvas}"
            BorderBrush="{StaticResource AppBrushBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Height="38"
                    Background="{StaticResource AppBrushSurface}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="Media Manager"
                               Margin="14,0,46,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppBrushText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CloseCaptionButton"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseTitleButtonStyle}"
                            Focusable="False"
                            Click="DismissButton_Click"
                            ToolTip="Close">
                        <iconPacks:PackIconLucide Kind="X" Style="{StaticResource ChromeIconStyle}" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,16,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconWell"
                        Width="40"
                        Height="40"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        Background="{StaticResource AppBrushAccentSoft}">
                    <iconPacks:PackIconLucide x:Name="SeverityIcon"
                                              Kind="Info"
                                              Width="22"
                                              Height="22"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{StaticResource AppBrushAccent}" />
                </Border>

                <ScrollViewer Grid.Column="1"
                              MaxHeight="260"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText"
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="20"
                               Foreground="{StaticResource AppBrushText}" />
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,8,16,16">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Style="{StaticResource AppOutlinedButtonStyle}"
                        Click="CancelButton_Click"
                        Visibility="Collapsed" />
                <Button x:Name="NoButton"
                        Content="No"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Style="{StaticResource AppOutlinedButtonStyle}"
                        Click="NoButton_Click"
                        Visibility="Collapsed" />
                <Button x:Name="YesButton"
                        Content="Yes"
                        MinWidth="88"
                        Style="{StaticResource AppPrimaryButtonStyle}"
                        Click="YesButton_Click"
                        Visibility="Collapsed" />
                <Button x:Name="OkButton"
                        Content="OK"
                        MinWidth="88"
                        Style="{StaticResource AppPrimaryButtonStyle}"
                        Click="OkButton_Click"
                        Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
