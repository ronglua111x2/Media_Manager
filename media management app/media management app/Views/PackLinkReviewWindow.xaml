<Window x:Class="media_management_app.Views.PackLinkReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{Binding WindowTitle}"
        Width="820"
        MinWidth="640"
        Height="560"
        MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBrushCanvas}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Bottom"
                Margin="0,12,0,0"
                Padding="0,12,0,0"
                BorderBrush="{StaticResource AppBrushBorder}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Margin="0,0,8,0"
                        MinWidth="96"
                        Style="{StaticResource AppOutlinedButtonStyle}"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Content="Retry AI"
                        Margin="0,0,8,0"
                        MinWidth="110"
                        Style="{StaticResource AppOutlinedButtonStyle}"
                        Command="{Binding RetryCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button Content="Accept and link"
                        MinWidth="130"
                        Command="{Binding AcceptCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource AppPrimaryButtonStyle}" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <iconPacks:PackIconLucide Kind="Sparkles"
                                           Width="18"
                                           Height="18"
                                           Foreground="{StaticResource AppBrushAccent}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                <TextBlock Text="{Binding WindowTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppBrushText}" />
            </StackPanel>
            <TextBlock Text="Review special/OVA mappings before creating library hardlinks."
                       Foreground="{StaticResource AppBrushMutedText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />
            <TextBlock Text="{Binding SummaryText}"
                       Foreground="{StaticResource AppBrushText}"
                       FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Warnings}"
                          Margin="0,8,0,0"
                          Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat=Warning: {0}}"
                                   Foreground="{StaticResource AppBrushDanger}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Background="{StaticResource AppBrushDataGridBackground}"
                BorderBrush="{StaticResource AppBrushDataGridBorder}"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="36"
                      AlternationCount="2"
                      RowBackground="{StaticResource AppBrushDataGridBackground}"
                      AlternatingRowBackground="{StaticResource AppBrushDataGridAltRow}"
                      Foreground="{StaticResource AppBrushText}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="File" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}"
                                           ToolTip="{Binding RelativePath}"
                                           Style="{StaticResource AppDataGridTextCellStyle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Maps to"
                                        Binding="{Binding TargetLabel}"
                                        Width="*"
                                        ElementStyle="{StaticResource AppDataGridTextCellStyle}" />
                    <DataGridTextColumn Header="Source"
                                        Binding="{Binding SourceLabel}"
                                        Width="90"
                                        ElementStyle="{StaticResource AppDataGridTextCellStyle}" />
                    <DataGridTextColumn Header="Reason"
                                        Binding="{Binding Reason}"
                                        Width="2*"
                                        ElementStyle="{StaticResource AppDataGridTextCellStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
