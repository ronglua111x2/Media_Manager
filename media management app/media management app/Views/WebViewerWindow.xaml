<Window x:Class="media_management_app.Views.WebViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:controls="clr-namespace:media_management_app.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Viewer"
        Height="720"
        Width="1280"
        MinHeight="480"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBrushCanvas}"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ChromeIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource AppIconStyle}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="TitleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource AppButtonControlTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushDanger}" />
                    <Setter Property="Foreground" Value="{StaticResource AppBrushOnAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border x:Name="ShellBorder"
            Background="{StaticResource AppBrushCanvas}"
            BorderBrush="{StaticResource AppBrushBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Height="46"
                    Background="{StaticResource AppBrushSurface}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,10,0">
                        <Border x:Name="BrandBadge"
                                Width="25"
                                Height="25"
                                Background="{StaticResource AppBrushAccent}"
                                CornerRadius="5"
                                Margin="0,0,9,0">
                            <iconPacks:PackIconLucide x:Name="BrandIcon"
                                                      Kind="Globe"
                                                      Width="16"
                                                      Height="16"
                                                      Foreground="{StaticResource AppBrushOnAccent}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TitleLabel"
                                   Text="Viewer"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="UrlBar"
                            Grid.Column="1"
                            Width="300"
                            Height="28"
                            Margin="0,0,4,0"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource AppBrushCanvas}"
                            BorderBrush="{StaticResource AppBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Focusable="False">
                        <TextBlock x:Name="UrlText"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   IsHitTestVisible="False"
                                   Focusable="False" />
                    </Border>

                    <Button x:Name="ReloadButton"
                            Grid.Column="2"
                            Style="{StaticResource TitleButtonStyle}"
                            Focusable="False"
                            Click="ReloadButton_Click"
                            ToolTip="Reload">
                        <iconPacks:PackIconLucide Kind="RefreshCw" Style="{StaticResource ChromeIconStyle}" />
                    </Button>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <controls:WarpStatusPill x:Name="WarpStatusPill"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center" />
                        <Button Style="{StaticResource TitleButtonStyle}"
                                Focusable="False"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <iconPacks:PackIconLucide Kind="Minus" Style="{StaticResource ChromeIconStyle}" />
                        </Button>
                        <Button Style="{StaticResource TitleButtonStyle}"
                                Focusable="False"
                                Click="MaximizeRestoreButton_Click"
                                ToolTip="Maximize or restore">
                            <iconPacks:PackIconLucide Kind="Square" Style="{StaticResource ChromeIconStyle}" />
                        </Button>
                        <Button Style="{StaticResource CloseTitleButtonStyle}"
                                Focusable="False"
                                Click="CloseButton_Click"
                                ToolTip="Close">
                            <iconPacks:PackIconLucide Kind="X" Style="{StaticResource ChromeIconStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="BrowserHost"
                  Grid.Row="1"
                  Background="{StaticResource AppBrushCanvas}" />
        </Grid>
    </Border>
</Window>
