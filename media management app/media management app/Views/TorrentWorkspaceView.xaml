<UserControl x:Class="media_management_app.Views.TorrentWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:media_management_app.Services;assembly=MediaManager.Core"
             xmlns:views="clr-namespace:media_management_app.Views">
    <!-- #region Local resources and templates -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="RecipeComboBoxItemTemplate">
            <TextBlock Text="{Binding Name}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </DataTemplate>

        <Style x:Key="CartRecipeComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ItemTemplate" Value="{StaticResource RecipeComboBoxItemTemplate}" />
        </Style>

        <Style x:Key="CartNumericUpDownStyle" TargetType="materialDesign:NumericUpDown">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="2,4" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Width" Value="112" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="RecipeSummaryLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>

        <Style x:Key="RecipeSummaryValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="RecipeSummaryIconStyle" TargetType="iconPacks:PackIconLucide">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
        </Style>

        <Style x:Key="RecipeOverrideTitleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CartOverrideValueHostStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CartMinSizeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
            <Setter Property="CaretBrush" Value="{StaticResource AppBrushWarning}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="views:CommitTextBoxOnEnter.IsEnabled" Value="True" />
        </Style>

        <Style x:Key="CartRecipeOverviewScrollStyle" TargetType="ScrollViewer">
            <Setter Property="Height" Value="238" />
            <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="CanContentScroll" Value="False" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="materialDesign:ScrollViewerAssist.IsAutoHideEnabled" Value="False" />
        </Style>

        <Style x:Key="CartOverrideNumericUpDownStyle" TargetType="materialDesign:NumericUpDown" BasedOn="{StaticResource CartNumericUpDownStyle}">
            <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
            <Setter Property="Width" Value="128" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Visibility" Value="Hidden" />
        </Style>

        <DataTemplate x:Key="CartRecipeSummaryTemplate">
            <Border Background="{StaticResource AppBrushCanvas}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="27"
                                Height="27"
                                Background="{StaticResource AppBrushAccentSoft}"
                                CornerRadius="6"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <iconPacks:PackIconLucide Width="15"
                                                       Height="15"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppBrushAccent}">
                                <iconPacks:PackIconLucide.Style>
                                    <Style TargetType="iconPacks:PackIconLucide">
                                        <Setter Property="Kind" Value="Tv" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TargetKind}" Value="TvSeasonPack">
                                                <Setter Property="Kind" Value="Package" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TargetKind}" Value="Movie">
                                                <Setter Property="Kind" Value="Film" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconLucide.Style>
                            </iconPacks:PackIconLucide>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TargetLabel}"
                                       Foreground="{StaticResource AppBrushAccent}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnyOverride}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource CartRecipeOverviewScrollStyle}"
                                  views:SyncedScrollViewer.GroupName="CartRecipeOverview">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" MinWidth="128" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>

                        <iconPacks:PackIconLucide Kind="BadgeCheck" Style="{StaticResource RecipeSummaryIconStyle}" />
                        <TextBlock Grid.Column="1" Text="Quality" Style="{StaticResource RecipeSummaryLabelStyle}" />
                        <TextBlock Grid.Column="2" Text="{Binding QualitySummary}" Style="{StaticResource RecipeSummaryValueStyle}" />

                        <iconPacks:PackIconLucide Grid.Row="1" Kind="Sprout" Style="{StaticResource RecipeSummaryIconStyle}" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource RecipeOverrideTitleButtonStyle}"
                                Command="{Binding ToggleMinSeedersOverrideCommand}"
                                ToolTip="Override min seeders for manual Run Cart">
                            <TextBlock Text="Min seeders">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryLabelStyle}">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMinSeedersOverridden}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Grid Grid.Row="1" Grid.Column="2" Style="{StaticResource CartOverrideValueHostStyle}">
                            <TextBlock Text="{Binding MinimumSeedersSummary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMinSeedersOverridden}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <materialDesign:NumericUpDown Minimum="{x:Static services:RecipeRuntimeSettings.MinCartMinSeedersOverride}"
                                                          Maximum="{x:Static services:RecipeRuntimeSettings.MaxCartMinSeedersOverride}"
                                                          Value="{Binding OverrideMinSeeders, UpdateSourceTrigger=PropertyChanged}">
                                <materialDesign:NumericUpDown.Style>
                                    <Style TargetType="materialDesign:NumericUpDown" BasedOn="{StaticResource CartOverrideNumericUpDownStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMinSeedersOverridden}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:NumericUpDown.Style>
                            </materialDesign:NumericUpDown>
                        </Grid>

                        <iconPacks:PackIconLucide Grid.Row="2" Kind="HardDrive" Style="{StaticResource RecipeSummaryIconStyle}" />
                        <Button Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource RecipeOverrideTitleButtonStyle}"
                                Command="{Binding ToggleMinSizeOverrideCommand}"
                                ToolTip="Override min size for manual Run Cart">
                            <TextBlock Text="Min size">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryLabelStyle}">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMinSizeOverridden}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Grid Grid.Row="2" Grid.Column="2" Style="{StaticResource CartOverrideValueHostStyle}">
                            <TextBlock Text="{Binding MinimumSizeSummary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMinSizeOverridden}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMinSizeOverridden}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBox Text="{Binding OverrideMinSizeGbText, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource CartMinSizeTextBoxStyle}" />
                                <TextBlock Text="GB"
                                           Style="{StaticResource MutedTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <iconPacks:PackIconLucide Grid.Row="3" Kind="Search" Style="{StaticResource RecipeSummaryIconStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Search" Style="{StaticResource RecipeSummaryLabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SearchModeSummary}" Style="{StaticResource RecipeSummaryValueStyle}" />

                        <iconPacks:PackIconLucide Grid.Row="4" Kind="Plug" Style="{StaticResource RecipeSummaryIconStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Plugins" Style="{StaticResource RecipeSummaryLabelStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding PluginsSummary}" Style="{StaticResource RecipeSummaryValueStyle}" />

                        <iconPacks:PackIconLucide Grid.Row="5" Kind="Bug" Style="{StaticResource RecipeSummaryIconStyle}" />
                        <Button Grid.Row="5"
                                Grid.Column="1"
                                Style="{StaticResource RecipeOverrideTitleButtonStyle}"
                                Command="{Binding ToggleCandidateDebugOverrideCommand}"
                                ToolTip="Override candidate debug log for manual Run Cart">
                            <TextBlock Text="Debug">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryLabelStyle}">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCandidateDebugOverridden}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Grid.Row="5"
                                Grid.Column="2"
                                Style="{StaticResource RecipeOverrideTitleButtonStyle}"
                                Margin="0"
                                Command="{Binding CycleCandidateDebugCommand}"
                                ToolTip="Toggle candidate debug On/Off for manual Run Cart">
                            <TextBlock Text="{Binding EffectiveCandidateDebugSummary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCandidateDebugOverridden}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <iconPacks:PackIconLucide Grid.Row="6" Kind="Type" Style="{StaticResource RecipeSummaryIconStyle}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Titles" Style="{StaticResource RecipeSummaryLabelStyle}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding TitleBehaviorSummary}" Style="{StaticResource RecipeSummaryValueStyle}" />

                        <iconPacks:PackIconLucide Grid.Row="7"
                                                   Kind="ListFilter"
                                                   Style="{StaticResource RecipeSummaryIconStyle}" />
                        <Button Grid.Row="7"
                                Grid.Column="1"
                                Style="{StaticResource RecipeOverrideTitleButtonStyle}"
                                Command="{Binding ToggleMaxCandidatesOverrideCommand}"
                                ToolTip="Override max candidates for manual Run Cart">
                            <TextBlock Text="Max candidates">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryLabelStyle}">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaxCandidatesOverridden}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Grid Grid.Row="7" Grid.Column="2" Style="{StaticResource CartOverrideValueHostStyle}">
                            <TextBlock Text="{Binding RecipeMaxCandidates, Mode=OneWay}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryValueStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaxCandidatesOverridden}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <materialDesign:NumericUpDown Minimum="{x:Static services:RecipeRuntimeSettings.MinCartMaxCandidatesOverride}"
                                                          Maximum="{x:Static services:RecipeRuntimeSettings.MaxCartMaxCandidatesOverride}"
                                                          Value="{Binding OverrideMaxCandidates, UpdateSourceTrigger=PropertyChanged}">
                                <materialDesign:NumericUpDown.Style>
                                    <Style TargetType="materialDesign:NumericUpDown" BasedOn="{StaticResource CartOverrideNumericUpDownStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMaxCandidatesOverridden}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:NumericUpDown.Style>
                            </materialDesign:NumericUpDown>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OrderCardTemplate">
            <Border Background="{StaticResource AppBrushSurface}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="10,12"
                    Margin="0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="200" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0"
                                Grid.RowSpan="2"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InspectionCoversLine}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding InspectionExtrasLine}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasInspectionExtrasLine}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding InspectionMoviesLine}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasInspectionMoviesLine}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding CandidateText}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCandidates}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <views:CartCandidatePickerControl Grid.Column="1"
                                                      Margin="0,0,12,0"
                                                      VerticalAlignment="Center"
                                                      DataContext="{Binding}">
                        <views:CartCandidatePickerControl.Style>
                            <Style TargetType="views:CartCandidatePickerControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCandidates}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:CartCandidatePickerControl.Style>
                    </views:CartCandidatePickerControl>

                    <TextBlock Grid.Column="1"
                               Grid.Row="1"
                               Text="{Binding TorrentText}"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,6,12,0"
                               TextTrimming="CharacterEllipsis" />

                    <Border Grid.Column="2"
                            Grid.RowSpan="2"
                            Background="{StaticResource AppBrushAccentSoft}"
                            BorderBrush="{StaticResource AppBrushAccent}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusLabel}" Value="Failed">
                                        <Setter Property="Background" Value="{StaticResource AppBrushStatusErrorBg}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AppBrushDanger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusLabel}" Value="Canceled">
                                        <Setter Property="Background" Value="{StaticResource AppBrushStatusMutedBg}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusLabel}"
                                   Foreground="{StaticResource AppBrushAccent}"
                                   FontSize="11"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Failed">
                                            <Setter Property="Foreground" Value="{StaticResource AppBrushDanger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Canceled">
                                            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Column="3"
                                Grid.RowSpan="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Command="{Binding AcceptCommand}"
                                Margin="0,0,2,0"
                                ToolTip="Accept selected candidate">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AppCompactIconButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanAccept}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <iconPacks:PackIconLucide Kind="Check"
                                                       Width="15"
                                                       Height="15"
                                                       Foreground="{StaticResource AppBrushAccent}" />
                        </Button>
                        <Button Command="{Binding ReconcilePackCommand}"
                                IsEnabled="{Binding CanReconcilePack}"
                                Margin="0,0,2,0"
                                ToolTip="Inspect downloaded pack files and update covered seasons, extras, specials, and movies">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AppCompactIconButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSeasonPackOrder}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <iconPacks:PackIconLucide Kind="RefreshCw"
                                                       Width="15"
                                                       Height="15"
                                                       Foreground="{StaticResource AppBrushAccent}">
                                <iconPacks:PackIconLucide.Style>
                                    <Style TargetType="iconPacks:PackIconLucide">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanReconcilePack}" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconLucide.Style>
                            </iconPacks:PackIconLucide>
                        </Button>
                        <Button Margin="0,0,2,0"
                                ToolTip="More actions (re-search, retry add)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AppCompactIconButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanShowRecoveryMenu}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <iconPacks:PackIconLucide Kind="EllipsisVertical"
                                                       Width="15"
                                                       Height="15"
                                                       Style="{StaticResource AppIconStyle}" />
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Re-search candidates for this order"
                                              Command="{Binding RetrySearchCommand}"
                                              IsEnabled="{Binding CanRetrySearch}" />
                                    <MenuItem Header="Retry add to qBittorrent"
                                              Command="{Binding RetryAddCommand}"
                                              IsEnabled="{Binding CanRetryAdd}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource AppCompactIconButtonStyle}"
                                Command="{Binding DataContext.RemoveOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Margin="0"
                                ToolTip="Remove order from cart">
                            <iconPacks:PackIconLucide Kind="X"
                                                       Width="15"
                                                       Height="15"
                                                       Style="{StaticResource AppIconStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <!-- #endregion -->

    <!-- #region Torrent workspace layout -->
    <Grid Background="{StaticResource AppBrushCanvas}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- #region Media card list -->
        <materialDesign:Card Grid.Column="0" Style="{StaticResource PanelCardStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="LayoutList"
                                                           Width="16"
                                                           Height="16"
                                                           Margin="0,0,8,0"
                                                           Foreground="{StaticResource AppBrushAccent}"
                                                           VerticalAlignment="Center" />
                                <TextBlock Text="Media Card" Style="{StaticResource SectionTitleStyle}" />
                            </StackPanel>
                            <TextBlock Text="Select media cart"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource AppIconButtonStyle}"
                                Command="{Binding RefreshWorkspaceCommand}"
                                ToolTip="Refresh media cards">
                            <iconPacks:PackIconLucide Kind="RefreshCcw" Style="{StaticResource AppIconStyle}" />
                        </Button>
                    </Grid>

                    <Grid Margin="0,14,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Text="{Binding MediaSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0"
                                     MinHeight="34"
                                     AcceptsReturn="False"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchMediaCommand}" />
                                </TextBox.InputBindings>
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Padding" Value="10,7" />
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAppliedMediaSearch}" Value="True">
                                                <Setter Property="Padding" Value="10,7,32,7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <StackPanel Orientation="Horizontal"
                                        Margin="10,0,10,0"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMediaSearchText}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <iconPacks:PackIconLucide Kind="Search"
                                                           Width="14"
                                                           Height="14"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource AppBrushMutedText}" />
                                <TextBlock Text="Search media"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{StaticResource AppBrushMutedText}" />
                            </StackPanel>
                            <Button Style="{StaticResource AppCompactIconButtonStyle}"
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,6,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Command="{Binding ClearMediaSearchCommand}"
                                    ToolTip="Clear search"
                                    Visibility="{Binding HasAppliedMediaSearch, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <iconPacks:PackIconLucide Kind="CircleX"
                                                           Width="14"
                                                           Height="14"
                                                           Foreground="{StaticResource AppBrushMutedText}" />
                            </Button>
                        </Grid>
                        <Button Grid.Column="1"
                                Style="{StaticResource AppIconButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding SearchMediaCommand}"
                                ToolTip="Search media">
                            <iconPacks:PackIconLucide Kind="Search" Width="14" Height="14" />
                        </Button>
                    </Grid>

                    <views:WatchStatusFilterControl Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding MediaSortFieldOptions}"
                                  SelectedValue="{Binding MediaSortField}"
                                  SelectedValuePath="Field"
                                  ItemTemplate="{StaticResource MediaSortFieldItemTemplate}"
                                  MinHeight="34"
                                  Padding="8,4"
                                  VerticalContentAlignment="Center"
                                  ToolTip="Sort media cards" />
                        <Button Grid.Column="1"
                                Style="{StaticResource AppIconButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding ToggleMediaSortDirectionCommand}"
                                ToolTip="{Binding MediaSortDirectionToolTip}">
                            <iconPacks:PackIconLucide Width="14" Height="14">
                                <iconPacks:PackIconLucide.Style>
                                    <Style TargetType="iconPacks:PackIconLucide">
                                        <Setter Property="Kind" Value="ArrowDownNarrowWide" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSortAscending}" Value="True">
                                                <Setter Property="Kind" Value="ArrowUpNarrowWide" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconLucide.Style>
                            </iconPacks:PackIconLucide>
                        </Button>
                    </Grid>
                </StackPanel>

                <Grid>
                    <TextBlock Text="No media yet. Use Find/Add first."
                               TextAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLibraryMedia}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="No media matches the current search/filter."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="8,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoFilterMatches}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding MediaCards}"
                                      ItemTemplate="{StaticResource WorkspaceMediaCardTemplate}" />
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </materialDesign:Card>
        <!-- #endregion -->

        <!-- #region Cart controls and selected media details -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <iconPacks:PackIconLucide Kind="ShoppingCart"
                                               Width="18"
                                               Height="18"
                                               Margin="0,0,8,0"
                                               Foreground="{StaticResource AppBrushAccent}"
                                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CartTitle}"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <WrapPanel Grid.Row="1">
                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                            Command="{Binding ClearCartCommand}"
                            Margin="0,0,8,8"
                            ToolTip="Clear orders in this cart">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Eraser"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                            <TextBlock Text="Clear Cart" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                            Command="{Binding ClearCandidatesCommand}"
                            Margin="0,0,8,8"
                            ToolTip="Clear candidates from every order in this cart">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ListX"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                            <TextBlock Text="Clear Candidates" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppDangerButtonStyle}"
                            Command="{Binding StopRunCartCommand}"
                            Margin="0,0,8,8"
                            ToolTip="Stop the current cart run, add, reconcile, or re-search operation">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Square"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       Foreground="{StaticResource AppBrushOnAccent}"
                                                       VerticalAlignment="Center" />
                            <TextBlock Text="Stop" VerticalAlignment="Center" Foreground="{StaticResource AppBrushOnAccent}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppPrimaryButtonStyle}"
                            Command="{Binding RunCartCommand}"
                            Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Play"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       Foreground="{StaticResource AppBrushOnAccent}"
                                                       VerticalAlignment="Center" />
                            <TextBlock Text="Run Cart" VerticalAlignment="Center" Foreground="{StaticResource AppBrushOnAccent}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                            Command="{Binding AcceptAllCandidatesCommand}"
                            Margin="0,0,8,8"
                            ToolTip="Accept the selected candidate for every order in this cart">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="CheckCheck"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                            <TextBlock Text="Accept All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                            Command="{Binding ReconcileExistingTorrentsCommand}"
                            Margin="0,0,8,8"
                            ToolTip="Match this cart with torrents already in qBittorrent">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="RefreshCw"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                            <TextBlock Text="Reconcile" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AppOutlinedButtonStyle}"
                            Command="{Binding AddCartCommand}"
                            Margin="0,0,0,8"
                            ToolTip="Add selected candidates to qBittorrent">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Download"
                                                       Width="14"
                                                       Height="14"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                            <TextBlock Text="Add" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </WrapPanel>
            </Grid>

            <materialDesign:Card Grid.Row="1" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedMedia}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconLucide Kind="MousePointerClick"
                                                   Width="36"
                                                   Height="36"
                                                   Foreground="{StaticResource AppBrushMutedText}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,12" />
                        <TextBlock Text="Select a media card to view its cart."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextAlignment="Center" />
                    </StackPanel>

                    <Grid Visibility="{Binding HasSelectedMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding StatusMessage}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,14" />

                        <Border Grid.Row="1"
                                Background="{StaticResource AppBrushSurface}"
                                BorderBrush="{StaticResource AppBrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource AppBrushAccentSoft}"
                                                CornerRadius="6"
                                                Padding="6"
                                                Margin="0,0,8,0">
                                            <iconPacks:PackIconLucide Kind="ScrollText"
                                                                       Width="15"
                                                                       Height="15"
                                                                       Foreground="{StaticResource AppBrushAccent}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Recipes for this cart"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Selection and manual-run overrides"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource AppCompactIconButtonStyle}"
                                            Command="{Binding ToggleRecipePanelCommand}"
                                            ToolTip="Expand or collapse recipe details"
                                            VerticalAlignment="Center">
                                        <iconPacks:PackIconLucide Width="16" Height="16">
                                            <iconPacks:PackIconLucide.Style>
                                                <Style TargetType="iconPacks:PackIconLucide">
                                                    <Setter Property="Kind" Value="ChevronDown" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecipePanelExpanded}" Value="True">
                                                            <Setter Property="Kind" Value="ChevronUp" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconLucide.Style>
                                        </iconPacks:PackIconLucide>
                                    </Button>
                                </Grid>
                                <StackPanel Grid.Row="1">
                                        <TextBlock Text="These values summarize the selected recipes. Cart overrides affect manual Run Cart searches only."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"
                                                   Visibility="{Binding IsRecipePanelExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Grid Visibility="{Binding IsShowRecipePanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Episode recipe"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,0,0,6" />
                                            <TextBlock Grid.Column="2"
                                                       Text="Pack recipe"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,0,0,6" />
                                            <ComboBox Grid.Row="1"
                                                      Style="{StaticResource CartRecipeComboBoxStyle}"
                                                      ItemsSource="{Binding EpisodeRecipeOptions}"
                                                      SelectedValue="{Binding SelectedEpisodeRecipeId}"
                                                      SelectedValuePath="RecipeId" />
                                            <ComboBox Grid.Row="1"
                                                      Grid.Column="2"
                                                      Style="{StaticResource CartRecipeComboBoxStyle}"
                                                      ItemsSource="{Binding PackRecipeOptions}"
                                                      SelectedValue="{Binding SelectedPackRecipeId}"
                                                      SelectedValuePath="RecipeId" />
                                            <ContentControl Grid.Row="2"
                                                            Content="{Binding EpisodeRecipeSummary}"
                                                            ContentTemplate="{StaticResource CartRecipeSummaryTemplate}"
                                                            Margin="0,10,0,0"
                                                            VerticalAlignment="Top"
                                                            HorizontalAlignment="Stretch"
                                                            Visibility="{Binding IsRecipePanelExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ContentControl Grid.Row="2"
                                                            Grid.Column="2"
                                                            Content="{Binding PackRecipeSummary}"
                                                            ContentTemplate="{StaticResource CartRecipeSummaryTemplate}"
                                                            Margin="0,10,0,0"
                                                            VerticalAlignment="Top"
                                                            HorizontalAlignment="Stretch"
                                                            Visibility="{Binding IsRecipePanelExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <StackPanel Visibility="{Binding IsMovieRecipePanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Movie recipe"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="0,0,0,6" />
                                            <ComboBox Style="{StaticResource CartRecipeComboBoxStyle}"
                                                      HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding MovieRecipeOptions}"
                                                      SelectedValue="{Binding SelectedMovieRecipeId}"
                                                      SelectedValuePath="RecipeId" />
                                            <ContentControl Content="{Binding MovieRecipeSummary}"
                                                            ContentTemplate="{StaticResource CartRecipeSummaryTemplate}"
                                                            Margin="0,10,0,0"
                                                            Visibility="{Binding IsRecipePanelExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Orders}"
                                              ItemTemplate="{StaticResource OrderCardTemplate}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOrders}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                </ItemsControl>

                                <Border Background="{StaticResource AppBrushSurface}"
                                        BorderBrush="{StaticResource AppBrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="28"
                                        HorizontalAlignment="Stretch">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOrders}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <iconPacks:PackIconLucide Kind="ShoppingBag"
                                                                   Width="40"
                                                                   Height="40"
                                                                   Foreground="{StaticResource AppBrushMutedText}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,14" />
                                        <TextBlock Text="This cart is empty."
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Go to Library and use Add to Cart on episodes, movies, or season packs."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextAlignment="Center"
                                                   Margin="0,8,0,16" />
                                        <Button Style="{StaticResource AppOutlinedButtonStyle}"
                                                Command="{Binding GoToLibraryHintCommand}"
                                                HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <iconPacks:PackIconLucide Kind="LibraryBig"
                                                                           Width="14"
                                                                           Height="14"
                                                                           Margin="0,0,6,0"
                                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="How to add items" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </materialDesign:Card>
        </Grid>
        <!-- #endregion -->
    </Grid>
    <!-- #endregion -->
</UserControl>
