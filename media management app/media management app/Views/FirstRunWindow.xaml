<Window x:Class="media_management_app.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Host setup"
        Width="720"
        Height="580"
        MinWidth="720"
        MinHeight="580"
        MaxWidth="720"
        MaxHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBrushCanvas}"
        Foreground="{StaticResource AppBrushText}"
        Icon="pack://application:,,,/Assets/app-icon.ico"
        Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ChromeIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource AppIconStyle}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="TitleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource AppButtonControlTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushDanger}" />
                    <Setter Property="Foreground" Value="{StaticResource AppBrushOnAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="RailStepButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="8,1,8,1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource AppButtonControlTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushListHover}" />
                    <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                    <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource AppBrushCanvas}"
            BorderBrush="{StaticResource AppBrushBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Height="38"
                    Background="{StaticResource AppBrushSurface}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Margin="14,0,90,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="Host setup" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding StepSectionTitle, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding StepProgressText, Mode=OneWay}" />
                    </TextBlock>
                    <Button x:Name="CloseCaptionButton"
                            HorizontalAlignment="Right"
                            Focusable="False"
                            Command="{Binding CloseCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CloseTitleButtonStyle}">
                                <Setter Property="ToolTip" Value="Close" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGated}" Value="True">
                                        <Setter Property="ToolTip" Value="Quit" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <iconPacks:PackIconLucide Kind="X" Style="{StaticResource ChromeIconStyle}" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource AppBrushSidebar}"
                        BorderBrush="{StaticResource AppBrushBorder}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RailRows}" Margin="0,8,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Margin="14,10,12,4"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppBrushMutedText}"
                                                   Text="{Binding Title}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Command="{Binding DataContext.SelectRailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsSelectable}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RailStepButtonStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <DockPanel LastChildFill="True">
                                                <iconPacks:PackIconLucide Kind="Check"
                                                                          Width="12"
                                                                          Height="12"
                                                                          Margin="0,0,6,0"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{StaticResource AppBrushAccent}">
                                                    <iconPacks:PackIconLucide.Style>
                                                        <Style TargetType="iconPacks:PackIconLucide">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </iconPacks:PackIconLucide.Style>
                                                </iconPacks:PackIconLucide>
                                                <TextBlock VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Title}" />
                                            </DockPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="24,20,24,12">
                    <StackPanel>
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding StepTitle}" />
                        <TextBlock Margin="0,6,0,4"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource AppBrushMutedText}"
                                   Text="{Binding StepWhy}" />
                        <TextBlock Margin="0,0,0,16"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource AppBrushMutedText}"
                                   Text="{Binding StepHint}" />

                        <StackPanel Visibility="{Binding IsStartStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <RadioButton GroupName="StartChoice"
                                         Margin="0,0,0,10"
                                         IsChecked="{Binding WantFresh, Mode=TwoWay}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="Fresh install" />
                                    <LineBreak />
                                    <Run Foreground="{StaticResource AppBrushMutedText}"
                                         Text="Set up this PC. You can add a few titles at the end." />
                                </TextBlock>
                            </RadioButton>
                            <RadioButton GroupName="StartChoice"
                                         IsChecked="{Binding WantRestore, Mode=TwoWay}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="I have a backup" />
                                    <LineBreak />
                    <Run Foreground="{StaticResource AppBrushMutedText}"
                         Text="Local zip or a copied state folder. Next copies the database after you pick the state folder. Google Drive on a new PC is not this page." />
                                </TextBlock>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsRestoreStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Backup zip or copied folder" />
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppOutlinedButtonStyle}"
                                        Content="Zip…"
                                        Command="{Binding BrowseRestoreZipCommand}" />
                                <Button DockPanel.Dock="Right"
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppOutlinedButtonStyle}"
                                        Content="Folder…"
                                        Command="{Binding BrowseRestoreFolderCommand}" />
                                <TextBox MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding RestorePath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsStateFolderStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Folder" />
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppOutlinedButtonStyle}"
                                        Content="Browse"
                                        Command="{Binding BrowseStateFolderCommand}"
                                        IsEnabled="{Binding CanBrowseStateFolder}" />
                                <TextBox MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         IsReadOnly="{Binding IsStateFolderPinned}"
                                         Text="{Binding StateFolder, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsTmdbStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Read access token" />
                            <TextBox MinHeight="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding TmdbToken, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsQbittorrentStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="WebUI URL" />
                            <TextBox MinHeight="32"
                                     Margin="0,0,0,10"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding QbittorrentUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Username" />
                            <TextBox MinHeight="32"
                                     Margin="0,0,0,10"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding QbittorrentUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Password" />
                            <TextBox MinHeight="32"
                                     Margin="0,0,0,10"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding QbittorrentPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="API key (optional, qBittorrent 5.2+)" />
                            <TextBox MinHeight="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding QbittorrentApiKey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsFoldersStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Download folder" />
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppOutlinedButtonStyle}"
                                        Content="Browse"
                                        Command="{Binding BrowseDownloadFolderCommand}" />
                                <TextBox MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding DownloadFolder, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <CheckBox Margin="0,0,0,10"
                                      Content="Use as source"
                                      IsChecked="{Binding UseDownloadFolderAsSource}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Source folder" />
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppOutlinedButtonStyle}"
                                        Content="Browse"
                                        Command="{Binding BrowseSourceFolderCommand}" />
                                <TextBox MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource AppBrushMutedText}"
                                       Text="{Binding LibraryPreview}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsJellyfinStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Server URL" />
                            <TextBox MinHeight="32"
                                     Margin="0,0,0,10"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding JellyfinUrl, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="API key" />
                            <TextBox MinHeight="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding JellyfinApiKey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsSymlinkStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Unified library root" />
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppOutlinedButtonStyle}"
                                        Content="Browse"
                                        Command="{Binding BrowseSymlinkRootCommand}" />
                                <TextBox MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding SymlinkRoot, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsWarpStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="warp-cli.exe" />
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppOutlinedButtonStyle}"
                                        Content="Browse"
                                        Command="{Binding BrowseWarpCliCommand}" />
                                <TextBox MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding WarpCliPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsGeminiStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="API key" />
                            <TextBox MinHeight="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsDriveStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="OAuth client JSON" />
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppOutlinedButtonStyle}"
                                        Content="Browse"
                                        Command="{Binding BrowseDriveCredentialsCommand}" />
                                <TextBox MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding DriveCredentialsPath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsWindowsStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Theme" />
                            <ComboBox Margin="0,0,0,12"
                                      MinHeight="32"
                                      ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding SelectedTheme}" />
                            <CheckBox Margin="0,0,0,8"
                                      Content="Run at Windows startup"
                                      IsChecked="{Binding RunAtStartup}" />
                            <CheckBox Content="Close to tray"
                                      IsChecked="{Binding CloseToTray}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsWarmupStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Search TMDB" />
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        MinWidth="80"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource AppOutlinedButtonStyle}"
                                        Content="Search"
                                        Command="{Binding SearchWarmupCommand}" />
                                <TextBox MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding WarmupQuery, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <ListBox MaxHeight="160"
                                     Margin="0,0,0,8"
                                     ItemsSource="{Binding WarmupResults}"
                                     SelectedItem="{Binding SelectedWarmupResult}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding TypeLabel, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding YearLabel, Mode=OneWay}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding LibraryStatus, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button MinWidth="80"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10"
                                    Style="{StaticResource AppPrimaryButtonStyle}"
                                    Content="Add"
                                    Command="{Binding AddWarmupCommand}" />
                            <ItemsControl ItemsSource="{Binding WarmupAddedTitles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{StaticResource AppBrushMutedText}"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsAutoTrackStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox Margin="0,0,0,12"
                                      Content="Enable Auto-Track"
                                      IsChecked="{Binding AutoTrackEnabled}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Weekly anchor day" />
                            <ComboBox Margin="0,0,0,10"
                                      MinHeight="32"
                                      ItemsSource="{Binding AnchorDays}"
                                      SelectedItem="{Binding AutoTrackAnchorDay}" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Anchor time (local)" />
                            <TextBox MinHeight="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding AutoTrackAnchorTime, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource AppBrushWarning}"
                                   Text="{Binding PathWarning}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Padding="16,12"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="0,1,0,0"
                    Background="{StaticResource AppBrushSurface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AppBrushDanger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Back"
                                MinWidth="80"
                                Margin="0,0,8,0"
                                Style="{StaticResource AppOutlinedButtonStyle}"
                                Command="{Binding BackCommand}" />
                        <Button Content="Skip"
                                MinWidth="80"
                                Margin="0,0,8,0"
                                Style="{StaticResource AppOutlinedButtonStyle}"
                                Command="{Binding SkipCommand}"
                                Visibility="{Binding ShowSkip, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Test"
                                MinWidth="80"
                                Margin="0,0,8,0"
                                Style="{StaticResource AppOutlinedButtonStyle}"
                                Command="{Binding TestCommand}"
                                Visibility="{Binding ShowTest, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Close"
                                MinWidth="80"
                                Margin="0,0,8,0"
                                Command="{Binding CloseCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGated}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button MinWidth="88"
                                Style="{StaticResource AppPrimaryButtonStyle}"
                                Content="{Binding PrimaryButtonText}"
                                Command="{Binding NextCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
