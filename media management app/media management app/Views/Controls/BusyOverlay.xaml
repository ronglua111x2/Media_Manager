<UserControl x:Class="media_management_app.Views.Controls.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="True">
    <Grid>
        <Border Background="{StaticResource AppBrushSurface}"
                Opacity="0.78" />
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <ProgressBar x:Name="ProgressBar"
                         Width="160"
                         Height="4"
                         Minimum="0"
                         Maximum="100"
                         IsIndeterminate="{Binding IsIndeterminate, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         Value="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource AppBrushMutedText}"
                       FontSize="12" />
        </StackPanel>
    </Grid>
</UserControl>
