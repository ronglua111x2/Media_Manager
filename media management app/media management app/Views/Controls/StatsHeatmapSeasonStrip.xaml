<UserControl x:Class="media_management_app.Views.Controls.StatsHeatmapSeasonStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:media_management_app.Converters">
    <UserControl.Resources>
        <converters:EpisodeRatingBandToBrushConverter x:Key="EpisodeRatingBandToBrushConverter" />

        <Style x:Key="HeatmapCellBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#88FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Background" Value="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}" />
        </Style>
    </UserControl.Resources>

    <ItemsControl x:Name="CellsHost">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border ToolTip="{Binding Label}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource HeatmapCellBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExtra, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Width" Value="48" />
                                    <Setter Property="Height" Value="44" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Border Height="10"
                                VerticalAlignment="Top"
                                CornerRadius="8,8,0,0"
                                Background="#22FFFFFF"
                                IsHitTestVisible="False" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       Opacity="0.75">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AppBrushOnAccent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRating}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ScoreText}"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="17" />
                                        <Setter Property="FontWeight" Value="ExtraBold" />
                                        <Setter Property="Foreground" Value="{StaticResource AppBrushOnAccent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRating}" Value="False">
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Opacity" Value="0.85" />
                                                <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
