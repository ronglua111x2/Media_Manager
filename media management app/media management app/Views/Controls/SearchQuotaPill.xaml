<UserControl x:Class="media_management_app.Views.Controls.SearchQuotaPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:media_management_app.Services"
             DataContext="{DynamicResource SearchQuota}"
             Focusable="False">
    <UserControl.Resources>
        <!-- Dot colour per severity: green ready, amber limited, red skipped, grey off. -->
        <Style x:Key="SeverityDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource AppBrushAccent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static services:SearchSiteSeverity.Limited}">
                    <Setter Property="Fill" Value="{StaticResource AppBrushWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static services:SearchSiteSeverity.Unavailable}">
                    <Setter Property="Fill" Value="{StaticResource AppBrushDanger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static services:SearchSiteSeverity.Off}">
                    <Setter Property="Fill" Value="{StaticResource AppBrushMutedText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="PillButton"
                Style="{StaticResource StatusPillButtonStyle}"
                Margin="0"
                Click="OnPillClick"
                Focusable="False">
            <Button.ToolTip>
                <TextBlock Text="{Binding Summary}" />
            </Button.ToolTip>
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource SeverityDotStyle}" Margin="0,0,7,0" />
                <!-- Accent while a running search uses any site (SitesInUse); the count is in the tooltip and popup. -->
                <iconPacks:PackIconLucide Kind="Radar"
                                           Width="14"
                                           Height="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0">
                    <iconPacks:PackIconLucide.Style>
                        <Style TargetType="iconPacks:PackIconLucide">
                            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSitesInUse}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AppBrushAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconLucide.Style>
                </iconPacks:PackIconLucide>
                <TextBlock Text="{Binding PillText}"
                           Foreground="{StaticResource AppBrushText}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Popup x:Name="QuotaPopup"
               PlacementTarget="{Binding ElementName=PillButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource AppBrushSurfaceRaised}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,6,0,0"
                    Width="560">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource StatusPillButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Refresh">
                            <iconPacks:PackIconLucide Kind="RefreshCw" Width="13" Height="13" />
                        </Button>
                        <TextBlock Text="Native search quota"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppBrushText}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Summary}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource AppBrushText}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BackendLine}"
                               Margin="0,2,0,10"
                               FontSize="12"
                               Foreground="{StaticResource AppBrushMutedText}"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Sites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource SeverityDotStyle}" HorizontalAlignment="Left" />
                                    <!-- Site name, then a small mark while a running search uses the site
                                         (SearchQuotaRowViewModel.IsInUse, from the governor's site runs). -->
                                    <DockPanel Grid.Column="1" LastChildFill="True">
                                        <iconPacks:PackIconLucide DockPanel.Dock="Right"
                                                                  Kind="Activity"
                                                                  Width="12"
                                                                  Height="12"
                                                                  Margin="4,0,6,0"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{StaticResource AppBrushAccent}"
                                                                  Background="Transparent"
                                                                  ToolTip="{Binding InUseTooltip}"
                                                                  Visibility="{Binding IsInUse, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Site}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppBrushText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Status}"
                                               Foreground="{StaticResource AppBrushMutedText}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Status}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" ToolTip="{Binding UsageTooltip}">
                                        <TextBlock Text="{Binding UsageText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AppBrushMutedText}"
                                                   HorizontalAlignment="Right" />
                                        <!-- MaterialDesign's linear ProgressBar plays an "OnLoaded" storyboard that scales the
                                             whole bar up from 0 every time it is loaded (each popup open, each rebuilt row);
                                             DisableTransitions runs its zero-length variant, so only the value changes. -->
                                        <ProgressBar Height="4"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding UsageFraction, Mode=OneWay}"
                                                     materialDesign:TransitionAssist.DisableTransitions="True"
                                                     Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ResetLine}"
                               Margin="0,10,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource AppBrushMutedText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
