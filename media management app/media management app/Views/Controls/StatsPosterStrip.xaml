<UserControl x:Class="media_management_app.Views.Controls.StatsPosterStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:media_management_app.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:views="clr-namespace:media_management_app.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:EpisodeRatingBandToBrushConverter x:Key="EpisodeRatingBandToBrushConverter" />
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Visible}"
                  HorizontalAlignment="Left">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Command="{Binding DataContext.OpenRatedTitleCommand, RelativeSource={RelativeSource AncestorType=views:StatsView}}"
                        CommandParameter="{Binding}"
                        Padding="0"
                        Margin="0,0,10,10"
                        VerticalAlignment="Top"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip="{Binding Title}">
                    <StackPanel Width="92">
                        <Border Width="84"
                                Height="126"
                                CornerRadius="6"
                                ClipToBounds="True"
                                HorizontalAlignment="Left"
                                Background="{StaticResource AppBrushCanvas}">
                            <Image Source="{Binding PosterImage}"
                                   Width="84"
                                   Height="126"
                                   Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left">
                            <iconPacks:PackIconLucide Kind="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToLucideKindConverter}}"
                                                      Width="14"
                                                      Height="14"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToBrushConverter}}"
                                                      ToolTip="{Binding WatchStatusLabel}"
                                                      Visibility="{Binding HasWatchStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Border Width="52"
                                    Height="22"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{Binding Band, Converter={StaticResource EpisodeRatingBandToBrushConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <iconPacks:PackIconLucide Kind="Star"
                                                              Width="10"
                                                              Height="10"
                                                              Margin="0,0,3,0"
                                                              VerticalAlignment="Center"
                                                              Foreground="{StaticResource AppBrushOnAccent}" />
                                    <TextBlock Text="{Binding RatingText}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AppBrushOnAccent}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource AppBrushText}" />
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
