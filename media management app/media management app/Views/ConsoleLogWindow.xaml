<Window x:Class="media_management_app.Views.ConsoleLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console Log"
        Height="420"
        Width="860"
        MinHeight="260"
        MinWidth="520"
        WindowStartupLocation="CenterOwner">
    <!-- #region Console log layout -->
    <DockPanel Background="#111111">
        <!-- #region Header -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#303030"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="Console Log"
                       Foreground="#f8fafc"
                       FontSize="15"
                       FontWeight="SemiBold" />
        </Border>
        <!-- #endregion -->

        <!-- #region Log list and copy menu -->
        <ListBox x:Name="ConsoleLogList"
                 ItemsSource="{Binding UiLogs}"
                 Background="#111111"
                 BorderThickness="0"
                 Foreground="#d6d6d6"
                 FontFamily="Consolas"
                 FontSize="12"
                 SelectionMode="Extended"
                 KeyDown="ConsoleLogList_KeyDown"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy selected"
                              Click="CopySelectedMenuItem_Click" />
                    <MenuItem Header="Copy all"
                              Click="CopyAllMenuItem_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#d6d6d6" TextWrapping="NoWrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- #endregion -->
    </DockPanel>
    <!-- #endregion -->
</Window>
