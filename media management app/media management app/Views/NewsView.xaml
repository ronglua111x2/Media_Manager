<UserControl x:Class="media_management_app.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="News" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="New episodes from tracked shows this week"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource AppPrimaryButtonStyle}"
                        Command="{Binding UpdateDashboardCommand}"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="RefreshCw"
                                                   Width="14"
                                                   Height="14"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="Update Dashboard" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Style="{StaticResource PanelCardStyle}" Margin="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="New This Week"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource AppOutlinedButtonStyle}"
                                Command="{Binding OpenJellyfinCommand}"
                                Padding="10,6"
                                ToolTip="Open Jellyfin in browser">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Tv"
                                                           Width="14"
                                                           Height="14"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center" />
                                <TextBlock Text="Jellyfin" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NewEpisodesThisWeek}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AppBrushSurface}"
                                            BorderBrush="{StaticResource AppBrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="160"
                                                    Height="90"
                                                    CornerRadius="6"
                                                    Background="{StaticResource AppBrushChipMuted}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding StillImage}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EpisodeTitle}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ShowTitle}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0">
                                                    <Run Text="{Binding EpisodeLabel, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding AirDateDisplay, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Overview}"
                                                           Margin="0,6,0,0"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="40"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasOverview}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Padding="10,6"
                                                    CornerRadius="6"
                                                    Background="{StaticResource AppBrushChipMuted}">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AppBrushAccent}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Tracked Shows"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TrackedShows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AppBrushSurface}"
                                            BorderBrush="{StaticResource AppBrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="72"
                                                    Height="108"
                                                    CornerRadius="4"
                                                    Background="{StaticResource AppBrushChipMuted}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding PosterImage}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SeriesStatusLabel}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding PendingLabel}"
                                                           Foreground="{StaticResource AppBrushAccent}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
