<UserControl x:Class="media_management_app.Views.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:common="clr-namespace:media_management_app.Common">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="NewsSortSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource SortSegmentButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style x:Key="NewsEpisodeTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="NewsEpisodeShowStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="NewsEpisodeMetaStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <Style x:Key="NewsEpisodeOverviewStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="MaxHeight" Value="36" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Style="{StaticResource PanelCardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="News" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <iconPacks:PackIconLucide Kind="Sun"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppBrushAccent}" />
                        <TextBlock Text="{Binding TodaySummary}"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppBrushText}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource AppPrimaryButtonStyle}"
                        Command="{Binding UpdateDashboardCommand}"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="RefreshCw"
                                                   Width="14"
                                                   Height="14"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="Update Dashboard" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Style="{StaticResource PanelCardStyle}" Margin="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NewThisWeekTitle}"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Border Grid.Column="1"
                                BorderBrush="{StaticResource AppBrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True"
                                VerticalAlignment="Center"
                                Height="36">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource NewsSortSegmentButtonStyle}"
                                        Command="{Binding SetNewsSortModeCommand}"
                                        CommandParameter="{x:Static common:NewsEpisodeSortMode.AirDateDesc}"
                                        Tag="{Binding IsAirDateSortSelected}"
                                        BorderThickness="0,0,1,0"
                                        ToolTip="By airdate">
                                    <iconPacks:PackIconLucide Kind="CalendarClock" Width="18" Height="18" />
                                </Button>
                                <Button Style="{StaticResource NewsSortSegmentButtonStyle}"
                                        Command="{Binding SetNewsSortModeCommand}"
                                        CommandParameter="{x:Static common:NewsEpisodeSortMode.TrackedShow}"
                                        Tag="{Binding IsTrackedShowSortSelected}"
                                        BorderThickness="0,0,1,0"
                                        ToolTip="By tracked show">
                                    <iconPacks:PackIconLucide Kind="Layers" Width="18" Height="18" />
                                </Button>
                                <Button Style="{StaticResource NewsSortSegmentButtonStyle}"
                                        Command="{Binding SetNewsSortModeCommand}"
                                        CommandParameter="{x:Static common:NewsEpisodeSortMode.Status}"
                                        Tag="{Binding IsStatusSortSelected}"
                                        BorderThickness="0"
                                        ToolTip="By status">
                                    <iconPacks:PackIconLucide Kind="ListFilter" Width="18" Height="18" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="3"
                                Command="{Binding OpenJellyfinCommand}"
                                Padding="10,6"
                                ToolTip="{Binding JellyfinButtonToolTip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AppOutlinedButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsJellyfinViewerOpen}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AppBrushAccent}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                                            <Setter Property="Foreground" Value="{StaticResource AppBrushOnAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Tv"
                                                           Width="14"
                                                           Height="14"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding JellyfinButtonText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NewEpisodesThisWeek}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AppBrushSurface}"
                                            BorderBrush="{StaticResource AppBrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="180"
                                                    Height="101"
                                                    CornerRadius="8"
                                                    Background="{StaticResource AppBrushChipMuted}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding StillImage}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="14,0,14,0"
                                                        VerticalAlignment="Center">
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Left"
                                                            Background="{StaticResource AppBrushAccentSoft}"
                                                            CornerRadius="4"
                                                            Padding="7,2"
                                                            Margin="0,1,8,0"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding EpisodeLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource AppBrushAccent}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding EpisodeTitle}"
                                                               Style="{StaticResource NewsEpisodeTitleStyle}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding ShowTitle}"
                                                           Style="{StaticResource NewsEpisodeShowStyle}"
                                                           Margin="0,8,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <iconPacks:PackIconLucide Kind="Calendar"
                                                                               Width="12"
                                                                               Height="12"
                                                                               Margin="0,0,5,0"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource AppBrushMutedText}"
                                                                               Opacity="0.85" />
                                                    <TextBlock Text="{Binding AirDateDisplay}"
                                                               Style="{StaticResource NewsEpisodeMetaStyle}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Overview}"
                                                           Margin="0,8,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NewsEpisodeOverviewStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasOverview}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    VerticalAlignment="Top"
                                                    Margin="0,2,0,0"
                                                    Padding="10,6"
                                                    CornerRadius="999">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Missing">
                                                                <Setter Property="Background" Value="{StaticResource AppBrushStatusMutedBg}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Downloading">
                                                                <Setter Property="Background" Value="{StaticResource AppBrushMovieSoft}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Attention">
                                                                <Setter Property="Background" Value="{StaticResource AppBrushNewSoft}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                                <Setter Property="Background" Value="{StaticResource AppBrushStatusErrorBg}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource AppBrushAccent}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Missing">
                                                                    <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Downloading">
                                                                    <Setter Property="Foreground" Value="{StaticResource AppBrushMovieAccent}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Attention">
                                                                    <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{StaticResource AppBrushDanger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Style="{StaticResource PanelCardStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tracked Shows"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Border Grid.Column="2"
                                BorderBrush="{StaticResource AppBrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True"
                                VerticalAlignment="Center"
                                Height="36">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource NewsSortSegmentButtonStyle}"
                                        Command="{Binding SetTrackedShowViewModeCommand}"
                                        CommandParameter="{x:Static common:NewsTrackedShowViewMode.Full}"
                                        Tag="{Binding IsFullViewSelected}"
                                        BorderThickness="0,0,1,0"
                                        ToolTip="Full">
                                    <iconPacks:PackIconLucide Kind="LayoutList" Width="18" Height="18" />
                                </Button>
                                <Button Style="{StaticResource NewsSortSegmentButtonStyle}"
                                        Command="{Binding SetTrackedShowViewModeCommand}"
                                        CommandParameter="{x:Static common:NewsTrackedShowViewMode.ScheduleOnly}"
                                        Tag="{Binding IsScheduleOnlyViewSelected}"
                                        BorderThickness="0,0,1,0"
                                        ToolTip="Schedule only">
                                    <iconPacks:PackIconLucide Kind="CalendarClock" Width="18" Height="18" />
                                </Button>
                                <Button Style="{StaticResource NewsSortSegmentButtonStyle}"
                                        Command="{Binding SetTrackedShowViewModeCommand}"
                                        CommandParameter="{x:Static common:NewsTrackedShowViewMode.AvailabilityOnly}"
                                        Tag="{Binding IsAvailabilityOnlyViewSelected}"
                                        BorderThickness="0,0,1,0"
                                        ToolTip="Availability only">
                                    <iconPacks:PackIconLucide Kind="CircleCheck" Width="18" Height="18" />
                                </Button>
                                <Button Style="{StaticResource NewsSortSegmentButtonStyle}"
                                        Command="{Binding SetTrackedShowViewModeCommand}"
                                        CommandParameter="{x:Static common:NewsTrackedShowViewMode.TitleOnly}"
                                        Tag="{Binding IsTitleOnlyViewSelected}"
                                        BorderThickness="0"
                                        ToolTip="Title only">
                                    <iconPacks:PackIconLucide Kind="Type" Width="18" Height="18" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TrackedShows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AppBrushSurface}"
                                            BorderBrush="{StaticResource AppBrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{Binding DataContext.TrackedShowCardPadding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="{Binding DataContext.TrackedShowPosterWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Height="{Binding DataContext.TrackedShowPosterHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CornerRadius="4"
                                                    Background="{StaticResource AppBrushChipMuted}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding PosterImage}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SeriesStatusLabel}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding DataContext.ShowSeriesStatus, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <StackPanel Visibility="{Binding DataContext.ShowScheduleRow, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,4,0,0"
                                                                Visibility="{Binding HasScheduleMeta, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding HasWeeklyAirDay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <iconPacks:PackIconLucide Kind="CalendarDays"
                                                                                   Width="11"
                                                                                   Height="11"
                                                                                   Margin="0,0,4,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource AppBrushAccent}" />
                                                        <TextBlock Text="{Binding WeeklyAirDayLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource AppBrushAccent}" />
                                                        <TextBlock Text=" - "
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource AppBrushMutedText}"
                                                                   Visibility="{Binding HasAnchorLabel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding HasAnchorLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <iconPacks:PackIconLucide Kind="Clock"
                                                                                   Width="11"
                                                                                   Height="11"
                                                                                   Margin="0,0,4,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource AppBrushMutedText}"
                                                                                   Opacity="0.9" />
                                                        <TextBlock Text="{Binding AnchorLabel}"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource AppBrushMutedText}" />
                                                    </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,4,0,0"
                                                            Visibility="{Binding DataContext.ShowAvailabilityRow, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <iconPacks:PackIconLucide Kind="Hourglass"
                                                                               Width="12"
                                                                               Height="12"
                                                                               Margin="0,0,5,0"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource AppBrushShowAccent}"
                                                                               Visibility="{Binding IsNotAired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <iconPacks:PackIconLucide Kind="CircleCheck"
                                                                               Width="12"
                                                                               Height="12"
                                                                               Margin="0,0,5,0"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource AppBrushAccent}"
                                                                               Visibility="{Binding IsUpToDate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <iconPacks:PackIconLucide Kind="ListTodo"
                                                                               Width="12"
                                                                               Height="12"
                                                                               Margin="0,0,5,0"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource AppBrushWarning}"
                                                                               Visibility="{Binding HasPendingEpisodes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding PendingLabel}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource AppBrushAccent}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNotAired}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource AppBrushShowAccent}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasPendingEpisodes}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
