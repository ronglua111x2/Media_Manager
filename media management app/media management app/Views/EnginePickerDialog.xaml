<Window x:Class="media_management_app.Views.EnginePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TitleText}"
        Width="640"
        MinWidth="520"
        Height="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBrushCanvas}"
        Foreground="{StaticResource AppBrushText}"
        TextElement.Foreground="{StaticResource AppBrushText}">
    <Window.Resources>
        <Style x:Key="EnginePickerCheckboxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
                    <Setter Property="ToolTip" Value="{Binding DisabledTooltip}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EngineRankCardListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="{StaticResource AppBrushSurface}"
                                BorderBrush="{StaticResource AppBrushBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="{StaticResource AppBrushSurfaceRaised}" />
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AppBrushBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding HelpText}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource AppBrushMutedText}"
                   Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StaleBannerText}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource AppBrushWarning}"
                   Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowStaleBanner}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource AppOutlinedButtonStyle}"
                    Width="96"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="OK"
                    Style="{StaticResource AppPrimaryButtonStyle}"
                    Width="96"
                    Click="Confirm_Click" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0"
                      Content="All enabled plugins"
                      IsChecked="{Binding UseAllEnabled, Mode=TwoWay}"
                      Foreground="{StaticResource AppBrushText}"
                      Margin="0,0,0,8">
                <CheckBox.Style>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>

            <TextBlock Grid.Row="1"
                       Text="{Binding IndividualPickHint}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource AppBrushMutedText}"
                       Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowIndividualPickHint}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayLabel}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsEnabled="{Binding IsCheckboxEnabled}"
                                          Style="{StaticResource EnginePickerCheckboxStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQualityMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <CheckBox Content="Rank preferred engines"
                          IsChecked="{Binding IsRankedMode, Mode=TwoWay}"
                          Foreground="{StaticResource AppBrushText}"
                          Margin="0,0,0,8" />
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowRankPanel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Height="148"
                            MaxHeight="148"
                            VerticalAlignment="Top"
                            BorderBrush="{StaticResource AppBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6,6,2,6">
                        <ListBox x:Name="RankListBox"
                                 ItemsSource="{Binding PriorityItems}"
                                 SelectedItem="{Binding SelectedPriorityItem, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource EngineRankCardListBoxItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource AppBrushText}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource AppBrushSurfaceRaised}"
                                                BorderBrush="{StaticResource AppBrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RankBadge}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppBrushText}" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayLabel}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource AppBrushText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <Button Content="Top"
                                Style="{StaticResource AppOutlinedButtonStyle}"
                                Width="96"
                                Margin="0,0,0,8"
                                Click="MoveTop_Click" />
                        <Button Content="Up"
                                Style="{StaticResource AppOutlinedButtonStyle}"
                                Width="96"
                                Margin="0,0,0,8"
                                Click="MoveUp_Click" />
                        <Button Content="Down"
                                Style="{StaticResource AppOutlinedButtonStyle}"
                                Width="96"
                                Margin="0,0,0,8"
                                Click="MoveDown_Click" />
                        <Button Content="Bottom"
                                Style="{StaticResource AppOutlinedButtonStyle}"
                                Width="96"
                                Click="MoveBottom_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="4"
                       Margin="0,12,0,0"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource AppBrushMutedText}"
                       Text="{Binding SelectionSummary}"
                       ToolTip="{Binding SelectionSummary}" />
        </Grid>
    </DockPanel>
</Window>
