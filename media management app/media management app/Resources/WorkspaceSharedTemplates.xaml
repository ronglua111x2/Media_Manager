<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:media_management_app.Common"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:services="clr-namespace:media_management_app.Services;assembly=MediaManager.Core"
                    xmlns:views="clr-namespace:media_management_app.Views">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <DataTemplate x:Key="MediaSortFieldItemTemplate">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconLucide Width="14"
                                       Height="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center">
                <iconPacks:PackIconLucide.Style>
                    <Style TargetType="iconPacks:PackIconLucide">
                        <Setter Property="Kind" Value="CalendarClock" />
                        <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Field}" Value="{x:Static common:MediaCardSortField.Type}">
                                <Setter Property="Kind" Value="Tags" />
                                <Setter Property="Foreground" Value="{StaticResource AppBrushShowAccent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Field}" Value="{x:Static common:MediaCardSortField.Title}">
                                <Setter Property="Kind" Value="ArrowDownAZ" />
                                <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Field}" Value="{x:Static common:MediaCardSortField.Rating}">
                                <Setter Property="Kind" Value="Star" />
                                <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </iconPacks:PackIconLucide.Style>
            </iconPacks:PackIconLucide>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="WatchStatusOptionItemTemplate">
        <StackPanel Orientation="Horizontal">
            <iconPacks:PackIconLucide Kind="{Binding Status, Converter={StaticResource UserWatchStatusToLucideKindConverter}}"
                                       Width="14"
                                       Height="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Status, Converter={StaticResource UserWatchStatusToBrushConverter}}" />
            <TextBlock Text="{Binding Label}"
                       VerticalAlignment="Center"
                       Foreground="{Binding Status, Converter={StaticResource UserWatchStatusToBrushConverter}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="WorkspaceMediaCardTemplate">
        <Border Style="{StaticResource LibraryMediaCardStyle}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick"
                              Command="{Binding DataContext.SelectMediaCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource AppBrushShowAccent}"
                        CornerRadius="8,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AppBrushShowAccent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TypeLabel}" Value="Movie">
                                    <Setter Property="Background" Value="{StaticResource AppBrushMovieAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <StackPanel Grid.Column="1" Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Border Grid.Column="1"
                                Style="{StaticResource MediaTypeChipStyle}"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding TypeLabel}"
                                       Style="{StaticResource MediaTypeChipTextStyle}" />
                        </Border>
                    </Grid>

                    <!-- Watch row -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0"
                                Visibility="{Binding HasWatchRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <iconPacks:PackIconLucide Kind="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToLucideKindConverter}}"
                                                   Width="12"
                                                   Height="12"
                                                   Margin="0,0,4,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToBrushConverter}}"
                                                   Visibility="{Binding HasWatchStatusLabel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding WatchStatusLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding WatchStatus, Converter={StaticResource UserWatchStatusToBrushConverter}}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Visibility="{Binding HasWatchStatusLabel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasWatchedProgressLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <iconPacks:PackIconLucide Kind="Eye"
                                                       Width="12"
                                                       Height="12"
                                                       Margin="0,0,3,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppBrushMutedText}" />
                            <TextBlock Text="{Binding WatchedProgressLabel}"
                                       Style="{StaticResource MutedTextStyle}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasRating, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <iconPacks:PackIconLucide Kind="Star"
                                                       Width="12"
                                                       Height="12"
                                                       Margin="0,0,3,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AppBrushWarning}" />
                            <TextBlock Text="{Binding RatingLabel}"
                                       Style="{StaticResource MutedTextStyle}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Library / series row -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ProgressLabel}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding SeriesStatusLabel, StringFormat= · {0}}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Visibility="{Binding HasSeriesStatusLabel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Meta row -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Style="{StaticResource OrderCountBadgeStyle}"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasOrders, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="ShoppingCart"
                                                           Width="12"
                                                           Height="12"
                                                           Margin="0,0,5,0"
                                                           Foreground="{StaticResource AppBrushAccent}"
                                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OrderCountLabel}"
                                           Foreground="{StaticResource AppBrushAccent}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding AddedLabel, StringFormat=Added {0}}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="CartNumericUpDownStyle" TargetType="materialDesign:NumericUpDown">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="2,4" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="Width" Value="112" />
        <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="RecipeSummaryLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,8,0" />
    </Style>

    <Style x:Key="RecipeSummaryValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="RecipeSummaryIconStyle" TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
    </Style>

    <Style x:Key="RecipeOverrideTitleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CartOverrideValueHostStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CartMinSizeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
        <Setter Property="CaretBrush" Value="{StaticResource AppBrushWarning}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="views:CommitTextBoxOnEnter.IsEnabled" Value="True" />
    </Style>

    <Style x:Key="CartRecipeOverviewScrollStyle" TargetType="ScrollViewer">
        <Setter Property="Height" Value="238" />
        <Setter Property="VerticalScrollBarVisibility" Value="Visible" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
        <Setter Property="Padding" Value="0,0,4,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="materialDesign:ScrollViewerAssist.IsAutoHideEnabled" Value="False" />
    </Style>

    <Style x:Key="CartOverrideNumericUpDownStyle" TargetType="materialDesign:NumericUpDown" BasedOn="{StaticResource CartNumericUpDownStyle}">
        <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
        <Setter Property="Width" Value="128" />
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Visibility" Value="Hidden" />
    </Style>

    <DataTemplate x:Key="CartRecipeSummaryTemplate">
        <Border Background="{StaticResource AppBrushCanvas}"
                BorderBrush="{StaticResource AppBrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverviewExpanded}" Value="False">
                                    <Setter Property="Margin" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="27"
                            Height="27"
                            Background="{StaticResource AppBrushAccentSoft}"
                            CornerRadius="6"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Width="15"
                                                   Height="15"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AppBrushAccent}">
                            <iconPacks:PackIconLucide.Style>
                                <Style TargetType="iconPacks:PackIconLucide">
                                    <Setter Property="Kind" Value="Tv" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TargetKind}" Value="TvSeasonPack">
                                            <Setter Property="Kind" Value="Package" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TargetKind}" Value="Movie">
                                            <Setter Property="Kind" Value="Film" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconLucide.Style>
                        </iconPacks:PackIconLucide>
                    </Border>
                    <Button Grid.Column="1"
                            Command="{Binding ToggleOverviewCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Center"
                            FocusVisualStyle="{x:Null}"
                            IsHitTestVisible="{Binding CanToggleOverview}"
                            ToolTip="Expand or collapse recipe details">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanToggleOverview}" Value="True">
                                        <Setter Property="Cursor" Value="Hand" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding TargetLabel}"
                                       Foreground="{StaticResource AppBrushAccent}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AppBrushText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAnyOverride}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2"
                            Command="{Binding ToggleOverviewCommand}"
                            Width="22"
                            Height="22"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Expand or collapse recipe details">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AppCompactIconButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanToggleOverview}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <iconPacks:PackIconLucide Width="14"
                                                   Height="14"
                                                   Foreground="{StaticResource AppBrushMutedText}">
                            <iconPacks:PackIconLucide.Style>
                                <Style TargetType="iconPacks:PackIconLucide">
                                    <Setter Property="Kind" Value="ChevronDown" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverviewExpanded}" Value="True">
                                            <Setter Property="Kind" Value="ChevronUp" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconLucide.Style>
                        </iconPacks:PackIconLucide>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              views:SyncedScrollViewer.GroupName="{Binding OverviewScrollGroupName}">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource CartRecipeOverviewScrollStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverviewExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" MinWidth="128" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                    <iconPacks:PackIconLucide Kind="BadgeCheck" Style="{StaticResource RecipeSummaryIconStyle}" />
                    <TextBlock Grid.Column="1" Text="Quality" Style="{StaticResource RecipeSummaryLabelStyle}" />
                    <TextBlock Grid.Column="2" Text="{Binding QualitySummary}" Style="{StaticResource RecipeSummaryValueStyle}" />

                    <iconPacks:PackIconLucide Grid.Row="1" Kind="Sprout" Style="{StaticResource RecipeSummaryIconStyle}" />
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource RecipeOverrideTitleButtonStyle}"
                            Command="{Binding ToggleMinSeedersOverrideCommand}"
                            ToolTip="{Binding MinSeedersOverrideToolTip}">
                        <TextBlock Text="Min seeders">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryLabelStyle}">
                                    <Setter Property="Margin" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMinSeedersOverridden}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Grid Grid.Row="1" Grid.Column="2" Style="{StaticResource CartOverrideValueHostStyle}">
                        <TextBlock Text="{Binding MinimumSeedersSummary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryValueStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMinSeedersOverridden}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <materialDesign:NumericUpDown Minimum="{x:Static services:RecipeRuntimeSettings.MinCartMinSeedersOverride}"
                                                      Maximum="{x:Static services:RecipeRuntimeSettings.MaxCartMinSeedersOverride}"
                                                      Value="{Binding OverrideMinSeeders, UpdateSourceTrigger=PropertyChanged}">
                            <materialDesign:NumericUpDown.Style>
                                <Style TargetType="materialDesign:NumericUpDown" BasedOn="{StaticResource CartOverrideNumericUpDownStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMinSeedersOverridden}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:NumericUpDown.Style>
                        </materialDesign:NumericUpDown>
                    </Grid>

                    <iconPacks:PackIconLucide Grid.Row="2" Kind="HardDrive" Style="{StaticResource RecipeSummaryIconStyle}" />
                    <Button Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource RecipeOverrideTitleButtonStyle}"
                            Command="{Binding ToggleMinSizeOverrideCommand}"
                            ToolTip="{Binding MinSizeOverrideToolTip}">
                        <TextBlock Text="Min size">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryLabelStyle}">
                                    <Setter Property="Margin" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMinSizeOverridden}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Grid Grid.Row="2" Grid.Column="2" Style="{StaticResource CartOverrideValueHostStyle}">
                        <TextBlock Text="{Binding MinimumSizeSummary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryValueStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMinSizeOverridden}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMinSizeOverridden}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBox Text="{Binding OverrideMinSizeGbText, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource CartMinSizeTextBoxStyle}" />
                            <TextBlock Text="GB"
                                       Style="{StaticResource MutedTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <iconPacks:PackIconLucide Grid.Row="3" Kind="Search" Style="{StaticResource RecipeSummaryIconStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Search" Style="{StaticResource RecipeSummaryLabelStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SearchModeSummary}" Style="{StaticResource RecipeSummaryValueStyle}" />

                    <iconPacks:PackIconLucide Grid.Row="4" Kind="Plug" Style="{StaticResource RecipeSummaryIconStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Plugins" Style="{StaticResource RecipeSummaryLabelStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding PluginsSummary}" Style="{StaticResource RecipeSummaryValueStyle}" />

                    <iconPacks:PackIconLucide Grid.Row="5" Kind="Bug" Style="{StaticResource RecipeSummaryIconStyle}" />
                    <Button Grid.Row="5"
                            Grid.Column="1"
                            Style="{StaticResource RecipeOverrideTitleButtonStyle}"
                            Command="{Binding ToggleCandidateDebugOverrideCommand}"
                            ToolTip="{Binding CandidateDebugOverrideToolTip}">
                        <TextBlock Text="Debug">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryLabelStyle}">
                                    <Setter Property="Margin" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCandidateDebugOverridden}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Grid.Row="5"
                            Grid.Column="2"
                            Style="{StaticResource RecipeOverrideTitleButtonStyle}"
                            Margin="0"
                            Command="{Binding CycleCandidateDebugCommand}"
                            ToolTip="{Binding CycleCandidateDebugToolTip}">
                        <TextBlock Text="{Binding EffectiveCandidateDebugSummary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryValueStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCandidateDebugOverridden}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <iconPacks:PackIconLucide Grid.Row="6" Kind="Type" Style="{StaticResource RecipeSummaryIconStyle}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Titles" Style="{StaticResource RecipeSummaryLabelStyle}" />
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding TitleBehaviorSummary}" Style="{StaticResource RecipeSummaryValueStyle}" />

                    <iconPacks:PackIconLucide Grid.Row="7"
                                               Kind="ListFilter"
                                               Style="{StaticResource RecipeSummaryIconStyle}" />
                    <Button Grid.Row="7"
                            Grid.Column="1"
                            Style="{StaticResource RecipeOverrideTitleButtonStyle}"
                            Command="{Binding ToggleMaxCandidatesOverrideCommand}"
                            ToolTip="{Binding MaxCandidatesOverrideToolTip}">
                        <TextBlock Text="Max candidates">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryLabelStyle}">
                                    <Setter Property="Margin" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMaxCandidatesOverridden}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Grid Grid.Row="7" Grid.Column="2" Style="{StaticResource CartOverrideValueHostStyle}">
                        <TextBlock Text="{Binding RecipeMaxCandidates, Mode=OneWay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RecipeSummaryValueStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMaxCandidatesOverridden}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <materialDesign:NumericUpDown Minimum="{x:Static services:RecipeRuntimeSettings.MinCartMaxCandidatesOverride}"
                                                      Maximum="{x:Static services:RecipeRuntimeSettings.MaxCartMaxCandidatesOverride}"
                                                      Value="{Binding OverrideMaxCandidates, UpdateSourceTrigger=PropertyChanged}">
                            <materialDesign:NumericUpDown.Style>
                                <Style TargetType="materialDesign:NumericUpDown" BasedOn="{StaticResource CartOverrideNumericUpDownStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMaxCandidatesOverridden}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:NumericUpDown.Style>
                        </materialDesign:NumericUpDown>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
