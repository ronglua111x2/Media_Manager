<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:media_management_app.Views"
                    xmlns:vm="clr-namespace:media_management_app.ViewModels">
    <DataTemplate DataType="{x:Type vm:AutoTrackViewModel}">
        <views:AutoTrackView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NewsViewModel}">
        <views:NewsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:FindAddViewModel}">
        <views:FindAddView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
        <views:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:StatsViewModel}">
        <views:StatsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TorrentWorkspaceViewModel}">
        <views:TorrentWorkspaceView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RecipeWorkspaceViewModel}">
        <views:RecipeWorkspaceView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SystemSettingsViewModel}">
        <views:SystemSettingsView />
    </DataTemplate>
</ResourceDictionary>
