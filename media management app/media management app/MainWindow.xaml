<Window x:Class="media_management_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Media Manager" Height="720" Width="1120"
        MinHeight="560" MinWidth="920"
        WindowState="Maximized"
        Icon="Assets/app-icon.ico"
        Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="180" Background="#f3f3f3" BorderBrush="#d0d0d0" BorderThickness="0,0,1,0">
            <StackPanel Margin="12">
                <TextBlock Text="Media Manager" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                <Button Command="{Binding ShowInboxCommand}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconPath}" Data="M4,4 L20,4 L20,20 L4,20 Z M4,13 L9,13 A3,3 0 0 0 15,13 L20,13" />
                        <TextBlock Text="Inbox" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowAutoTorrentCommand}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconPath}" Data="M3,11 L21,11 M12,3 L12,19 M7,7 L12,3 L17,7 M7,17 L12,21 L17,17" />
                        <TextBlock Text="Auto Torrent" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowReviewCommand}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconPath}" Data="M12,3 L20,7.5 L20,16.5 L12,21 L4,16.5 L4,7.5 Z M9,12 L11,14 L15,10" />
                        <TextBlock Text="Review" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShowSettingsCommand}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconPath}" Data="M12,8 A4,4 0 1 1 12,16 A4,4 0 0 1 12,8 M12,2 L14,5 L18,5 L19,9 L22,11 L20,15 L21,19 L17,20 L14,23 L10,23 L7,20 L3,19 L4,15 L2,11 L5,9 L6,5 L10,5 Z" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="205" Background="#111111" BorderBrush="#303030" BorderThickness="0,1,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10,8,10,4">
                    <ProgressBar Style="{StaticResource OperationProgressBar}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding OperationProgressPercent}" />
                    <TextBlock Text="{Binding OperationProgressMessage}"
                               Foreground="#f8fafc"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock DockPanel.Dock="Top"
                           Text="Console Log"
                           Foreground="#d6d6d6"
                           FontWeight="SemiBold"
                           Margin="10,8,10,4" />
                <ListBox x:Name="ConsoleLogList"
                         ItemsSource="{Binding UiLogs}"
                         Background="#111111"
                         BorderThickness="0"
                         Foreground="#d6d6d6"
                         FontFamily="Consolas"
                         FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#d6d6d6" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>
