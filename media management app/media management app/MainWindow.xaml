<Window x:Class="media_management_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:controls="clr-namespace:media_management_app.Views.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Media Manager"
        Height="720"
        Width="1280"
        MinHeight="600"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource AppBrushCanvas}"
        Icon="Assets/app-icon.ico">
    <!-- #region Window chrome -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <!-- #endregion -->

    <!-- #region Window resources -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ChromeIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource AppIconStyle}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="TitleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource AppButtonControlTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushDanger}" />
                    <Setter Property="Foreground" Value="{StaticResource AppBrushOnAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarShellStyle" TargetType="Border">
            <Setter Property="Width" Value="260" />
            <Setter Property="Background" Value="{StaticResource AppBrushSidebar}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Width" Value="72" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarTextPanelStyle" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarHeaderTextPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource AppButtonControlTemplate}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorderStrong}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AppBrushAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedAccentStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AppBrushAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AppBrushSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="8,3,0,3" />
        </Style>

        <Style x:Key="SidebarToggleOpenIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource AppIconStyle}">
            <Setter Property="Kind" Value="PanelRightOpen" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarToggleCloseIconStyle" TargetType="iconPacks:PackIconLucide" BasedOn="{StaticResource AppIconStyle}">
            <Setter Property="Kind" Value="PanelRightClose" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!-- #endregion -->

    <!-- #region App shell -->
    <Border x:Name="ShellBorder"
            Background="{StaticResource AppBrushCanvas}"
            BorderBrush="{StaticResource AppBrushBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- #region Title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource AppBrushSurface}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Border Width="25"
                                Height="25"
                                Background="{StaticResource AppBrushAccent}"
                                CornerRadius="5"
                                Margin="0,0,9,0">
                            <Grid>
                                <iconPacks:PackIconLucide Kind="MonitorPlay"
                                                          Width="16"
                                                          Height="16"
                                                          Foreground="{StaticResource AppBrushOnAccent}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                <Border Width="5"
                                        Height="5"
                                        Background="{StaticResource AppBrushOnAccent}"
                                        Opacity="0.85"
                                        CornerRadius="2.5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,4,4" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Media Manager"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleButtonStyle}"
                                Focusable="False"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <iconPacks:PackIconLucide Kind="Minus" Style="{StaticResource ChromeIconStyle}" />
                        </Button>
                        <Button Style="{StaticResource TitleButtonStyle}"
                                Focusable="False"
                                Click="MaximizeRestoreButton_Click"
                                ToolTip="Maximize or restore">
                            <iconPacks:PackIconLucide Kind="Square" Style="{StaticResource ChromeIconStyle}" />
                        </Button>
                        <Button Style="{StaticResource CloseTitleButtonStyle}"
                                Focusable="False"
                                Click="CloseButton_Click"
                                ToolTip="Close">
                            <iconPacks:PackIconLucide Kind="X" Style="{StaticResource ChromeIconStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- #endregion -->

            <!-- #region Workspace content and navigation -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- #region Current workspace host -->
                <Border Grid.Column="0"
                        Background="{StaticResource AppBrushSurfaceRaised}">
                    <ContentControl Content="{Binding CurrentView}" />
                </Border>
                <!-- #endregion -->

                <!-- #region Sidebar navigation -->
                <Border Grid.Column="1"
                        Style="{StaticResource SidebarShellStyle}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top"
                                BorderBrush="{StaticResource AppBrushBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="14,14,14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource SidebarHeaderTextPanelStyle}">
                                    <TextBlock Text="Workspace"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                   <TextBlock Text="{Binding SelectedWorkspaceLabel}"
                                               Foreground="{StaticResource AppBrushMutedText}"
                                               FontSize="12"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource AppIconButtonStyle}"
                                        Command="{Binding ToggleSidebarCommand}"
                                        ToolTip="Collapse sidebar">
                                    <Grid>
                                        <iconPacks:PackIconLucide Style="{StaticResource SidebarToggleOpenIconStyle}" />
                                        <iconPacks:PackIconLucide Style="{StaticResource SidebarToggleCloseIconStyle}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="12,14,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SidebarButtonStyle}"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Label}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Style="{StaticResource SelectedAccentStyle}" />

                                            <iconPacks:PackIconLucide Grid.Column="1"
                                                                      Kind="{Binding IconKind}"
                                                                      Width="22"
                                                                      Height="22"
                                                                      Foreground="{StaticResource AppBrushText}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Margin="4,0,12,0"
                                                        Style="{StaticResource SidebarTextPanelStyle}">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{StaticResource AppBrushMutedText}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <!-- #endregion -->
            </Grid>
            <!-- #endregion -->

            <!-- #region Bottom status bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource AppBrushSurface}"
                    BorderBrush="{StaticResource AppBrushBorder}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Command="{Binding OpenConsoleCommand}"
                                MinHeight="30"
                                Padding="8,5"
                                Margin="0"
                                ToolTip="Open console log">
                            <iconPacks:PackIconLucide Kind="Terminal"
                                                       Width="16"
                                                       Height="16"
                                                       Foreground="{StaticResource AppBrushText}" />
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource StatusPillStyle}"
                            Width="250"
                            Margin="8,3,8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconLucide Kind="Activity"
                                                       Width="15"
                                                       Height="15"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0">
                                <iconPacks:PackIconLucide.Style>
                                    <Style TargetType="iconPacks:PackIconLucide">
                                        <Setter Property="Foreground" Value="{StaticResource AppBrushMutedText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsJobActive}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AppBrushAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconLucide.Style>
                            </iconPacks:PackIconLucide>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding JobStatus}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <WrapPanel Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding DriveStatuses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource StatusPillButtonStyle}"
                                            Command="{Binding DataContext.OpenDriveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding OpenToolTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource AppBrushAccent}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowSpace}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource AppBrushWarning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <iconPacks:PackIconLucide Kind="HardDrive"
                                                                       Width="14"
                                                                       Height="14"
                                                                       Foreground="{StaticResource AppBrushText}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding DriveLetterDisplay}"
                                                       Foreground="{StaticResource AppBrushMutedText}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding StatsDisplay}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="280">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AppBrushAccent}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowSpace}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AppBrushWarning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource StatusPillButtonStyle}"
                                Command="{Binding OpenQbittorrentCommand}"
                                ToolTip="{Binding QbittorrentToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource AppBrushDanger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QbittorrentDependency.IsConfigured}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource AppBrushMutedText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding QbittorrentDependency.IsOk}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AppBrushAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <iconPacks:PackIconLucide Kind="Download"
                                                           Width="14"
                                                           Height="14"
                                                           Foreground="{StaticResource AppBrushText}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                <TextBlock Text="qBittorrent"
                                           Foreground="{StaticResource AppBrushMutedText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <controls:WarpStatusPill />

                        <Button Style="{StaticResource StatusPillButtonStyle}"
                                Command="{Binding OpenJellyfinCommand}"
                                ToolTip="{Binding JellyfinToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource AppBrushDanger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding JellyfinDependency.IsConfigured}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource AppBrushMutedText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding JellyfinDependency.IsOk}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AppBrushAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <iconPacks:PackIconLucide Kind="Clapperboard"
                                                           Width="14"
                                                           Height="14"
                                                           Foreground="{StaticResource AppBrushJellyfinBrand}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0" />
                                <TextBlock Text="Jellyfin"
                                           Foreground="{StaticResource AppBrushJellyfinBrand}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource StatusPillButtonStyle}"
                                Command="{Binding OpenGoogleDriveBackupCommand}"
                                ToolTip="{Binding GoogleDriveBackupToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource AppBrushDanger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GoogleDriveDependency.IsConfigured}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource AppBrushMutedText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GoogleDriveDependency.IsOk}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AppBrushAccent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <iconPacks:PackIconLucide Width="14"
                                                           Height="14"
                                                           Foreground="{StaticResource AppBrushText}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0">
                                    <iconPacks:PackIconLucide.Style>
                                        <Style TargetType="iconPacks:PackIconLucide">
                                            <Setter Property="Kind" Value="Cloud" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBackupRunning}" Value="True">
                                                    <Setter Property="Kind" Value="CloudUpload" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconLucide.Style>
                                </iconPacks:PackIconLucide>
                                <TextBlock Text="Drive"
                                           Foreground="{StaticResource AppBrushMutedText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
            <!-- #endregion -->
        </Grid>
    </Border>
    <!-- #endregion -->
</Window>
